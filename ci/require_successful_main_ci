#!/usr/bin/env bash
set -euo pipefail

require_successful_main_ci() {
  local repository="${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}"
  local sha="${GITHUB_SHA:?GITHUB_SHA is required}"
  local run_id

  run_id="$(
    gh run list \
      --repo "$repository" \
      --workflow pr-ci.yml \
      --branch main \
      --commit "$sha" \
      --event push \
      --status success \
      --limit 1 \
      --json databaseId \
      --jq '.[0].databaseId // empty'
  )"

  if [[ -z "$run_id" ]]; then
    echo "No successful main-push CI run found for exact commit $sha. Wait for CI or run this workflow from a validated main commit." >&2
    return 1
  fi

  echo "Verified successful CI run $run_id for exact commit $sha."
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  require_successful_main_ci
fi
