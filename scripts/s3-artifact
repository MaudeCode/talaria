#!/usr/bin/env bash
# Move CI and release objects through the self-hosted NAS S3 endpoint with curl's SigV4 signing.
#
#   scripts/s3-artifact put KEY FILE     upload FILE as KEY (applies the bucket's lifecycle rules first)
#   scripts/s3-artifact get KEY FILE     download KEY to FILE; a missing object fails
#   scripts/s3-artifact lifecycle        apply the bucket's expiration rules (idempotent)
#
# Settings: TALARIA_S3_ENDPOINT, TALARIA_S3_REGION, TALARIA_S3_BUCKET, TALARIA_S3_ACCESS_KEY_ID,
# TALARIA_S3_SECRET_ACCESS_KEY. Keys are <class>/<workflow>/<run>/<attempt>/<file>; the class prefix selects
# the expiration. Garage has no prefix-scoped policies, so each bucket has one owner key.
# ponytail: the release key is a repository secret any in-repo branch workflow can read; move it into a
# `release-artifacts` environment restricted to main if branch workflows must lose it. Credentials go to
# curl through a private config file, never the command line, and are never printed.
set -euo pipefail

operation=${1:-}
case "$operation" in
  put|get) [[ $# -eq 3 ]] || { echo "usage: s3-artifact $operation KEY FILE" >&2; exit 64; } ;;
  lifecycle) [[ $# -eq 1 ]] || { echo "usage: s3-artifact lifecycle" >&2; exit 64; } ;;
  *) echo "usage: s3-artifact put|get KEY FILE | lifecycle" >&2; exit 64 ;;
esac
for name in TALARIA_S3_ENDPOINT TALARIA_S3_REGION TALARIA_S3_BUCKET TALARIA_S3_ACCESS_KEY_ID TALARIA_S3_SECRET_ACCESS_KEY; do
  [[ -n "${!name:-}" ]] || { echo "s3-artifact: $name is not set (fork pull requests have no repository secrets)" >&2; exit 78; }
done
endpoint=${TALARIA_S3_ENDPOINT%/}
bucket=$TALARIA_S3_BUCKET
[[ "$bucket" =~ ^[a-z0-9-]+$ ]] || { echo "s3-artifact: invalid bucket name" >&2; exit 65; }

# Expiration rules per bucket (days). Garage supports prefix filters and whole-day expiration only.
case "$bucket" in
  talaria-ci) rules="fixtures/=7 test-results/=14 fuzz/=30 performance-metrics/=30 buildcache/=14" ;;
  talaria-release) rules="handoffs/=30 buildcache/=14" ;;
  *) echo "s3-artifact: no lifecycle rules are defined for bucket $bucket" >&2; exit 65 ;;
esac

config=$(mktemp "${TMPDIR:-/tmp}/s3-artifact-XXXXXX")
trap 'rm -f "$config"' EXIT
chmod 600 "$config"
printf 'user = "%s:%s"\n' "$TALARIA_S3_ACCESS_KEY_ID" "$TALARIA_S3_SECRET_ACCESS_KEY" > "$config"

request() {
  curl --silent --show-error --fail-with-body --retry 3 --retry-all-errors --config "$config" \
    --aws-sigv4 "aws:amz:$TALARIA_S3_REGION:s3" "$@"
}

apply_lifecycle() {
  local body xml=""
  for rule in $rules; do
    xml+="<Rule><ID>${rule%%/=*}</ID><Filter><Prefix>${rule%=*}</Prefix></Filter><Status>Enabled</Status><Expiration><Days>${rule#*=}</Days></Expiration></Rule>"
  done
  body=$(mktemp "${TMPDIR:-/tmp}/s3-lifecycle-XXXXXX")
  printf '<LifecycleConfiguration>%s</LifecycleConfiguration>' "$xml" > "$body"
  request --request PUT --header "Content-Type: application/xml" \
    --header "Content-MD5: $(openssl dgst -md5 -binary "$body" | base64)" \
    --data-binary "@$body" "$endpoint/$bucket/?lifecycle" >/dev/null
  rm -f "$body"
}

if [[ "$operation" == lifecycle ]]; then
  apply_lifecycle
  exit 0
fi

key=$2
file=$3
[[ "$key" =~ ^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)+$ && "/$key/" != *"/./"* && "/$key/" != *"/../"* ]] || {
  echo "s3-artifact: invalid object key" >&2
  exit 65
}
url="$endpoint/$bucket/$key"
if [[ "$operation" == put ]]; then
  [[ -f "$file" ]] || { echo "s3-artifact: $file is not a file" >&2; exit 66; }
  apply_lifecycle
  request --upload-file "$file" "$url" >/dev/null
  echo "s3-artifact: stored $bucket/$key ($(wc -c < "$file" | tr -d ' ') bytes)"
else
  mkdir -p "$(dirname "$file")"
  partial="$file.partial"
  if ! request --output "$partial" "$url"; then
    echo "s3-artifact: could not download $bucket/$key" >&2
    [[ ! -f "$partial" ]] || head -c 512 "$partial" >&2
    rm -f "$partial"
    exit 1
  fi
  mv "$partial" "$file"
  echo "s3-artifact: fetched $bucket/$key ($(wc -c < "$file" | tr -d ' ') bytes)"
fi
