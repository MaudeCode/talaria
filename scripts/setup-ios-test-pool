#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
pool_size=${TALARIA_SIMULATOR_POOL_SIZE:-4}
refresh=false
pool_runtime_dir="/tmp/talaria-xctest-$EUID"
pool_lock="$pool_runtime_dir/pool.lock"
lease_dir="$pool_runtime_dir/leases"
typeset -a held_lease_files=()

mkdir -p "$lease_dir"

cleanup() {
    for lease_file in "${held_lease_files[@]}"; do
        unlink "$lease_file" 2>/dev/null || true
    done
    unlink "$pool_lock" 2>/dev/null || true
}

if (( $# > 1 )); then
    print -u2 "Usage: scripts/setup-ios-test-pool [--refresh]"
    exit 64
fi

if (( $# == 1 )); then
    if [[ "$1" != "--refresh" ]]; then
        print -u2 "Usage: scripts/setup-ios-test-pool [--refresh]"
        exit 64
    fi
    refresh=true
fi

if [[ "$pool_size" != <-> || "$pool_size" -lt 1 ]]; then
    print -u2 "TALARIA_SIMULATOR_POOL_SIZE must be a positive integer."
    exit 64
fi

if ! /usr/bin/shlock -f "$pool_lock" -p $$; then
    print -u2 "The Talaria simulator pool is already being configured. Retry when it finishes."
    exit 75
fi
trap cleanup EXIT
trap 'exit 130' INT TERM

preferred_simulator=$(sed -n 's/^[[:space:]]*simulatorName:[[:space:]]*"\(.*\)"/\1/p' \
    "$repo_root/.xcodebuildmcp/config.yaml" | head -1)
devices=$(xcrun simctl list devices available)

device_line_named() {
    print -r -- "$devices" | awk -v wanted="$1" '
        /^-- iOS / { in_ios = 1; next }
        /^-- / { in_ios = 0 }
        in_ios {
            line = $0
            sub(/^[[:space:]]*/, "", line)
            if (index(line, wanted " (") == 1) {
                print $0
                exit
            }
        }
    '
}

source_line=$(device_line_named "$preferred_simulator")

if [[ -z "$source_line" ]]; then
    print -u2 "Configured simulator '$preferred_simulator' is not available."
    exit 69
fi

if [[ "$source_line" != *"(Shutdown)"* ]]; then
    print -u2 "Configured simulator '$preferred_simulator' is in use."
    print -u2 "This command will not stop it. Retry after the current session shuts it down."
    exit 75
fi

source_id=$(print -r -- "$source_line" | sed -n 's/.*(\([0-9A-F-]*\)) (.*/\1/p')

if [[ "$refresh" == true ]]; then
    typeset -a refresh_ids=()
    for (( slot = 1; slot <= pool_size; slot++ )); do
        simulator_name="Talaria Test $slot"
        existing=$(device_line_named "$simulator_name")

        if [[ -n "$existing" ]]; then
            existing_id=$(print -r -- "$existing" | sed -n 's/.*(\([0-9A-F-]*\)) (.*/\1/p')
            lease_file="$lease_dir/$existing_id.lock"
            if ! /usr/bin/shlock -f "$lease_file" -p $$; then
                print -u2 "$simulator_name is leased by another worktree. Retry when it finishes."
                exit 75
            fi
            held_lease_files+=("$lease_file")
            refresh_ids[$slot]="$existing_id"
        fi
    done

    devices=$(xcrun simctl list devices available)
    source_line=$(device_line_named "$preferred_simulator")
    current_source_id=$(print -r -- "$source_line" | sed -n 's/.*(\([0-9A-F-]*\)) (.*/\1/p')

    if [[ -z "$source_line" || "$current_source_id" != "$source_id" || "$source_line" != *"(Shutdown)"* ]]; then
        print -u2 "Configured simulator '$preferred_simulator' changed while the refresh was being prepared. No devices were removed."
        exit 75
    fi

    for (( slot = 1; slot <= pool_size; slot++ )); do
        simulator_name="Talaria Test $slot"
        existing=$(device_line_named "$simulator_name")
        existing_id=$(print -r -- "$existing" | sed -n 's/.*(\([0-9A-F-]*\)) (.*/\1/p')

        if [[ "$existing_id" != "${refresh_ids[$slot]:-}" ]]; then
            print -u2 "$simulator_name changed while the refresh was being prepared. No devices were removed."
            exit 75
        fi

        if [[ -n "$existing" && "$existing" != *"(Shutdown)"* ]]; then
            print -u2 "$simulator_name is in use. No devices were removed."
            exit 75
        fi
    done
fi

for (( slot = 1; slot <= pool_size; slot++ )); do
    simulator_name="Talaria Test $slot"
    existing=$(device_line_named "$simulator_name")

    if [[ -n "$existing" && "$refresh" == false ]]; then
        print "Reusing $simulator_name"
        continue
    fi

    if [[ -n "$existing" ]]; then
        devices=$(xcrun simctl list devices available)
        existing=$(device_line_named "$simulator_name")
        existing_id=$(print -r -- "$existing" | sed -n 's/.*(\([0-9A-F-]*\)) (.*/\1/p')

        if [[ -z "$existing" || "$existing_id" != "${refresh_ids[$slot]:-}" ]]; then
            print -u2 "$simulator_name changed while the refresh was being prepared. No further devices were removed."
            exit 75
        fi

        if [[ "$existing" != *"(Shutdown)"* ]]; then
            print -u2 "$simulator_name is in use. Shut down the test pool before refreshing it."
            exit 75
        fi

        xcrun simctl delete "$existing_id"
        print "Removed stale $simulator_name ($existing_id)"
    fi

    simulator_id=$(xcrun simctl clone "$source_id" "$simulator_name")
    print "Created $simulator_name ($simulator_id)"
done
