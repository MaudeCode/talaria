#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "usage: scripts/import-web-upstream REF [UPSTREAM_REPOSITORY]" >&2
  exit 2
fi
cd "$(git rev-parse --show-toplevel)"
test -d web
if [[ -n "$(git status --porcelain)" ]]; then
  echo "Commit or stash local changes before importing upstream." >&2
  exit 1
fi
git fetch --no-tags -- "${2:-https://github.com/nesquena/hermes-webui.git}" "$1"
candidate=$(git rev-parse --verify 'FETCH_HEAD^{commit}')
if [[ -f web/UPSTREAM_BASE_SHA ]] && ! git merge-base --is-ancestor "$(cat web/UPSTREAM_BASE_SHA)" "$candidate"; then
  echo "Selected upstream commit does not extend the recorded Web base." >&2
  exit 1
fi
git update-ref refs/remotes/hermes-upstream/selected "$candidate"
# The original Web history is a merge parent, so Git has a real shared base.
# Keep conflicts visible and leave the result uncommitted for contract review.
git merge --no-commit --no-ff -s ort -Xsubtree=web "$candidate"
printf '%s\n' "$candidate" > web/UPSTREAM_BASE_SHA
git add web/UPSTREAM_BASE_SHA
echo "Review the staged web/ changes, run component/contract checks, then commit."
