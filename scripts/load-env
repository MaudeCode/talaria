#!/usr/bin/env python3

import os
from pathlib import Path
import re
import shlex
import sys


KEY_PATTERN = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\Z")


def fail(message):
    print(f"load-env: {message}", file=sys.stderr)
    raise SystemExit(78)


def read_env_file(path):
    try:
        lines = path.read_text(encoding="utf-8-sig").splitlines()
    except UnicodeError:
        fail(f"{path}: invalid UTF-8")
    except OSError as error:
        fail(f"{path}: {error.strerror}")

    for line_number, line in enumerate(lines, 1):
        try:
            fields = shlex.split(line, comments=True, posix=True)
        except ValueError:
            fail(f"{path}:{line_number}: malformed entry")

        if not fields:
            continue
        if fields[0] == "export":
            fields = fields[1:]
        if len(fields) != 1 or "=" not in fields[0]:
            fail(f"{path}:{line_number}: malformed entry")

        key, value = fields[0].split("=", 1)
        if not KEY_PATTERN.fullmatch(key) or "\0" in value:
            fail(f"{path}:{line_number}: malformed entry")
        yield key, value


def main():
    if len(sys.argv) < 2:
        fail("usage: scripts/load-env <command> [argument ...]")

    repository_root = Path(__file__).resolve().parent.parent
    command = Path(sys.argv[1])
    original_keys = set(os.environ)
    files = [repository_root / ".env", repository_root / ".env.local"]

    explicit_file = os.environ.get("TALARIA_ENV_FILE")
    if not explicit_file and command.name == "webui-json":
        explicit_file = os.environ.get("HERMES_WEBUI_ENV_FILE")
    if explicit_file:
        files.append(Path(explicit_file).expanduser())

    for path in files:
        if not path.is_file():
            if explicit_file and path == files[-1]:
                fail(f"{path}: file not found")
            continue
        for key, value in read_env_file(path):
            if key not in original_keys:
                os.environ[key] = value

    os.environ["_TALARIA_ENV_LOADED"] = "1"
    os.execvpe(sys.argv[1], sys.argv[1:], os.environ)


if __name__ == "__main__":
    main()
