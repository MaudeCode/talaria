#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "optparse"
require "securerandom"
require_relative "../ci/release_project"

class TalariaReleaseCommand
  BUNDLE_ID = "dev.kil.talaria"

  def initialize(argv)
    @options = { dry_run: false, publish: false, latest_build: nil }
    parser.parse!(argv)
    @requested_version = argv.shift
    raise OptionParser::MissingArgument, "release version" unless @requested_version
    raise OptionParser::InvalidOption, argv.join(" ") unless argv.empty?
    return if @options[:dry_run] ^ @options[:publish]

    raise OptionParser::InvalidOption, "choose exactly one of --dry-run or --publish"
  end

  def run
    root = capture("git", "rev-parse", "--show-toplevel").strip
    Dir.chdir(root) do
      common_dir = File.expand_path(capture("git", "rev-parse", "--git-common-dir").strip, root)
      lock_path = File.join(common_dir, "talaria-release.lock")
      acquire_lock(lock_path)
      begin
        prepare
      ensure
        Dir.rmdir(lock_path) if Dir.exist?(lock_path)
      end
    end
  end

  private

  def parser
    OptionParser.new do |options|
      options.banner = "Usage: scripts/prepare-release VERSION (--dry-run | --publish)"
      options.on("--dry-run", "Print the release plan without changing the checkout") do
        @options[:dry_run] = true
      end
      options.on("--publish", "Validate, commit, sign, and atomically push main and the release tag") do
        @options[:publish] = true
      end
      options.on("--latest-app-store-build BUILD", "Override App Store Connect for deterministic/offline checks") do |value|
        @options[:latest_build] = value
      end
    end
  end

  def acquire_lock(path)
    Dir.mkdir(path)
  rescue Errno::EEXIST
    raise "Another Talaria release preparation is already running for this repository."
  end

  def prepare
    require_clean_current_main!(check_remote: false)
    run!("git", "fetch", "--quiet", "origin", "main", "--tags")
    require_clean_current_main!

    project = TalariaReleaseProject.new
    version = project.normalize_requested_version(@requested_version)
    tag = "v#{version}"
    raise "Release tag #{tag} already exists." if git_success?("rev-parse", "--verify", "--quiet", "refs/tags/#{tag}")

    latest_build = resolve_latest_build(version)
    plan = project.plan(requested_version: version, latest_app_store_build: latest_build)
    print_plan(plan, tag)
    original_project = File.binread(TalariaReleaseProject::PROJECT_PATH)
    project.apply(plan, dry_run: @options[:dry_run])
    return if @options[:dry_run]

    publish(plan, tag, original_project)
  end

  def require_clean_current_main!(check_remote: true)
    branch = capture("git", "branch", "--show-current").strip
    raise "Release preparation must run on main. Current branch: #{branch.empty? ? '(detached)' : branch}" unless branch == "main"

    status = capture("git", "status", "--porcelain=v1", "--untracked-files=all")
    raise "Release preparation requires a clean checkout." unless status.empty?

    return unless check_remote

    unless git_success?("rev-parse", "--verify", "--quiet", "origin/main")
      raise "origin/main was not available after fetch."
    end

    head = capture("git", "rev-parse", "HEAD").strip
    remote = capture("git", "rev-parse", "origin/main").strip
    raise "Local main is stale. Expected #{remote}, found #{head}." unless head == remote
  end

  def resolve_latest_build(version)
    if @options[:latest_build]
      if @options[:publish] && !test_mode?
        raise "--latest-app-store-build cannot publish a release; live App Store Connect reconciliation is required."
      end
      return @options[:latest_build]
    end

    selector = TestFlightBuildNumberSelector.new
    selector.ensure_open_train!(bundle_id: BUNDLE_ID, marketing_version: version)
    selector.latest_build_number(bundle_id: BUNDLE_ID, marketing_version: version)
  end

  def publish(plan, tag, original_project)
    original_head = capture("git", "rev-parse", "HEAD").strip
    tag_message = "Talaria #{tag}\n\nRelease-Reservation: #{SecureRandom.uuid}"
    tag_created = false
    pushed = false

    begin
      validation_env = {
        "TALARIA_RELEASE_VERSION" => plan.new_marketing_version,
        "TALARIA_RELEASE_BUILD" => plan.new_build_number
      }
      raise "Release validation failed." unless system(validation_env, "scripts/validate-release")

      changed = capture("git", "status", "--porcelain=v1", "--untracked-files=no").lines.map(&:strip)
      expected = ["M #{TalariaReleaseProject::PROJECT_PATH}"]
      raise "Release validation changed unexpected tracked files: #{changed.join(', ')}" unless changed == expected

      run!("git", "add", "--", TalariaReleaseProject::PROJECT_PATH)
      if test_mode?
        run!("git", "-c", "commit.gpgSign=false", "commit", "-m", "Release: prepare #{tag}")
        run!("git", "-c", "tag.gpgSign=false", "tag", "-a", "-m", tag_message, tag)
      else
        run!("git", "commit", "-S", "-m", "Release: prepare #{tag}")
        run!("git", "tag", "-s", "-m", tag_message, tag)
      end
      tag_created = true
      run!(
        "git", "push", "--atomic", "origin",
        "HEAD:refs/heads/main",
        "refs/tags/#{tag}:refs/tags/#{tag}"
      )
      pushed = true
      puts "Published #{tag}; GitHub Actions now owns signing, archive, and TestFlight upload."
    ensure
      restore_failed_publish(original_head, original_project, tag, tag_created) unless pushed
    end
  end

  def restore_failed_publish(original_head, original_project, tag, tag_created)
    current_head = capture("git", "rev-parse", "HEAD").strip
    if current_head != original_head
      run!("git", "update-ref", "refs/heads/main", original_head, current_head)
      run!("git", "read-tree", original_head)
    else
      run!("git", "restore", "--staged", "--worktree", "--", TalariaReleaseProject::PROJECT_PATH)
    end
    File.binwrite(TalariaReleaseProject::PROJECT_PATH, original_project)
    run!("git", "tag", "-d", tag) if tag_created && git_success?("rev-parse", "--verify", "--quiet", "refs/tags/#{tag}")
  end

  def print_plan(plan, tag)
    puts "Release tag: #{tag}"
    puts "Marketing version: #{plan.old_marketing_version} -> #{plan.new_marketing_version}"
    puts "Build number: #{plan.old_build_number} -> #{plan.new_build_number}"
    puts "Latest App Store Connect build: #{plan.latest_app_store_build || 'none'}"
    puts(@options[:dry_run] ? "Dry run: checkout unchanged." : "Publish: validation and atomic push required.")
  end

  def test_mode?
    return false unless ENV["TALARIA_RELEASE_TEST_MODE"] == "1"

    remote = capture("git", "remote", "get-url", "origin").strip
    remote.start_with?("/", "file://")
  end

  def git_success?(*arguments)
    system("git", *arguments, out: File::NULL, err: File::NULL)
  end

  def capture(*command)
    output, status = Open3.capture2e(*command)
    raise "#{command.join(' ')} failed: #{output.strip}" unless status.success?

    output
  end

  def run!(*command)
    return if system(*command)

    raise "#{command.join(' ')} failed."
  end
end

begin
  TalariaReleaseCommand.new(ARGV).run
rescue OptionParser::ParseError, ArgumentError, RuntimeError => error
  warn error.message
  exit 1
end
