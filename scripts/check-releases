#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
state=$(mktemp -d "${TMPDIR:-/tmp}/talaria-release-tests.XXXXXX")
trap 'rm -rf -- "$state"' EXIT
mkdir -p "$state/home" "$state/tmp"
# Version-manager shims read the caller's HOME, which the isolated runs replace: resolve the real tools first.
python=$("${RELEASE_PYTHON:-python3}" -c 'import sys; print(sys.executable)')
path="$(dirname "$python")"
if node=$(node -p process.execPath 2>/dev/null); then path="$path:$(dirname "$node")"; fi
if ruby=$(ruby -e 'print RbConfig.ruby' 2>/dev/null); then path="$path:$(dirname "$ruby")"; fi
path="$path:$PATH"
env -i PATH="$path" HOME="$state/home" TMPDIR="$state/tmp" \
  "$python" -m venv "$state/venv"
env -i PATH="$path" HOME="$state/home" TMPDIR="$state/tmp" PIP_CONFIG_FILE=/dev/null \
  "$state/venv/bin/python" -m pip --disable-pip-version-check install --quiet \
  --only-binary=:all: -r "$root/releases/requirements.txt"
env -i PATH="$path" HOME="$state/home" TMPDIR="$state/tmp" PYTHONDONTWRITEBYTECODE=1 \
  "$state/venv/bin/python" -m unittest discover -s "$root/releases" -p 'test_*.py'
