#!/bin/zsh
set -euo pipefail

: "${TALARIA_RELEASE_VERSION:?TALARIA_RELEASE_VERSION is required}"
: "${TALARIA_RELEASE_BUILD:?TALARIA_RELEASE_BUILD is required}"

git diff --check
actionlint -color
ruby ci/select_testflight_build_number_test.rb
ruby ci/release_project_test.rb
ruby ci/test_ios_runner_test.rb
ci/require_successful_main_ci_test.sh
scripts/test-ios

release_build_dir="$(mktemp -d "${TMPDIR:-/tmp}/talaria-release.XXXXXX")"
trap 'rm -rf "${release_build_dir}"' EXIT

xcodebuild build \
  -project Talaria.xcodeproj \
  -scheme Talaria \
  -configuration Release \
  -destination "generic/platform=iOS" \
  -derivedDataPath "${release_build_dir}" \
  -disableAutomaticPackageResolution \
  -allowProvisioningUpdates \
  MARKETING_VERSION="${TALARIA_RELEASE_VERSION}" \
  CURRENT_PROJECT_VERSION="${TALARIA_RELEASE_BUILD}"

app_path="${release_build_dir}/Build/Products/Release-iphoneos/Talaria.app"
ci/verify_bundle_versions "${app_path}" "${TALARIA_RELEASE_VERSION}" "${TALARIA_RELEASE_BUILD}"
