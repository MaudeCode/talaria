#!/usr/bin/env python3
"""Start or stop a disposable Talaria Web server the phone reaches over Tailscale (TAL-2621).

  scripts/phone-test-server start [--scenario FILE] [--no-build] [--host IP] [--tailscale CLI]
      Builds contracts and server from this checkout, boots the replay-sidecar server under `env -i` with a temp
      HOME on the Mac's Tailscale IPv4, port 8790 when free (else any free port) and a random password, waits for
      /health and a password login, and prints {url, password, addServerLink, pid, stateDir, log} as one JSON object
      on stdout. addServerLink opens Talaria Dev's Add Server prefilled with the URL and password (TAL-2623).
      --scenario seeds the server from a JSON file (TAL-2622; scripts/phone-test-scenarios/example.json shows every
      field): its files go into the default workspace before boot, then its projects and chats are created through the
      HTTP API as the App would, each turn played by the replay sidecar, and the result is read back and compared. A
      turn with an approval or clarify must be its chat's last; it stays waiting until answered on the phone.
  scripts/phone-test-server stop STATE_DIR
      Signals only the PID recorded in STATE_DIR/server.json, waits for it to exit and deletes STATE_DIR.

Talaria Dev allows plain HTTP only to 100.64.0.0/10, so the server binds the Tailscale address, never 0.0.0.0 or a
LAN address. `--host` takes a loopback address for this script's own test.
"""

import argparse
import http.cookiejar
import ipaddress
import json
import os
import re
import secrets
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
WEB = ROOT / "web"
STATE_PREFIX = "talaria-phone-server-"
TAILNET = ipaddress.ip_network("100.64.0.0/10")
READY_SECONDS = 60
RESTATE_ERROR = "changing settings via 'tailscale up' requires mentioning all"
SETTLE_SECONDS = 30
# A fixed port keeps repeated servers at one URL, which Talaria Dev then signs in to again rather than adding (TAL-2623).
PREFERRED_PORT = 8790
DEV_URL_SCHEME = "talaria-branch"  # app/Config/Dev.xcconfig APP_URL_SCHEME_SUFFIX


class Failure(Exception):
    pass


def run(argv, timeout=60):
    """Runs a CLI and returns (exit code, combined output); a timeout counts as a failure with its partial output."""
    try:
        done = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
        return done.returncode, done.stdout + done.stderr
    except subprocess.TimeoutExpired as expired:
        # A timeout's captured output is bytes even with text=True.
        return 124, ((expired.stdout or b"") + (expired.stderr or b"")).decode(errors="replace")


def backend_state(cli):
    _, output = run([cli, "status", "--json"])
    try:
        status = json.loads(output[output.index("{"):])
    except ValueError:
        return "", ""
    return status.get("BackendState", ""), status.get("AuthURL", "")


def tailscale_ipv4(cli):
    """Brings Tailscale up without a human and returns its IPv4. Raises Failure with the login URL when a login is due."""
    state, _ = backend_state(cli)
    outputs = []
    if state != "Running":
        code, output = run([cli, "up", "--timeout=20s"])
        outputs.append(output)
        if code != 0 and RESTATE_ERROR in output:
            # The CLI prints the `tailscale up ...` command that restates the current settings; run exactly that.
            suggested = next((line.strip() for line in output.splitlines() if line.strip().startswith("tailscale up")), None)
            if suggested is None:
                raise Failure(f"tailscale up refused without suggesting a command:\n{output}")
            argv = shlex.split(suggested)
            if any(arg.split("=")[0] == "--reset" for arg in argv):
                raise Failure(f"refusing the suggested command because it resets settings: {suggested}")
            outputs.append(run([cli, *argv[1:]])[1])
        state, auth_url = backend_state(cli)
        if state != "Running":
            url = auth_url or next(iter(re.findall(r"https://\S+", "\n".join(outputs))), "")
            if url:
                raise Failure(f"Tailscale needs an interactive login: {url}")
            raise Failure(f"Tailscale is {state or 'unavailable'} after tailscale up:\n" + "\n".join(outputs))
    _, output = run([cli, "ip", "-4"])
    address = output.strip().splitlines()[0] if output.strip() else ""
    try:
        if ipaddress.ip_address(address) in TAILNET:
            return address
    except ValueError:
        pass
    raise Failure(f"tailscale ip -4 returned no 100.64.0.0/10 address: {output.strip()!r}")


def checked_host(host):
    """Accepts loopback (the script's own test) or a tailnet address; never 0.0.0.0 or a LAN address."""
    address = ipaddress.ip_address(host)
    if address.version != 4 or not (address.is_loopback or address in TAILNET):
        raise Failure(f"--host must be IPv4 loopback or 100.64.0.0/10, not {host}")
    return host


def build():
    def npm(*args):
        # Build output goes to stderr so stdout stays one JSON object.
        subprocess.run(["npm", *args], cwd=WEB, check=True, stdout=sys.stderr)

    if not (WEB / "node_modules").is_dir():
        npm("ci", "--no-audit", "--no-fund")
    # A stale dist speaks an older sidecar RPC version, so both always build from this checkout.
    npm("run", "build", "-w", "packages/contracts")
    npm("run", "build", "-w", "packages/server")


def interpreter(argv):
    # Ask each interpreter for its own path: mise shims fail under a temp HOME ("config not trusted").
    path = subprocess.run(argv, capture_output=True, text=True, check=True).stdout.strip()
    if "/shims/" in path:
        raise Failure(f"{argv[0]} resolved to a version-manager shim: {path}")
    return path


def server_port(host, preferred=PREFERRED_PORT):
    """PREFERRED when nothing holds it on HOST, else any free port."""
    for port in (preferred, 0):
        with socket.socket() as probe:
            try:
                probe.bind((host, port))
            except OSError:
                continue
            return probe.getsockname()[1]


def add_server_link(url, password):
    """Talaria Dev's link that opens Add Server prefilled with URL and PASSWORD."""
    return f"{DEV_URL_SCHEME}://add-server?" + urllib.parse.urlencode({"url": url, "password": password}, quote_via=urllib.parse.quote)


def ready(url, password, server):
    """Waits for /health, then a successful password login, within READY_SECONDS."""
    deadline = time.monotonic() + READY_SECONDS
    while time.monotonic() < deadline:
        if server.poll() is not None:
            return False
        try:
            urllib.request.urlopen(f"{url}/health", timeout=2).close()
            login = urllib.request.Request(
                f"{url}/api/auth/login",
                data=json.dumps({"password": password}).encode(),
                headers={"Content-Type": "application/json"},
            )
            with urllib.request.urlopen(login, timeout=5) as response:
                return json.load(response).get("ok") is True
        except (OSError, ValueError):
            time.sleep(0.25)
    return False


def load_scenario(path):
    """Reads a scenario and refuses one the seeding cannot reproduce exactly, before anything boots."""
    scenario = json.loads(Path(path).read_text())
    projects = [project["name"] for project in scenario.get("projects") or []]
    problems = [f"project {name!r} is listed twice" for name in set(projects) if projects.count(name) > 1]
    for entry in scenario.get("files") or []:
        relative = Path(entry["path"])
        if relative.is_absolute() or ".." in relative.parts or not isinstance(entry.get("content"), str):
            problems.append(f"file {entry['path']!r} needs a relative path inside the workspace and string content")
    titles, users = [], []
    for chat in scenario.get("chats") or []:
        title, turns = chat.get("title") or "", chat.get("turns") or []
        titles.append(title)
        users.extend(turn.get("user") for turn in turns)
        if not title or not turns or not all(isinstance(turn.get("user"), str) and turn["user"] for turn in turns):
            problems.append(f"chat {title!r} needs a title and at least one turn, each with a user message")
        if chat.get("project") and chat["project"] not in projects:
            problems.append(f"chat {title!r} names unknown project {chat['project']!r}")
        if any(turn.get("approval") or turn.get("clarify") for turn in turns[:-1]):
            problems.append(f"chat {title!r}: only its last turn may wait for an approval or clarify")
    problems += [f"chat title {t!r} is used twice" for t in set(titles) if titles.count(t) > 1]
    # The replay sidecar picks a turn by its exact message, so each message plays one turn.
    problems += [f"turn message {u!r} is used twice" for u in set(users) if users.count(u) > 1]
    if problems:
        raise Failure(f"{path}: " + "; ".join(problems))
    return scenario


class Api:
    """The server's public HTTP API as the App uses it: a password login, then cookie-authenticated JSON calls."""

    def __init__(self, url, password):
        self.url = url
        self.opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()))
        if self.call("/api/auth/login", {"password": password}).get("ok") is not True:
            raise Failure("password login refused")

    def call(self, path, body=None, **query):
        url = f"{self.url}{path}" + (f"?{urllib.parse.urlencode(query)}" if query else "")
        data = None if body is None else json.dumps(body).encode()
        request = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
        try:
            with self.opener.open(request, timeout=10) as response:
                return json.load(response)
        except urllib.error.HTTPError as error:
            raise Failure(f"{'POST' if data else 'GET'} {path} answered {error.code}: {error.read()[:300]!r}") from None


def until(describe, check):
    """Polls CHECK until it returns a truthy value or SETTLE_SECONDS pass."""
    deadline = time.monotonic() + SETTLE_SECONDS
    while time.monotonic() < deadline:
        value = check()
        if value:
            return value
        time.sleep(0.2)
    raise Failure(f"timed out after {SETTLE_SECONDS}s waiting for {describe}")


def settle(api, session_id, stream_id, turn):
    """Waits until the turn is done, or until the prompt it leaves waiting is pending on the server."""
    for kind in ("approval", "clarify"):
        if turn.get(kind):
            until(f"{kind} pending in {turn['user']!r}", lambda: api.call(f"/api/{kind}/pending", session_id=session_id).get("pending"))
            return
    until(f"{turn['user']!r} to settle", lambda: (lambda status: not status["active"] and not status.get("blocking_stream_id"))(
        api.call("/api/chat/stream/status", stream_id=stream_id)))


def seed(api, scenario):
    """Creates the scenario's projects and chats through the HTTP API, playing each turn and setting each chat's title,
    project, pin and archive afterwards, as the App would."""
    projects = {project["name"]: api.call("/api/projects/create", {"name": project["name"], "color": project.get("color")})["project"]["project_id"]
                for project in scenario.get("projects") or []}
    for chat in scenario.get("chats") or []:
        session_id = api.call("/api/session/new", {})["session"]["session_id"]
        for turn in chat["turns"]:
            started = api.call("/api/chat/start", {"session_id": session_id, "message": turn["user"]})
            if not started.get("stream_id") or started.get("queued"):
                raise Failure(f"chat {chat['title']!r} did not start {turn['user']!r}: {started}")
            settle(api, session_id, started["stream_id"], turn)
        api.call("/api/session/rename", {"session_id": session_id, "title": chat["title"]})
        if chat.get("project"):
            api.call("/api/session/move", {"session_id": session_id, "project_id": projects[chat["project"]]})
        if chat.get("pinned"):
            api.call("/api/session/pin", {"session_id": session_id, "pinned": True})
        if chat.get("archived"):
            api.call("/api/session/archive", {"session_id": session_id, "archived": True})


def verify(api, scenario):
    """Reads the projects, sidebar rows, transcripts and waiting prompts back and lists every difference from the
    scenario; an empty list means the server shows exactly what the scenario asked for."""
    mismatches = []
    projects = {project["name"]: project for project in api.call("/api/projects")["projects"]}
    for wanted in scenario.get("projects") or []:
        got = projects.get(wanted["name"])
        if got is None or got.get("color") != wanted.get("color"):
            mismatches.append(f"project {wanted['name']!r}: expected color {wanted.get('color')!r}, got {got and got.get('color')!r}")
    rows = {row["title"]: row for row in api.call("/api/sessions", include_archived="1")["sessions"]}
    for chat in scenario.get("chats") or []:
        title = chat["title"]
        row = rows.get(title)
        if row is None:
            mismatches.append(f"chat {title!r} is missing from /api/sessions")
            continue
        project = projects.get(chat.get("project") or "", {}).get("project_id")
        for field, expected in (("pinned", bool(chat.get("pinned"))), ("archived", bool(chat.get("archived"))), ("project_id", project)):
            if (bool(row.get(field)) if field != "project_id" else row.get(field)) != expected:
                mismatches.append(f"chat {title!r}: expected {field} {expected!r}, got {row.get(field)!r}")
        mismatches += [f"chat {title!r}: {m}" for m in transcript_mismatches(api, row["session_id"], chat["turns"])]
    return mismatches


def transcript_mismatches(api, session_id, turns):
    messages = api.call("/api/session", session_id=session_id, messages="1")["session"]["messages"]
    text = lambda message: message.get("content") if isinstance(message.get("content"), str) else ""
    mismatches = []
    position = 0
    for turn in turns:
        user = next((i for i in range(position, len(messages)) if messages[i].get("role") == "user" and text(messages[i]) == turn["user"]), None)
        if user is None:
            mismatches.append(f"turn {turn['user']!r} is missing")
            continue
        end = next((i for i in range(user + 1, len(messages)) if messages[i].get("role") == "user"), len(messages))
        rows = messages[user + 1:end]
        position = end
        waiting = next((kind for kind in ("approval", "clarify") if turn.get(kind)), None)
        # A waiting turn's tool rows are in its live stream; the transcript gets them when the turn settles.
        tools = [row.get("name") for row in rows if row.get("role") == "tool"]
        if not waiting and tools != [tool["name"] for tool in turn.get("tools") or []]:
            mismatches.append(f"turn {turn['user']!r}: expected tool rows {[tool['name'] for tool in turn.get('tools') or []]}, got {tools}")
        if waiting:
            pending = api.call(f"/api/{waiting}/pending", session_id=session_id).get("pending") or {}
            expected = turn[waiting]["command"] if waiting == "approval" else turn[waiting]["question"]
            if expected not in (pending.get("command"), pending.get("question")):
                mismatches.append(f"turn {turn['user']!r}: expected a pending {waiting} {expected!r}, got {pending or None}")
        elif not any(row.get("role") == "assistant" and text(row) == turn.get("reply", "") for row in rows):
            mismatches.append(f"turn {turn['user']!r}: the reply is missing")
    return mismatches


def start(args):
    scenario = load_scenario(args.scenario) if args.scenario else None
    host = checked_host(args.host) if args.host else tailscale_ipv4(args.tailscale)
    if not args.no_build:
        build()
    state_dir = Path(tempfile.mkdtemp(prefix=STATE_PREFIX)).resolve()
    for name in ("home", "state", "workspace"):
        (state_dir / name).mkdir()
    if scenario is not None:
        (state_dir / "scenario.json").write_text(json.dumps(scenario))
        for entry in scenario.get("files") or []:
            target = state_dir / "workspace" / entry["path"]
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(entry["content"])
    record = {"port": server_port(host), "host": host, "password": secrets.token_urlsafe(18)}
    (state_dir / "server.json").write_text(json.dumps(record))
    try:
        url = launch(state_dir)
    except Exception:
        shutil.rmtree(state_dir, ignore_errors=True)  # a boot that never started a server leaves no state behind
        raise
    if scenario is not None:
        try:
            api = Api(url, record["password"])
            seed(api, scenario)
            mismatches = verify(api, scenario)
        except (Failure, OSError, ValueError) as error:
            mismatches = [f"seeding failed: {error}"]
        if mismatches:
            stop(state_dir)
            raise Failure("the seeded server does not match the scenario:\n" + "\n".join(f"  {m}" for m in mismatches))
    print(json.dumps({"url": url, "password": record["password"], "addServerLink": add_server_link(url, record["password"]), "pid": json.loads((state_dir / "server.json").read_text())["pid"],
                      "stateDir": str(state_dir), "log": str(state_dir / "server.log")}))
    print(f"Stop it with: {Path(__file__).resolve()} stop {state_dir}", file=sys.stderr)


def launch(state_dir):
    """Boots the server on STATE_DIR's recorded host, port and password, records its PID and returns its URL once it
    serves a login. A scenario.json in STATE_DIR scripts the replay sidecar. A failed boot stops it and raises."""
    record = json.loads((state_dir / "server.json").read_text())
    host, port, password = record["host"], record["port"], record["password"]
    node = interpreter(["node", "-p", "process.execPath"])
    python = interpreter([sys.executable, "-c", "import sys; print(sys.executable)"])
    dist = WEB / "packages/server/dist/bin/talaria-web.js"
    if not dist.is_file():
        raise Failure(f"{dist} is missing; run without --no-build")
    log = state_dir / "server.log"
    url = f"http://{host}:{port}"
    env = {
        "PATH": f"{Path(node).parent}:{Path(python).parent}:/usr/bin:/bin",
        "HOME": str(state_dir / "home"),
        "HERMES_HOME": str(state_dir / "state"),
        "TALARIA_WEB_STATE_DIR": str(state_dir / "state"),
        "TALARIA_WEB_DEFAULT_WORKSPACE": str(state_dir / "workspace"),
        "TALARIA_WEB_HOST": host,
        "TALARIA_WEB_PORT": str(port),
        "TALARIA_WEB_PASSWORD": password,
        "TALARIA_WEB_SKIP_ONBOARDING": "1",
        "TALARIA_WEB_TEST_NETWORK_BLOCK": "1",
        # The checkout web/.env would otherwise override this environment, password and state paths included.
        "TALARIA_WEB_NO_DOTENV": "1",
        "TALARIA_WEB_SIDECAR_COMMAND": json.dumps([python, str(WEB / "sidecar/scripts/replay_sidecar.py")]),
        # `serve` in worker mode: the launcher form clones and installs hermes-agent into the temp state.
        "TALARIA_WEB_WORKER": "1",
    }
    if (state_dir / "scenario.json").is_file():
        env["TALARIA_SIDECAR_REPLAY_SCENARIO"] = str(state_dir / "scenario.json")
    with log.open("a") as output:
        server = subprocess.Popen(
            [node, str(dist), "serve"], cwd=WEB, env=env, stdin=subprocess.DEVNULL, stdout=output,
            stderr=subprocess.STDOUT, start_new_session=True,
        )
    record.update(pid=server.pid, started=process_start(server.pid))
    (state_dir / "server.json").write_text(json.dumps(record))
    if not ready(url, password, server):
        tail = log.read_text(errors="replace").splitlines()[-80:]
        stop(state_dir)
        raise Failure("the server did not become ready; last 80 log lines:\n" + "\n".join(tail))
    return url


def stop(state_dir):
    state_dir = Path(state_dir).resolve()
    record = state_dir / "server.json"
    if not state_dir.name.startswith(STATE_PREFIX) or not record.is_file():
        raise Failure(f"{state_dir} is not a phone test server state directory")
    terminate(state_dir)
    shutil.rmtree(state_dir)


def terminate(state_dir):
    """Ends the server STATE_DIR records, signalling only that process; the state stays."""
    recorded = json.loads((state_dir / "server.json").read_text())
    if "pid" not in recorded:
        return
    pid, started = recorded["pid"], recorded["started"]
    for sig, seconds in ((signal.SIGTERM, 15), (signal.SIGKILL, 5)):
        # A server that already exited may have left its PID to an unrelated process; signal only the one we started.
        if not owned(pid, started):
            break
        os.kill(pid, sig)
        deadline = time.monotonic() + seconds
        while time.monotonic() < deadline and owned(pid, started):
            time.sleep(0.1)
        if not owned(pid, started):
            break
    else:
        raise Failure(f"server {pid} survived SIGKILL; {state_dir} kept")


def process_start(pid):
    """The process's start time from ps: with the PID, it tells our server from a later process that reused the PID."""
    return subprocess.run(["ps", "-p", str(pid), "-o", "lstart="], capture_output=True, text=True).stdout.strip()


def owned(pid, started):
    return alive(pid) and process_start(pid) == started


def alive(pid):
    try:
        # A child of this process (a failed boot) must be reaped, or it lingers as a zombie that kill(0) still finds.
        if os.waitpid(pid, os.WNOHANG)[0] == pid:
            return False
    except ChildProcessError:
        pass
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    start_parser = commands.add_parser("start")
    start_parser.add_argument("--scenario", help="seed chats, projects and files from this JSON scenario")
    start_parser.add_argument("--no-build", action="store_true", help="skip npm ci and the builds (caller just built)")
    start_parser.add_argument("--host", help="bind this address instead of the Tailscale IPv4 (loopback for tests)")
    start_parser.add_argument("--tailscale", default=shutil.which("tailscale") or "tailscale", help="tailscale CLI path")
    stop_parser = commands.add_parser("stop")
    stop_parser.add_argument("state_dir")
    args = parser.parse_args()
    try:
        start(args) if args.command == "start" else stop(args.state_dir)
    except (Failure, subprocess.CalledProcessError, OSError, ValueError) as error:
        print(f"phone-test-server: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
