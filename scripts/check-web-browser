#!/usr/bin/env bash
# Playwright end-to-end against the Node server. Without HERMES_WEBUI_AGENT_DIR
# the server runs on the fixture replay sidecar (web/sidecar/scripts/replay_sidecar.py),
# so the suite needs no Hermes Agent, model provider, or network.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
state=$(mktemp -d "${TMPDIR:-/tmp}/talaria-browser.XXXXXX")
trap 'rm -rf -- "$state"' EXIT
node_bin=$(node -p process.execPath)
port=$(node -e '
const net = require("node:net")
const probe = (p) => new Promise((resolve) => { const s = net.createServer(); s.once("error", () => resolve(false)); s.listen(p, "127.0.0.1", () => s.close(() => resolve(true))) })
;(async () => {
  for (let attempt = 0; attempt < 100; attempt += 1) {
    const s = net.createServer(); const first = await new Promise((r) => s.listen(0, "127.0.0.1", () => { const { port } = s.address(); s.close(() => r(port)) }))
    if (first < 65535 && await probe(first + 1)) { console.log(first); return }
  }
  throw new Error("No available test port pair")
})()')
cd "$root/web/packages/frontend"
export PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH:-$root/web/.codex-tmp/playwright}"
# Hosted Linux CI runners lack Chromium's system libraries; Playwright installs them with apt (sudo). With
# PLAYWRIGHT_APT_CACHE set (the e2e workflow caches it per runner image, TAL-432), cached .debs install offline and
# skip the apt mirror; a miss or a failed offline install takes the apt path and refills the cache.
with_deps=""
apt_cache="${PLAYWRIGHT_APT_CACHE:-}"
if [[ -n "${CI:-}" && "$(uname -s)" == Linux ]]; then
  with_deps=--with-deps
  if [[ -n "$apt_cache" ]] && compgen -G "$apt_cache/*.deb" >/dev/null; then
    echo "Installing Chromium's system packages offline from $apt_cache ($(compgen -G "$apt_cache/*.deb" | wc -l) .debs)"
    if sudo dpkg -i "$apt_cache"/*.deb >/dev/null; then
      with_deps=""
    else
      # A partial dpkg run leaves packages unconfigured; let apt repair them before Playwright's own apt install.
      echo "Offline install failed; falling back to apt" >&2
      sudo apt-get install -f -y >/dev/null
    fi
  fi
fi
npx playwright install ${with_deps:+"$with_deps"} chromium
if [[ -n "$with_deps" && -n "$apt_cache" ]]; then
  mkdir -p "$apt_cache"
  if compgen -G "/var/cache/apt/archives/*.deb" >/dev/null; then cp /var/cache/apt/archives/*.deb "$apt_cache"/; fi
  echo "Cached $(compgen -G "$apt_cache/*.deb" | wc -l) .debs in $apt_cache for the next run"
fi
run_env=(env -i PATH="$(dirname "$node_bin"):$PATH" HOME="$state" TMPDIR="$state" \
  PLAYWRIGHT_BROWSERS_PATH="$PLAYWRIGHT_BROWSERS_PATH" HERMES_E2E_PORT="$port")
if [[ -n "${HERMES_WEBUI_AGENT_DIR:-}" ]]; then
  run_env+=("HERMES_WEBUI_AGENT_DIR=$HERMES_WEBUI_AGENT_DIR")
  if [[ -n "${HERMES_WEBUI_PYTHON:-}" ]]; then run_env+=("HERMES_WEBUI_PYTHON=$HERMES_WEBUI_PYTHON"); fi
else
  python_bin=$(command -v python3)
  run_env+=("HERMES_WEBUI_SIDECAR_COMMAND=[\"$python_bin\", \"$root/web/sidecar/scripts/replay_sidecar.py\"]")
fi
if [[ -n "${LD_LIBRARY_PATH:-}" ]]; then run_env+=("LD_LIBRARY_PATH=$LD_LIBRARY_PATH"); fi
"${run_env[@]}" npm run e2e -- "$@"
