#!/bin/zsh
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
candidate_ref=""
run_swift_tests=1

usage() {
  echo "usage: scripts/validate-upstream-contract [--ref COMMIT_OR_TAG] [--server-only]"
}

while (( $# )); do
  case "$1" in
    --ref)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      candidate_ref="$2"
      shift 2
      ;;
    --server-only)
      run_swift_tests=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

read_config() {
  local value
  value="$(tr -d '[:space:]' < "$repo_root/$1")"
  [[ -n "$value" ]] || { echo "$1 is empty" >&2; exit 1; }
  echo "$value"
}

upstream_repository="$(read_config UPSTREAM_REPOSITORY)"
upstream_branch="$(read_config UPSTREAM_BRANCH)"
tested_sha_before="$(read_config UPSTREAM_TESTED_SHA)"
[[ -n "$candidate_ref" ]] || candidate_ref="$tested_sha_before"
upstream_url="https://github.com/${upstream_repository}.git"
run_stamp="$(date -u +%Y%m%dT%H%M%SZ)-$$"
run_dir="$repo_root/.codex-tmp/upstream-contract/$run_stamp"
upstream_dir="$run_dir/hermes-webui"
workspace_dir="$run_dir/workspace"
hermes_home="$run_dir/hermes-home"
state_dir="$run_dir/state"
venv_dir="$run_dir/venv"
mkdir -p "$workspace_dir" "$hermes_home" "$state_dir"
printf 'talaria contract fixture\n' > "$workspace_dir/contract-fixture.txt"

server_pid=""
finish() {
  local exit_code=$?
  trap - EXIT INT TERM
  if [[ -n "$server_pid" ]]; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
  echo "Contract artifacts: $run_dir"
  exit "$exit_code"
}
trap finish EXIT INT TERM

git ls-remote --symref "$upstream_url" HEAD >"$run_dir/source-identity.log" 2>&1 || {
  echo "Source identity: could not read $upstream_repository; see $run_dir/source-identity.log" >&2
  exit 1
}
default_branch="$(sed -n 's#^ref: refs/heads/\([^[:space:]]*\)[[:space:]]*HEAD$#\1#p' "$run_dir/source-identity.log")"
[[ "$default_branch" == "$upstream_branch" ]] || {
  echo "Source identity: configured branch '$upstream_branch' does not match fork default '$default_branch'" >&2
  exit 1
}

echo "Cloning $upstream_repository ($upstream_branch)"
git clone --filter=blob:none --branch "$upstream_branch" "$upstream_url" "$upstream_dir" \
  >"$run_dir/clone.log" 2>&1 || {
    echo "Source identity: clone failed; see $run_dir/clone.log" >&2
    exit 1
  }
if candidate_sha="$(git -C "$upstream_dir" rev-parse --verify "${candidate_ref}^{commit}" 2>/dev/null)"; then
  :
elif candidate_sha="$(git -C "$upstream_dir" rev-parse --verify "origin/${candidate_ref}^{commit}" 2>/dev/null)"; then
  :
else
  git -C "$upstream_dir" fetch --tags origin "$candidate_ref" >>"$run_dir/clone.log" 2>&1 || {
    echo "Source identity: candidate '$candidate_ref' did not resolve in $upstream_repository; see $run_dir/clone.log" >&2
    exit 1
  }
  candidate_sha="$(git -C "$upstream_dir" rev-parse --verify 'FETCH_HEAD^{commit}')"
fi
git -C "$upstream_dir" merge-base --is-ancestor "$candidate_sha" "origin/$upstream_branch" || {
  echo "Candidate $candidate_sha is not on $upstream_repository/$upstream_branch" >&2
  exit 1
}
git -C "$upstream_dir" checkout --detach "$candidate_sha" >>"$run_dir/clone.log" 2>&1
printf '%s\n' "$candidate_sha" > "$run_dir/candidate-sha.txt"

echo "Preparing isolated Python environment"
python3 -m venv "$venv_dir"
"$venv_dir/bin/python" -m pip install --disable-pip-version-check \
  -r "$upstream_dir/requirements.txt" >"$run_dir/setup.log" 2>&1 || {
    echo "Server fixture: Python environment setup failed; see $run_dir/setup.log" >&2
    exit 1
  }

port="$("$venv_dir/bin/python" -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')"
password="talaria-contract-password"
(
  cd "$upstream_dir"
  env -i \
    PATH="$venv_dir/bin:/usr/bin:/bin" \
    HOME="$run_dir/home" \
    PYTHONPATH="$upstream_dir" \
    HERMES_HOME="$hermes_home" \
    HERMES_WEBUI_STATE_DIR="$state_dir" \
    HERMES_WEBUI_DEFAULT_WORKSPACE="$workspace_dir" \
    HERMES_WEBUI_HOST=127.0.0.1 \
    HERMES_WEBUI_PORT="$port" \
    HERMES_WEBUI_PASSWORD="$password" \
    "$venv_dir/bin/python" server.py
) >"$run_dir/server.log" 2>&1 &
server_pid=$!

base_url="http://127.0.0.1:$port"
for _ in {1..80}; do
  if curl --silent --fail "$base_url/health" >/dev/null; then
    break
  fi
  kill -0 "$server_pid" 2>/dev/null || {
    echo "Disposable server exited during startup; see $run_dir/server.log" >&2
    exit 1
  }
  sleep 0.25
done
curl --silent --fail "$base_url/health" >/dev/null || {
  echo "Disposable server did not become healthy; see $run_dir/server.log" >&2
  exit 1
}

echo "Running live HTTP/SSE probe at $candidate_sha"
"$repo_root/scripts/upstream-contract-probe" \
  --base-url "$base_url" \
  --password "$password" \
  --workspace "$workspace_dir" \
  2>&1 | tee "$run_dir/probe.log"

if (( run_swift_tests )); then
  echo "Running Talaria request and SSE contract tests"
  (
    cd "$repo_root"
    scripts/test-ios \
      TalariaTests/APIEndpointContractTests \
      TalariaTests/APIClientAuthAndErrorTests \
      TalariaTests/APIClientSessionListTests \
      TalariaTests/APIClientSessionMutationTests \
      TalariaTests/SSEClientTests \
      TalariaTests/StreamReconnectContractTests
  ) 2>&1 | tee "$run_dir/swift-tests.log"
else
  echo "Swift contract tests skipped by --server-only"
fi

tested_sha_after="$(read_config UPSTREAM_TESTED_SHA)"
[[ "$tested_sha_after" == "$tested_sha_before" ]] || {
  echo "UPSTREAM_TESTED_SHA changed during validation; refusing silent pin advancement" >&2
  exit 1
}

echo "PASS $upstream_repository@$candidate_sha"
if [[ "$candidate_sha" != "$tested_sha_before" ]]; then
  echo "Candidate validated; UPSTREAM_TESTED_SHA remains $tested_sha_before until reviewed separately."
fi
