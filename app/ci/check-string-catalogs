#!/usr/bin/env python3
"""Keep Xcode string catalogs canonical and sorted without changing entries."""

import argparse
import json
from pathlib import Path
import sys

from release_notes import unique_keys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("root", nargs="?", type=Path,
                        default=Path(__file__).resolve().parents[1] / "Talaria/Resources",
                        help="resource directory to check recursively")
    parser.add_argument("--fix", action="store_true", help="sort keys and normalize formatting")
    args = parser.parse_args()
    catalogs = sorted(args.root.rglob("*.xcstrings"))
    if not catalogs:
        parser.error(f"no string catalogs found under {args.root}")
    failed = False
    for path in catalogs:
        try:
            original = path.read_bytes()
            catalog = json.loads(original, object_pairs_hook=unique_keys)
            strings = catalog["strings"]
            if not isinstance(strings, dict):
                raise ValueError('"strings" must be an object')
            keys = list(strings)
            ordered = sorted(keys)
            catalog["strings"] = {key: strings[key] for key in ordered}
            canonical = (json.dumps(catalog, indent=2, ensure_ascii=False,
                                    separators=(",", " : ")) + "\n").encode("utf-8")
            if original == canonical:
                continue
            if args.fix:
                path.write_bytes(canonical)
                print(f"{path}: fixed")
                continue
            if keys != ordered:
                actual, expected = next((a, b) for a, b in zip(keys, ordered) if a != b)
                reason = f"first out-of-place key {actual!r}, expected {expected!r}"
            else:
                reason = "non-canonical serialization (keys already sorted)"
            print(f"{path}: {reason}; run app/ci/check-string-catalogs --fix", file=sys.stderr)
            failed = True
        except (OSError, ValueError, KeyError, TypeError) as error:
            print(f"{path}: {error}", file=sys.stderr)
            failed = True
    return int(failed)


if __name__ == "__main__":
    sys.exit(main())
