#!/usr/bin/env python3
"""Plan, select and prove the App's XCTest shards (TAL-1550, TAL-2390).

  ci/hosted-test-shard plan LANE [CAPACITY]   print the shard plan (JSON) for a hosted lane of
                                              `scripts/changed-components.py --app-plan`; CAPACITY is `capacity`'s output
  ci/hosted-test-shard capacity               observe competing pull request demand for macOS runners (JSON); read-only
  ci/hosted-test-shard args SHARD             print one shard's xcodebuild selection, one argument per line
  ci/hosted-test-shard prepare-options SHARD  print scripts/prepare-ui-simulator's options for one shard
  ci/hosted-test-shard cases RESULTS          print the test cases an `xcresulttool get test-results tests` JSON or an
                                              XCTest log (swift test's output) ran, as Target/Class/method lines
  ci/hosted-test-shard check PLAN DIR         require DIR's shard-N.txt receipts to match PLAN: every planned identifier
                                              ran, in its own shard, exactly once, and nothing else ran. An App test plan
                                              checks its explicit TalariaKitTests lane as one shard. The native Duo
                                              shard is checked on its own, or reports DIR's shard-N.skipped reason
  ci/hosted-test-shard native SHARD RESULTS DEVICE
                                              print the native Duo shard's device and each test case's outcome there
  ci/hosted-test-shard filter PLAN            print the anchored `swift test --filter` for an App test plan's explicit
                                              TalariaKitTests lane
  ci/hosted-test-shard report PLAN DIR        print each shard's estimate beside its actual test time (DIR/shard-N.time)
  ci/hosted-test-shard focus REPETITIONS IDENTIFIER...
                                              validate a focused diagnostic against this checkout and print its App test
                                              plan: one target's classes or methods, repeated 1 to 100 times
  ci/hosted-test-shard attempts RESULTS       print each test case's completed attempts and first failing one
  ci/hosted-test-shard repeated SHARD RESULTS [STOPPED]
                                              judge a repeat shard's run: every planned test completed an attempt and
                                              none failed; STOPPED 1 means its time budget interrupted the last attempt
  ci/hosted-test-shard package-repeat PLAN    print scripts/test-package's arguments for an App test plan's added and
                                              changed TalariaKitTests methods, one per line

SHARD is a JSON file holding one entry of a plan's `shards`.

A full lane runs every class the tested checkout declares; its last shard runs `-only-testing:TalariaTests` without the
other shards' classes, so a class the scanner missed still runs. A selective lane passes explicit identifiers to every
shard. The planner groups identifiers by class, since a class's tests share its setup, places the heaviest group first on
the least-loaded shard, estimates each width's finish from the measured timeline in hosted-test-weights.json, and takes
the fewest shards within 10% of the fastest. A focused run (repetitions) always uses one shard.

A pull request's lane also lists the test methods its diff added or changed (`repeat`, TAL-2402). They get one more shard,
the repeat shard: it runs them up to REPEAT_ATTEMPTS times on one simulator beside the lane's shards, stopping at the first
failure or once REPEAT_BUDGET seconds of testing are spent after the first complete attempt. It is a detector, not a
retry: any failing attempt fails it. Its receipts prove nothing for the lane, so the lane's gate leaves it out.

A lane that selects tests only a native iPhone Duo runs (app_test_plan.native_duo, TAL-1456) also gets the native Duo
shard: those tests on an iPhone Duo at the newest runtime the SDK runs that supports it, beside the lane's iPhone 17
shards, where they skip. It takes a slot as the repeat shard does, leaves out the known Duo failures with their tickets,
and the gate proves it on its own; a runner image without a compatible Duo skips it with the reason.
"""

import functools
import heapq
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parents[1] / "scripts"))
import app_test_plan  # noqa: E402

TARGET = app_test_plan.HOSTED
WEIGHTS = HERE / "hosted-test-weights.json"
MAX_SHARDS = 4  # Five hosted macOS slots: one build and four simulators.
SLOTS = 5
WITHIN = 1.10  # The fewest shards predicted to finish within 10% of the fastest width.
# Under verified competing pull request demand, at most three shards beside the build leave a slot for the other head.
# "observe" records that decision without applying it; "enforce" applies it. Enforce once paired measurements show a
# lower time to green across the contending heads (TAL-2390).
CONTENTION_POLICY = "observe"
CONTENTION_MAX = 3
STALE_SECONDS = 120
# Repeats of a pull request's added and changed tests (TAL-2402). The budgets keep the repeats inside the time a pull
# request already spends: in benchmark run 44224379174 the 90 s repeat shard's test step took 156 s beside its lane
# shard's 127 s, and the 60 s package repeat job finished with the App build (about 400 s each). There, a 15 s hosted
# test got 6 attempts and a TalariaKit method 7 (8.5 s per `swift test` process), so a test failing one run in five fails
# its pull request about three times in four; a test under 2 s reaches the 50-attempt cap. Raising either budget makes
# every pull request with repeats slower by the same amount.
REPEAT_ATTEMPTS = 50
REPEAT_BUDGET = 90
PACKAGE_REPEAT_ATTEMPTS = 50
PACKAGE_REPEAT_BUDGET = 60
CANCELED = "Testing was canceled"
# Classes whose tests await the simulator's notification server. Only a shard that runs one waits for the server in
# preparation (TAL-2352); the catch-all shard always does. The screen gallery's Notifications page shows the
# authorization status the server answers (TAL-2468).
NOTIFICATION_CLASSES = ("NotificationAnswerTests", "ScreenGalleryHostedTests")
RESULT = re.compile(r"(?P<class>[A-Za-z_]\w*)/(?P<method>[A-Za-z_]\w*)(?:\(\))?$")
LOGGED = re.compile(r"Test Case '-\[(\w+)\.(\w+) (\w+)\]' (?:passed|failed|skipped) \(")


def weights():
    return json.loads(WEIGHTS.read_text())


@functools.cache
def universe(root=HERE.parents[1]):
    """The hosted target's declarations at the checkout under `root`, read once per process."""
    cwd = os.getcwd()
    os.chdir(root)
    try:
        found = app_test_plan.Planner("HEAD", None, app_test_plan.Tree(None)).universe(TARGET)
    finally:
        os.chdir(cwd)
    if not isinstance(found, app_test_plan.Universe):
        raise ValueError(str(found))
    return found


def discover(root=HERE.parents[1]):
    """The hosted target's concrete test classes at the checkout under `root`."""
    found = universe(root)
    return sorted(identifier.split("/")[1] for identifier in found.whole(found.test_classes))


def duo(identifiers, root=HERE.parents[1]):
    """(planned, {left out: ticket}) for the native Duo shard of a lane's identifiers at the checkout under `root`."""
    try:
        return app_test_plan.duo_selection(universe(root), identifiers)
    except app_test_plan.Uncertain as error:
        raise ValueError(str(error)) from error


def groups(identifiers, table):
    """{class: (identifiers, estimated seconds, measured)} for a selection."""
    found = {}
    for identifier in identifiers:
        parts = identifier.split("/")
        if parts[0] != TARGET or len(parts) not in (2, 3):
            raise ValueError(f"{identifier} is not a {TARGET}/Class[/method] identifier")
        found.setdefault(parts[1], []).append(identifier)
    result = {}
    for cls, members in found.items():
        if f"{TARGET}/{cls}" in members:
            members = [f"{TARGET}/{cls}"]
            seconds = table["classes"].get(cls)
            measured = seconds is not None
            seconds = table["fallback"]["class"] if seconds is None else seconds
        else:
            known = [table["methods"].get(f"{cls}/{member.split('/')[2]}") for member in members]
            measured = all(value is not None for value in known)
            measured_methods = sum(value for key, value in table["methods"].items() if key.split("/")[0] == cls)
            setup = max(0.0, table["classes"].get(cls, 0.0) - measured_methods)
            seconds = setup + sum(table["fallback"]["method"] if value is None else value for value in known)
        result[cls] = (sorted(members), round(seconds, 1), measured)
    return result


def assign(grouped, width):
    """The heaviest group first onto the least-loaded shard; ties by class name and shard number."""
    shards = [{"classes": [], "load": 0.0} for _ in range(width)]
    for cls in sorted(grouped, key=lambda name: (-grouped[name][1], name)):
        shard = min(range(width), key=lambda index: (shards[index]["load"], index))
        shards[shard]["classes"].append(cls)
        shards[shard]["load"] += grouped[cls][1]
    return shards


def finish(loads, slots, timeline):
    """Predicted seconds from the build's start to the last shard's result. `slots` runners start at once; any other
    shard waits for the earliest finished one."""
    free = [0.0] * slots
    heapq.heapify(free)
    ready = timeline["artifact"] + timeline["download"]
    last = 0.0
    for load in sorted(loads, reverse=True):
        start = heapq.heappop(free) if free else last
        done = max(ready, start + timeline["startup"]) + timeline["launch"] + load + timeline["post"]
        heapq.heappush(free, done)
        last = max(last, done)
    return round(last, 1)


def policy(capacity):
    """The maximum width and why, from a capacity observation."""
    observed = capacity or {"status": "unavailable", "reason": "no observation"}
    contended = observed.get("status") == "contended"
    if contended and time.time() - observed.get("observed_at", 0) > STALE_SECONDS:
        observed = {**observed, "status": "stale"}
        contended = False
    cap = CONTENTION_MAX if contended else MAX_SHARDS
    applied = cap if CONTENTION_POLICY == "enforce" else MAX_SHARDS
    return applied, {"policy": CONTENTION_POLICY, "observed": observed.get("status"), "would_cap": cap, "max_width": applied,
                     "competing": observed.get("competing", []), "reason": observed.get("reason", "")}


def plan(lane, capacity=None, repetitions=1, table=None, classes=None, at_once=MAX_SHARDS, reserved=0, native=None):
    """The shard plan for a hosted lane. `table` defaults to hosted-test-weights.json and a full lane's `classes` to the
    checkout's; `at_once` is how many shards the workflow runs at a time (a release runs two). `reserved` counts the
    run's other macOS jobs beside the build (a package repeat job), which leave the shards fewer of the five slots.
    `native` maps the lane's identifiers to the native Duo shard's (planned, {left out: ticket}); it defaults to `duo` at
    the checkout."""
    table = table or weights()
    full = lane["mode"] == "full"
    repeat = sorted(lane.get("repeat") or []) if repetitions == 1 else []
    empty = lane["mode"] == "empty" or not lane.get("identifiers")
    if empty and not repeat:
        raise ValueError("an empty lane has no shards; the workflow skips the simulators")
    # Repeated attempts and a repeat-only run add no native Duo shard.
    identifiers = [] if empty else [f"{TARGET}/{cls}" for cls in (classes if classes is not None else discover())] \
        if full else lane["identifiers"]
    duo_planned, duo_left_out = (native or duo)(identifiers) if identifiers and repetitions == 1 else ([], {})
    limit, decision = policy(capacity)
    limit = max(1, min(limit, MAX_SHARDS - reserved - (1 if repeat else 0) - (1 if duo_planned else 0)))
    if repetitions > 1:
        limit = 1  # A focused investigation repeats its selection on one runner.
    if empty:
        return {"target": TARGET, "mode": "empty", "partial": True, "width": 0, "shards": [repeat_shard(repeat, 1, table)],
                "candidates": [], "capacity": decision, "fallbacks": [],
                "startup": {"overlapping_build": 0, "beyond_build": 0}}
    grouped = groups(identifiers, table)
    slots = min(limit, at_once)
    widths = range(1, min(limit, len(grouped)) + 1)
    candidates = []
    for width in widths:
        shards = assign(grouped, width)
        candidates.append({"width": width, "finish": finish([shard["load"] for shard in shards], slots, table["timeline"]),
                           "slowest_load": round(max(shard["load"] for shard in shards), 1)})
    fastest = min(candidate["finish"] for candidate in candidates)
    width = next(candidate["width"] for candidate in candidates if candidate["finish"] <= fastest * WITHIN)
    shards = assign(grouped, width)
    if full:  # The lightest shard runs every class the others do not, so a class the scanner missed still runs.
        shards.sort(key=lambda shard: (-shard["load"], shard["classes"]))
    entries = []
    for index, shard in enumerate(shards, start=1):
        catch_all = full and index == len(shards)
        others = sorted(cls for other in shards if other is not shard for cls in other["classes"])
        planned = sorted(identifier for cls in shard["classes"] for identifier in grouped[cls][0])
        entries.append({
            "shard": index, "target": TARGET, "planned": planned, "catch_all": catch_all,
            "only": [TARGET] if catch_all else planned,
            "skip": [f"{TARGET}/{cls}" for cls in others] if catch_all else [],
            "notifications": catch_all or any(cls in NOTIFICATION_CLASSES for cls in shard["classes"]),
            "estimate": round(shard["load"], 1), "repetitions": repetitions,
        })
    if repeat:
        entries.append(repeat_shard(repeat, len(entries) + 1, table))
    if duo_planned:
        entries.append(duo_shard(duo_planned, duo_left_out, len(entries) + 1, table))
    timeline = table["timeline"]
    return {"target": TARGET, "mode": lane["mode"], "partial": not full, "width": width, "shards": entries,
            "candidates": candidates, "capacity": decision,
            "fallbacks": sorted(cls for cls, (_, _, measured) in grouped.items() if not measured),
            "startup": {"overlapping_build": min(timeline["startup"], timeline["artifact"] + timeline["download"]),
                        "beyond_build": max(0, timeline["startup"] - timeline["artifact"] - timeline["download"])}}


def repeat_shard(identifiers, number, table):
    """xcodebuild runs each test's iterations back to back, so the attempts are what one pass of the whole selection fits
    in the budget: every planned test then gets its first attempt before the budget can stop the run (TAL-2535)."""
    one_pass = sum(seconds for _, seconds, _ in groups(identifiers, table).values())
    repetitions = max(1, min(REPEAT_ATTEMPTS, int(REPEAT_BUDGET // max(one_pass, 0.1))))
    return {"shard": number, "target": TARGET, "planned": identifiers, "catch_all": False, "only": identifiers, "skip": [],
            "notifications": any(identifier.split("/")[1] in NOTIFICATION_CLASSES for identifier in identifiers),
            "estimate": REPEAT_BUDGET, "repetitions": repetitions, "repeat": True, "budget": REPEAT_BUDGET}


def duo_shard(identifiers, left_out, number, table):
    """The native iPhone Duo shard: its tests also run, and skip, on the lane's iPhone 17 shards, so the lane's gate
    leaves its receipt out and proves it on its own. Its estimate is the iPhone 17's measured time, where most skip."""
    return {"shard": number, "target": TARGET, "planned": identifiers, "catch_all": False, "only": identifiers,
            "skip": sorted(left_out), "known_failures": left_out,
            "notifications": any(identifier.split("/")[1] in NOTIFICATION_CLASSES for identifier in identifiers),
            "estimate": round(sum(seconds for _, seconds, _ in groups(identifiers, table).values()), 1),
            "repetitions": 1, "duo": True}


def describe(result):
    lines = [f"### Hosted test plan: {result['mode']}, {result['width']} shard(s)"]
    for candidate in result["candidates"]:
        chosen = " (chosen)" if candidate["width"] == result["width"] else ""
        lines.append(f"- {candidate['width']} shard(s): finish ~{candidate['finish']:.0f} s after the build starts, "
                     f"slowest shard ~{candidate['slowest_load']:.0f} s of tests{chosen}")
    for shard in result["shards"]:
        if shard.get("repeat"):
            lines.append(f"- Shard {shard['shard']} repeats {len(shard['planned'])} added or changed test(s): up to "
                         f"{shard['repetitions']} attempts within {shard['budget']} s, stopping at the first failure")
            continue
        if shard.get("duo"):
            lines.append(f"- Shard {shard['shard']} runs {len(shard['planned'])} native iPhone Duo identifier(s)"
                         + "".join(f"; leaves out {known} ({ticket})" for known, ticket in shard["known_failures"].items()))
            continue
        lines.append(f"- Shard {shard['shard']}: {len(shard['planned'])} identifier(s), ~{shard['estimate']:.0f} s"
                     + (", plus any class the scanner missed" if shard["catch_all"] else ""))
    startup = result["startup"]
    lines.append(f"- Simulator startup: ~{startup['overlapping_build']} s overlaps the build, "
                 f"~{startup['beyond_build']} s extends the critical path")
    if result["fallbacks"]:
        lines.append(f"- Fallback weights for: {', '.join(result['fallbacks'])}")
    capacity = result["capacity"]
    lines.append(f"- Capacity: {capacity['observed']}; policy {capacity['policy']} would cap at {capacity['would_cap']}, "
                 f"max width {capacity['max_width']}" + (f" ({capacity['reason']})" if capacity["reason"] else ""))
    return "\n".join(lines)


def selection(shard):
    arguments = [f"-only-testing:{identifier}" for identifier in shard["only"]]
    arguments += [f"-skip-testing:{identifier}" for identifier in shard["skip"]]
    if shard.get("repetitions", 1) > 1:
        arguments += ["-test-iterations", str(shard["repetitions"]), "-run-tests-until-failure"]
    return arguments


def prepare_options(shard):
    return [] if shard["notifications"] else ["--without-notifications"]


def cases(path):
    """Target/Class/method for every test case a result file records, once per run (repetitions repeat it)."""
    text = Path(path).read_text(errors="replace")
    if not text.lstrip().startswith("{"):  # An XCTest log; swift test writes no XCTest xUnit report without --parallel.
        return [f"{target}/{cls}/{method}" for target, cls, method in LOGGED.findall(text)]
    return [case for case, node in test_cases(json.loads(text)) for _ in range(max(1, len(repetitions(node))))]


def test_cases(results):
    """(Target/Class/method, its node) for every test case in an `xcresulttool get test-results tests` JSON."""
    def visit(node, target):
        kind = node.get("nodeType")
        if kind == "Unit test bundle":
            target = node.get("name")
        if kind == "Test Case":
            match = RESULT.match(node.get("nodeIdentifier", ""))
            if match and target:
                yield f"{target}/{match['class']}/{match['method']}", node
            return
        for child in node.get("children", []):
            yield from visit(child, target)

    for root in results.get("testNodes", []):
        yield from visit(root, None)


def repetitions(node):
    return [child for child in node.get("children", []) if child.get("nodeType") == "Repetition"]


def package_shards(result):
    """An App test plan's explicit package lane as a one-shard plan."""
    if "shards" in result:
        return result
    return {"target": app_test_plan.PACKAGE, "partial": True, "shards": [{
        "shard": 1, "target": app_test_plan.PACKAGE, "catch_all": False, "repetitions": 1,
        "planned": result["lanes"][app_test_plan.PACKAGE]["identifiers"]}]}


def swift_filter(result):
    """Target/Class runs the class and Target/Class/test that test alone, anchored so nothing else matches."""
    identifiers = result["lanes"][app_test_plan.PACKAGE]["identifiers"]
    if not identifiers:
        raise ValueError("the package lane names no identifiers")
    patterns = []
    for identifier in identifiers:
        parts = identifier.split("/")
        if parts[0] != app_test_plan.PACKAGE or len(parts) not in (2, 3) or not all(re.fullmatch(r"[A-Za-z_]\w*", part) for part in parts):
            raise ValueError(f"{identifier} is not a {app_test_plan.PACKAGE}/Class[/method] identifier")
        patterns.append(f"^{parts[0]}\\.{parts[1]}/" + (f"{parts[2]}$" if len(parts) == 3 else ""))
    return "|".join(patterns)


def check(result, ran, skipped=None):
    """`ran` maps each shard number to the Target/Class/method cases it ran, and `skipped` a skipped native Duo shard's
    number to its reason. Returns the summary lines. The repeat shard proves nothing for the lane: its receipt is left
    out, and `repeated` judges it in its own job. The native Duo shard's tests also ran on the lane's shards, so it is
    proved on its own."""
    result = package_shards(result)
    expected = {shard["shard"]: shard for shard in result["shards"] if not shard.get("repeat") and not shard.get("duo")}
    native = [check_duo(shard, ran.get(shard["shard"]), (skipped or {}).get(shard["shard"]))
              for shard in result["shards"] if shard.get("duo")]
    ran = {number: cases for number, cases in ran.items() if number in expected or
           not any(shard["shard"] == number for shard in result["shards"])}
    if sorted(ran) != sorted(expected):
        raise ValueError(f"expected receipts for shards {sorted(expected)}, got {sorted(ran)}")
    owner, lines, extra_classes = {}, [], set()
    for number, shard in sorted(expected.items()):
        executed = ran[number]
        target = shard["target"]
        if not executed:
            raise ValueError(f"shard {number} ran no tests")
        repetitions = shard.get("repetitions", 1)
        counts = {}
        for case in executed:
            if not case.startswith(f"{target}/"):
                raise ValueError(f"shard {number} ran {case} outside {target}")
            counts[case] = counts.get(case, 0) + 1
        for case, count in counts.items():
            if count > repetitions:
                raise ValueError(f"{case} ran {count} times in shard {number}")
            if case in owner:
                raise ValueError(f"{case} ran in shard {owner[case]} and shard {number}")
            owner[case] = number
        for identifier in shard["planned"]:
            matched = [case for case in counts if case == identifier or case.startswith(identifier + "/")]
            if not matched:
                raise ValueError(f"shard {number} ran nothing for planned {identifier}")
        planned = set(shard["planned"])
        unexpected = sorted(case for case in counts if case not in planned and case.rsplit("/", 1)[0] not in planned)
        if unexpected and not shard["catch_all"]:
            raise ValueError(f"shard {number} ran unplanned {', '.join(unexpected[:5])}")
        extra_classes |= {case.rsplit("/", 1)[0] for case in unexpected}
        lines.append(f"- Shard {number}: {len(counts)} test case(s) for {len(planned)} planned identifier(s)")
    if extra_classes:
        lines.append(f"- The catch-all shard also ran unplanned {', '.join(sorted(extra_classes))}")
    kind = "selected (partial: not full-suite evidence)" if result.get("partial") else "full suite"
    lines.append(f"- Every planned identifier ran exactly once across {len(expected)} shard(s): {kind}.")
    return lines + native


def check_duo(shard, executed, skipped):
    """The native Duo shard's summary line: skipped with its reason, or every planned identifier ran once there and
    nothing else, its known failures included."""
    number = shard["shard"]
    if skipped is not None:
        return f"- Native iPhone Duo shard {number}: skipped, {skipped}"
    if not executed:
        raise ValueError(f"native Duo shard {number} has no receipt and no skip reason")
    counts = {case: executed.count(case) for case in executed}
    repeated = sorted(case for case, count in counts.items() if count > 1)
    if repeated:
        raise ValueError(f"{repeated[0]} ran {counts[repeated[0]]} times in native Duo shard {number}")
    for identifier in shard["planned"]:
        if not any(case == identifier or case.startswith(identifier + "/") for case in counts):
            raise ValueError(f"native Duo shard {number} ran nothing for planned {identifier}")
    planned = set(shard["planned"])
    unexpected = sorted(case for case in counts if case not in planned and case.rsplit("/", 1)[0] not in planned
                        or case in shard["skip"])
    if unexpected:
        raise ValueError(f"native Duo shard {number} ran unplanned {', '.join(unexpected[:5])}")
    left_out = "".join(f"; left out {known} ({ticket})" for known, ticket in shard["known_failures"].items())
    return f"- Native iPhone Duo shard {number}: {len(counts)} test case(s) for {len(planned)} planned identifier(s){left_out}"


def native(shard, results, device):
    """The native Duo shard's destination proof: the device it ran on and each test case's outcome there, apart from
    the iPhone 17 shards' skips. `device` is the simulator's `simctl list devices --json` entry with its runtime."""
    outcomes = {}
    for case, node in test_cases(results):
        outcomes.setdefault(node.get("result", "unknown"), []).append(case)
    lines = [f"### Native iPhone Duo shard {shard['shard']}",
             f"- Device: {device.get('name')} ({device.get('deviceTypeIdentifier')}), {device.get('runtime')}, "
             f"{device.get('udid')}"]
    for outcome in sorted(outcomes):
        lines.append(f"- {outcome}: {len(outcomes[outcome])}")
        if outcome != "Passed":
            lines += [f"  - {case}" for case in sorted(outcomes[outcome])]
    lines += [f"- Left out: {known}, a known Duo failure ({ticket})" for known, ticket in shard["known_failures"].items()]
    return lines


MAX_REPETITIONS = 100


def focus(repetitions, identifiers, root=HERE.parents[1]):
    """An App test plan for a focused diagnostic, validated against the checkout under `root`."""
    if not re.fullmatch(r"[1-9][0-9]*", str(repetitions)) or int(repetitions) > MAX_REPETITIONS:
        raise ValueError(f"repetitions must be a whole number from 1 to {MAX_REPETITIONS}, not {repetitions!r}")
    if not identifiers:
        raise ValueError("name at least one Target/Class or Target/Class/testMethod identifier")
    targets = {identifier.split("/")[0] for identifier in identifiers}
    if len(targets) != 1 or not targets <= set(app_test_plan.TARGETS):
        raise ValueError(f"identifiers must all start with one of {', '.join(app_test_plan.TARGETS)}")
    target = targets.pop()
    cwd = os.getcwd()
    os.chdir(root)
    try:
        universe = app_test_plan.Planner("HEAD", None, app_test_plan.Tree(None)).universe(target)
    finally:
        os.chdir(cwd)
    if not isinstance(universe, app_test_plan.Universe):
        raise ValueError(str(universe))
    for identifier in identifiers:
        parts = identifier.split("/")
        if len(parts) not in (2, 3) or not all(re.fullmatch(r"[A-Za-z_]\w*", part) for part in parts):
            raise ValueError(f"{identifier} is not Target/Class or Target/Class/testMethod")
        if not universe.all_methods(parts[1]):
            raise ValueError(f"{target} has no test class {parts[1]} at this checkout")
        if len(parts) == 3 and parts[2] not in universe.all_methods(parts[1]):
            raise ValueError(f"{target}/{parts[1]} has no test method {parts[2]} at this checkout")
    lanes = {name: {"mode": "empty", "identifiers": [], "reasons": ["Not requested."]} for name in app_test_plan.TARGETS}
    lanes[target] = {"mode": "explicit", "identifiers": app_test_plan.collapse(set(identifiers)),
                     "reasons": [f"Focused diagnostic, {repetitions} attempt(s)."]}
    return {"version": 1, "focused": True, "repetitions": int(repetitions), "target": target, "lanes": lanes}


def canceled(run):
    """An attempt the run's time budget interrupted: failed with xcodebuild's cancellation as its only failure."""
    messages = [child.get("name") for child in run.get("children", []) if child.get("nodeType") == "Failure Message"]
    return run.get("result") == "Failed" and messages == [CANCELED]


def attempts(path, stopped=False):
    """{case: (completed attempts, first failing attempt or None)} from an xcresulttool test-results JSON. `stopped`: a
    time budget interrupted the run, so a last attempt failed only by that cancellation never completed."""
    found = {}
    for case, node in test_cases(json.loads(Path(path).read_text())):
        runs = repetitions(node) or [node]
        if stopped and canceled(runs[-1]):
            runs = runs[:-1]
        found[case] = (len(runs), next((index for index, run in enumerate(runs, start=1) if run.get("result") == "Failed"), None))
    return found


def repeated(shard, results, stopped=False):
    """A repeat shard's verdict: (passed, summary lines). Every planned test must complete an attempt, none may fail, and
    nothing unplanned may run."""
    found = attempts(results, stopped)
    lines, passed = [], True
    unplanned = sorted(case for case in found if case not in shard["planned"])
    if unplanned:
        passed = False
        lines.append(f"- Unplanned: {', '.join(unplanned[:5])}")
    for identifier in shard["planned"]:
        completed, failing = found.get(identifier, (0, None))
        if failing:
            passed = False
            lines.append(f"- {identifier}: failed at attempt {failing} of {completed}")
        elif not completed:
            passed = False
            lines.append(f"- {identifier}: completed no attempt")
        else:
            lines.append(f"- {identifier}: {completed} attempt(s), no failure")
    budget = "its time budget ran out" if stopped else "it finished its attempts or stopped at a failure"
    lines.insert(0, f"### Repeated tests ({shard['repetitions']} attempts at most, {shard['budget']} s budget): "
                    f"{'passed' if passed else 'failed'}; {budget}")
    return passed, lines


def package_repeat(result):
    """scripts/test-package's arguments for a plan's added and changed TalariaKitTests methods."""
    identifiers = result["lanes"][app_test_plan.PACKAGE].get("repeat") or []
    if not identifiers:
        raise ValueError("the package lane repeats no test")
    return ["--repeat", str(PACKAGE_REPEAT_ATTEMPTS), "--budget", str(PACKAGE_REPEAT_BUDGET), *identifiers]


def capacity(repository, run_id, timeout=20):
    """Read-only: another live pull request's ci.yml run with a queued macOS job. Never waits, never raises."""
    started = time.time()

    def api(path):
        remaining = timeout - (time.time() - started)
        if remaining <= 0:
            raise TimeoutError("capacity lookup ran out of time")
        output = subprocess.run(["gh", "api", "-H", "Cache-Control: no-cache", path], capture_output=True, text=True,
                                timeout=remaining, check=True).stdout
        return json.loads(output)

    observation = {"observed_at": int(time.time()), "slots": SLOTS, "competing": []}
    try:
        runs = []
        for status in ("queued", "in_progress"):
            runs += api(f"repos/{repository}/actions/workflows/ci.yml/runs?event=pull_request&status={status}&per_page=30")["workflow_runs"]
        live = {}  # A pull request's newest run; its concurrency group cancels the older ones.
        for run in runs:
            if str(run["id"]) != str(run_id) and run.get("pull_requests"):
                number = run["pull_requests"][0]["number"]
                if number not in live or run["id"] > live[number]["id"]:
                    live[number] = run
        for number, run in sorted(live.items())[:10]:
            jobs = api(f"repos/{repository}/actions/runs/{run['id']}/jobs?filter=latest&per_page=100")["jobs"]
            queued = [job for job in jobs if job["status"] == "queued" and any(
                label == "xcode-27" or label.startswith("macos") for label in job.get("labels", []))]
            if queued:
                observation["competing"].append({"run": run["id"], "pull_request": number, "head": run["head_sha"],
                                                 "job": queued[0]["name"], "queued_at": queued[0].get("created_at")})
        observation["status"] = "contended" if observation["competing"] else "quiet"
    except (OSError, ValueError, KeyError, IndexError, TimeoutError, subprocess.SubprocessError) as error:
        observation.update(status="unavailable", reason=f"{type(error).__name__}: {error}"[:200])
    return observation


def receipts(directory, suffix):
    return {int(path.name.removeprefix("shard-").removesuffix(suffix)): path for path in Path(directory).glob(f"shard-*{suffix}")}


def main(argv):
    command, *values = argv
    if command == "plan":
        lane = json.loads(Path(values[0]).read_text())
        observed = json.loads(Path(values[1]).read_text()) if len(values) > 1 else None
        result = plan(lane, capacity=observed, repetitions=int(os.environ.get("REPETITIONS", "1")),
                      at_once=int(os.environ.get("SHARDS_AT_ONCE", str(MAX_SHARDS))),
                      reserved=int(os.environ.get("RESERVED_SLOTS", "0")))
        print(describe(result), file=sys.stderr)
        print(json.dumps(result, separators=(",", ":")))
    elif command == "capacity":
        print(json.dumps(capacity(os.environ["GITHUB_REPOSITORY"], os.environ.get("GITHUB_RUN_ID", ""))))
    elif command == "args":
        print("\n".join(selection(json.loads(Path(values[0]).read_text()))))
    elif command == "prepare-options":
        print("\n".join(prepare_options(json.loads(Path(values[0]).read_text()))))
    elif command == "cases":
        print("\n".join(cases(values[0])))
    elif command == "check":
        result = json.loads(Path(values[0]).read_text())
        ran = {number: path.read_text().split() for number, path in receipts(values[1], ".txt").items()}
        skipped = {number: path.read_text().strip() for number, path in receipts(values[1], ".skipped").items()}
        print("\n".join(check(result, ran, skipped)))
    elif command == "native":
        print("\n".join(native(json.loads(Path(values[0]).read_text()), json.loads(Path(values[1]).read_text()),
                               json.loads(Path(values[2]).read_text()))))
    elif command == "filter":
        print(swift_filter(json.loads(Path(values[0]).read_text())))
    elif command == "focus":
        print(json.dumps(focus(values[0], values[1:])))
    elif command == "attempts":
        for case, (completed, failing) in sorted(attempts(values[0]).items()):
            print(f"- {case}: {completed} attempt(s) completed, " + (f"first failure at attempt {failing}" if failing else "no failure"))
    elif command == "repeated":
        passed, lines = repeated(json.loads(Path(values[0]).read_text()), values[1], values[2:3] == ["1"])
        print("\n".join(lines))
        sys.exit(0 if passed else 1)
    elif command == "package-repeat":
        print("\n".join(package_repeat(json.loads(Path(values[0]).read_text()))))
    elif command == "report":
        result = json.loads(Path(values[0]).read_text())
        times = {number: float(path.read_text()) for number, path in receipts(values[1], ".time").items()}
        for shard in result["shards"]:
            actual = times.get(shard["shard"])
            print(f"- Shard {shard['shard']}: estimated ~{shard['estimate']:.0f} s of tests, test step "
                  + (f"{actual:.0f} s" if actual is not None else "not recorded"))
        if times:
            slowest = max(times, key=times.get)
            print(f"- Slowest shard: {slowest}, {times[slowest]:.0f} s")
    else:
        raise ValueError(f"unknown command {command}")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (ValueError, KeyError, OSError) as error:
        sys.exit(f"hosted-test-shard: {error}")
