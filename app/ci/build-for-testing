#!/usr/bin/env bash
# Usage: ci/build-for-testing DESTINATION
# CI's build-for-testing into app/DerivedData. Builds are signed ad hoc (CODE_SIGN_IDENTITY=-): no certificate,
# profile or secret, but the entitlements are embedded, so the app group works and ShareExtensionUITests can
# hand content to the app (TAL-81). No index store: nothing in CI reads it.
#
# Packages and Xcode's content-keyed compilation cache live at fixed paths under app/.build-cache, which CI
# restores from main's latest build: cache keys cover inputs, not file times, so a fresh checkout still hits.
# TALARIA_COMPILATION_CACHE=NO turns it off (the irgaly/xcode-cache benchmark caches DerivedData instead).
set -euo pipefail

destination=${1:?usage: ci/build-for-testing DESTINATION}
cd "$(dirname "$0")/.."
cache=${PWD}/.build-cache
start_seconds=${SECONDS}
xcodebuild build-for-testing \
  -project Talaria.xcodeproj \
  -scheme Talaria \
  -destination "${destination}" \
  -derivedDataPath DerivedData \
  -clonedSourcePackagesDirPath "${cache}/SourcePackages" \
  -disableAutomaticPackageResolution \
  -showBuildTimingSummary \
  APP_IDENTIFIER_SUFFIX=.xctest \
  CODE_SIGNING_ALLOWED=YES \
  CODE_SIGNING_REQUIRED=NO \
  CODE_SIGN_IDENTITY=- \
  CODE_SIGN_STYLE=Manual \
  PROVISIONING_PROFILE_SPECIFIER= \
  COMPILER_INDEX_STORE_ENABLE=NO \
  COMPILATION_CACHE_ENABLE_CACHING="${TALARIA_COMPILATION_CACHE:-YES}" \
  COMPILATION_CACHE_CAS_PATH="${cache}/cas" \
  COMPILATION_CACHE_ENABLE_DIAGNOSTIC_REMARKS=YES \
  | tee "${RUNNER_TEMP:-/tmp}/build-for-testing.log"
seconds=$((SECONDS - start_seconds))
hits=$(grep -cx "Cache hit" "${RUNNER_TEMP:-/tmp}/build-for-testing.log" || true)
misses=$(grep -cx "Cache miss" "${RUNNER_TEMP:-/tmp}/build-for-testing.log" || true)
echo "- Build for testing: ${seconds}s (compilation cache: ${hits} hits, ${misses} misses)" >> "${GITHUB_STEP_SUMMARY:-/dev/null}"
