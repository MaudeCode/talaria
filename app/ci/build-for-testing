#!/usr/bin/env bash
# Usage: ci/build-for-testing DESTINATION
# CI's build-for-testing into app/DerivedData, after a plain package resolve (both timed in the step summary).
# Builds are signed ad hoc (CODE_SIGN_IDENTITY=-): no certificate, profile or secret, but the entitlements are
# embedded, so the app group works and ShareExtensionUITests can hand content to the app (TAL-81). No index
# store: nothing in CI reads it.
set -euo pipefail

destination=${1:?usage: ci/build-for-testing DESTINATION}
cd "$(dirname "$0")/.."
project=(-project Talaria.xcodeproj -scheme Talaria -derivedDataPath DerivedData -disableAutomaticPackageResolution)
start_seconds=${SECONDS}
xcodebuild -resolvePackageDependencies "${project[@]}"
resolve_seconds=$((SECONDS - start_seconds))
xcodebuild build-for-testing "${project[@]}" \
  -destination "${destination}" \
  -showBuildTimingSummary \
  APP_IDENTIFIER_SUFFIX=.xctest \
  CODE_SIGNING_ALLOWED=YES \
  CODE_SIGNING_REQUIRED=NO \
  CODE_SIGN_IDENTITY=- \
  CODE_SIGN_STYLE=Manual \
  PROVISIONING_PROFILE_SPECIFIER= \
  COMPILER_INDEX_STORE_ENABLE=NO
echo "- Package resolve: ${resolve_seconds}s; build for testing: $((SECONDS - start_seconds - resolve_seconds))s" >> "${GITHUB_STEP_SUMMARY:-/dev/null}"
