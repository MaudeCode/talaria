#!/usr/bin/env bash
# Usage: ci/report-test-failures LOG SHA CONTEXT
#        ci/report-test-failures --passed SHA CONTEXT
# Follows an xcodebuild log and, for each failing test, posts a failure commit status on SHA under CONTEXT naming it, so
# a watcher (ci/watch-ui-suite) sees the failure while the job still runs: GitHub serves a job's log only once the job
# ends, which kept failures from their fixer for 10 to 25 minutes a run (TAL-673). Runs until it gets SIGTERM. Needs
# GH_TOKEN with statuses: write, GITHUB_REPOSITORY, GITHUB_SERVER_URL and GITHUB_RUN_ID. A failed post is skipped: the
# job's own result still reports the failure. --passed posts success under CONTEXT instead, once the shard's tests
# passed: GitHub keeps each context's latest status, so a passing rerun of the commit replaces an earlier failure.
set -uo pipefail

usage="usage: ci/report-test-failures LOG SHA CONTEXT | --passed SHA CONTEXT"
url="${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}"
post() { # post SHA CONTEXT STATE DESCRIPTION
  gh api -X POST "repos/${GITHUB_REPOSITORY}/statuses/$1" -f state="$3" -f context="$2" \
    -f description="${4:0:140}" -f target_url="${url}" > /dev/null 2>&1 || true
}
if [[ "${1:-}" == --passed ]]; then
  post "${2:?${usage}}" "${3:?${usage}}" success "No failing tests"
  exit 0
fi
log=${1:?${usage}}
sha=${2:?${usage}}
context=${3:?${usage}}

exec 3< <(exec tail -n +1 -F "${log}" 2>/dev/null)
follower=$!
trap 'kill "${follower}" 2>/dev/null; exit 0' TERM INT

pattern="Test Case '-\[([A-Za-z0-9_.]+) ([A-Za-z0-9_]+)\]' failed"
failures=0
while IFS= read -r line <&3; do
  [[ "${line}" =~ ${pattern} ]] || continue
  failures=$((failures + 1))
  post "${sha}" "${context}" failure "${failures} failed, latest ${BASH_REMATCH[1]##*.}.${BASH_REMATCH[2]}"
done
