#!/usr/bin/env bash
# Records the hosted runner's memory while a UI shard runs, with macOS built-ins only (TAL-419). A 7 GB hosted
# runner once swapped until every UI query timed out, and nothing but a failure spindump showed it.
#   ci/memory-sampler watch LOG XCODEBUILD_LOG   appends a sample every MEMORY_SAMPLE_SECONDS (15) until killed
#   ci/memory-sampler sample LOG XCODEBUILD_LOG  appends one sample
#   ci/memory-sampler summary LOG                prints the peak swap and SimRenderServer footprint, with their tests
#   ci/memory-sampler settle CAP_SECONDS         returns once a freshly booted simulator's render server has settled
# A sample holds swap use, the free-memory percentage, compressor and swap counters, the eight largest processes by
# footprint (top's MEM, which counts the GPU and IOSurface memory ps's RSS leaves out), SimRenderServer's
# footprint and lifetime peak, and the test xcodebuild last started. The peak (footprint's phys_footprint_peak) keeps
# a spike that rises and falls between samples, or while a swapping runner stalls the sampler itself for minutes.
# Its last line is machine-readable:
#   #sample <TAB> epoch <TAB> swap used MB <TAB> SimRenderServer MB <TAB> test <TAB> SimRenderServer peak MB
set -euo pipefail

# top's MEM (123K, 45M+, 1.5G-) in MB; nothing listed is 0.
megabytes() {
  awk -v value="${1:-0}" 'BEGIN {
    number = value + 0; unit = substr(value, match(value, /[BKMGT]/), 1)
    scale = unit == "B" ? 1 / 1048576 : unit == "K" ? 1 / 1024 : unit == "G" ? 1024 : unit == "T" ? 1048576 : 1
    printf "%d", number * scale
  }'
}

# The processes by footprint, top's header line first.
processes() { top -l 1 -o mem -stats pid,command,mem 2>/dev/null | awk '/^PID/ { listed = 1 } listed' || true; }

# Usage: render_server_peak_bytes PROCESSES. SimRenderServer's lifetime peak footprint; 0 when unknown.
render_server_peak_bytes() {
  local pid peak_bytes=0
  pid=$(awk '$2 == "SimRenderServer" { print $1; exit }' <<< "$1")
  if [[ -n "${pid}" ]]; then
    peak_bytes=$(footprint --pid "${pid}" --noCategories -f bytes 2>/dev/null |
      awk '$1 == "phys_footprint_peak:" { print $2; exit }') || true
  fi
  [[ "${peak_bytes}" =~ ^[0-9]+$ ]] || peak_bytes=0
  echo "${peak_bytes}"
}

sample() {
  local log=$1 xcodebuild_log=$2 test processes swap_used render_server peak_bytes
  test=$(grep -o "Test Case '-\[[^]]*\]' started" "${xcodebuild_log}" 2>/dev/null | tail -n 1 | sed -E "s/Test Case '-\[([A-Za-z0-9_]+\.)?(.*)\]' started/\2/") || true
  processes=$(processes)
  swap_used=$(sysctl -n vm.swapusage | sed -E 's/.*used = ([0-9.]+)M.*/\1/')
  render_server=$(awk '$2 == "SimRenderServer" { print $3; exit }' <<< "${processes}")
  peak_bytes=$(render_server_peak_bytes "${processes}")
  {
    echo "=== $(date -u +%Y-%m-%dT%H:%M:%SZ) test: ${test:-none}"
    echo "swap: $(sysctl -n vm.swapusage)"
    memory_pressure -Q | grep -i "free percentage" || true
    vm_stat | grep -E "^(Pages (stored in|occupied by) compressor|Swapins|Swapouts|Pageins)" | tr -s ' ' | paste -sd ';' -
    head -n 9 <<< "${processes}"
    echo "SimRenderServer: ${render_server:-not running}${render_server:+ (peak $((peak_bytes / 1048576)) MB)}"
    printf '#sample\t%s\t%d\t%s\t%s\t%d\n' "$(date +%s)" "${swap_used%.*}" "$(megabytes "${render_server}")" "${test:-none}" \
      "$((peak_bytes / 1048576))"
  } >> "${log}"
}

summary() {
  awk -F '\t' '
    $1 == "#sample" {
      samples++
      if (samples == 1 || $3 > swap) { swap = $3; swap_test = $5 }
      if (samples == 1 || $4 > render) { render = $4; render_test = $5 }
      if (samples == 1 || $6 > peak) { peak = $6; peak_test = $5 }
    }
    END {
      if (!samples) { print "- Memory: no samples"; exit }
      printf "- Memory peaks over %d samples: swap used %d MB (%s); SimRenderServer %d MB (%s); SimRenderServer lifetime peak %d MB (first seen in %s)\n",
        samples, swap, swap_test, render, render_test, peak, peak_test
    }' "$1"
}

# A hosted runner's freshly booted simulator has its render server burst to 2-6 GB a few minutes after boot, with no
# app running, and calm down on its own minutes later. XCTest's runner bootstrap waits on Accessibility, which starves
# inside the burst: an iPad destination that reached xcodebuild 3 minutes after boot lost its runner (UI suite run
# 38144004591), while those that reached it after 5-9 minutes passed (TAL-696). This returns once the render server's
# lifetime peak shows the burst came (over 1 GB) and its footprint is back under 400 MB, or after CAP_SECONDS.
settle() {
  local cap=$1 start=${SECONDS} processes current=0 peak=0
  while true; do
    processes=$(processes)
    current=$(megabytes "$(awk '$2 == "SimRenderServer" { print $3; exit }' <<< "${processes}")")
    peak=$(( $(render_server_peak_bytes "${processes}") / 1048576 ))
    if (( peak > 1024 && current < 400 )); then
      echo "SimRenderServer settled after $((SECONDS - start)) s: ${current} MB, lifetime peak ${peak} MB"
      return 0
    fi
    if (( SECONDS - start >= cap )); then
      echo "SimRenderServer had not settled after ${cap} s: ${current} MB, lifetime peak ${peak} MB"
      return 0
    fi
    sleep "${MEMORY_SETTLE_POLL_SECONDS:-10}"
  done
}

case "${1:-}" in
  sample) sample "$2" "$3" ;;
  watch) while true; do sample "$2" "$3" || true; sleep "${MEMORY_SAMPLE_SECONDS:-15}"; done ;;
  summary) summary "$2" ;;
  settle) settle "$2" ;;
  *) echo "usage: ci/memory-sampler watch|sample LOG XCODEBUILD_LOG | summary LOG | settle CAP_SECONDS" >&2; exit 2 ;;
esac
