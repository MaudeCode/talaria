#!/usr/bin/env bash
# Usage: ci/ui-suite-wait-turn RUN_ID [--once]
# Returns when it is this ui-suite.yml run's turn, so suite runs take turns instead of replacing each other (TAL-679).
# Unfinished runs queue by rank: priority first (a run on main, or one named "... (priority)"), then oldest run ID.
# It is RUN_ID's turn when no unfinished run ranks ahead of it and no run behind it is already past its "Queue" job;
# a running run from before this queue, with no "Queue" job, also counts as running. Nothing is ever cancelled.
# --once checks once: exit 0 for its turn, 10 to wait. Polls every UI_SUITE_QUEUE_POLL_SECONDS (default 60) otherwise;
# the job's timeout caps the wait. Read-only; ci/gh-api-poll retries transient API errors. Needs GH_TOKEN with
# actions: read and GITHUB_REPOSITORY.
set -euo pipefail

run=${1:?usage: ci/ui-suite-wait-turn RUN_ID [--once]}
once=${2:-}
poll=${UI_SUITE_QUEUE_POLL_SECONDS:-60}
api="$(dirname "$0")/gh-api-poll"
actions="repos/${GITHUB_REPOSITORY}/actions"

turn() {
  local runs mine rank id status running
  # One line per unfinished run: "RANK ID STATUS", RANK 0 for priority.
  runs=$("${api}" -H "Cache-Control: no-cache" "${actions}/workflows/ui-suite.yml/runs?per_page=100" \
    --jq '.workflow_runs[] | select(.status != "completed")
      | (if .head_branch == "main" or (.display_title | endswith(" (priority)")) then 0 else 1 end) as $rank
      | "\($rank) \(.id) \(.status)"') ||
    return 1
  mine=$(awk -v id="${run}" '$2 == id { print $1 }' <<< "${runs}")
  [[ -n "${mine}" ]] || { echo "Run ${run} is not listed yet."; return 1; }
  while read -r rank id status; do
    [[ -n "${id}" && "${id}" != "${run}" ]] || continue
    if (( rank < mine || (rank == mine && id < run) )); then
      echo "Waiting: run ${id} is ahead."; return 1
    fi
    [[ "${status}" == in_progress ]] || continue
    running=$("${api}" "${actions}/runs/${id}/jobs?per_page=100" --jq '[.jobs[] | select(.name == "Queue")]
        | if length == 0 then "from before the queue" elif .[0].conclusion == "success" then "running" else "" end') ||
      return 1
    [[ -z "${running}" ]] || { echo "Waiting: run ${id} is ${running}."; return 1; }
  done <<< "${runs}"
  echo "Run ${run}'s turn."
}

until turn; do
  [[ "${once}" != --once ]] || exit 10
  sleep "${poll}"
done
