#!/usr/bin/env bash
# Usage: ci/wait-for-job JOB_NAME [TIMEOUT_SECONDS]
# Wait for the newest record of JOB_NAME in this workflow run at or before this attempt and fail unless it
# succeeded. "Re-run failed jobs" keeps an earlier successful job and copies its record into the new attempt,
# so earlier attempts count. Needs GH_TOKEN with actions: read and the GITHUB_REPOSITORY/RUN_ID/RUN_ATTEMPT env.
set -euo pipefail

name=${1:?usage: ci/wait-for-job JOB_NAME [TIMEOUT_SECONDS]}
deadline=$((SECONDS + ${2:-1500}))
while :; do
  # shellcheck disable=SC2016 # jq, not the shell, expands $ENV.
  records=$(WAIT_JOB_NAME="${name}" gh api --paginate \
    "repos/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}/jobs?filter=all&per_page=100" \
    --jq '.jobs[] | select(.name == $ENV.WAIT_JOB_NAME and .run_attempt <= ($ENV.GITHUB_RUN_ATTEMPT | tonumber)) | "\(.run_attempt) \(.id) \(.status) \(.conclusion)"' \
    | sort -rn)
  read -r attempt _ status conclusion _ <<< "$(head -n 1 <<< "${records}") - - - -"
  [[ "${status}" == "completed" ]] && break
  (( SECONDS < deadline )) || { echo "Timed out waiting for ${name} (${records:-missing})" >&2; exit 1; }
  sleep "${WAIT_FOR_JOB_POLL_SECONDS:-15}"
done
[[ "${conclusion}" == "success" ]] || { echo "${name} finished ${conclusion} (attempt ${attempt})" >&2; exit 1; }
echo "${name} succeeded (attempt ${attempt})."
