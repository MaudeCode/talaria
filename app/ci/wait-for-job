#!/usr/bin/env bash
# Usage: ci/wait-for-job JOB_NAME [TIMEOUT_SECONDS [STEP_NAME]]
# Wait for the newest record of JOB_NAME in this workflow run at or before this attempt and fail unless it
# succeeded. "Re-run failed jobs" keeps an earlier successful job and copies its record into the new attempt,
# so earlier attempts count. With STEP_NAME, return as soon as that step of the job has succeeded: a job's
# completion reaches the API a minute or more after its last step. Polls every 5 seconds without caching and
# logs each observation. Needs GH_TOKEN with actions: read and the GITHUB_REPOSITORY/RUN_ID/RUN_ATTEMPT env.
set -euo pipefail

name=${1:?usage: ci/wait-for-job JOB_NAME [TIMEOUT_SECONDS [STEP_NAME]]}
deadline=$((SECONDS + ${2:-1500}))
step=${3:-}
while :; do
  # A unique query and no-cache keep a shared cache from replaying an earlier answer.
  # shellcheck disable=SC2016 # jq, not the shell, expands $ENV.
  records=$(WAIT_JOB_NAME="${name}" WAIT_STEP_NAME="${step}" gh api --paginate -H "Cache-Control: no-cache" \
    "repos/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}/jobs?filter=all&per_page=100&poll=${SECONDS}" \
    --jq '.jobs[] | select(.name == $ENV.WAIT_JOB_NAME and .run_attempt <= ($ENV.GITHUB_RUN_ATTEMPT | tonumber))
      | "\(.run_attempt) \(.status) \(.conclusion) \([.steps[]? | select(.name == $ENV.WAIT_STEP_NAME) | .conclusion][0])"' \
    | sort -rn)
  read -r attempt status conclusion step_conclusion _ <<< "$(head -n 1 <<< "${records}") - - - -"
  echo "$(date -u +%H:%M:%S) ${name}: attempt ${attempt} ${status} ${conclusion}${step:+, ${step} ${step_conclusion}}"
  [[ "${status}" == "completed" ]] && break
  if [[ -n "${step}" && "${step_conclusion}" == "success" ]]; then
    echo "${name} finished ${step} (attempt ${attempt})."
    exit 0
  fi
  (( SECONDS < deadline )) || { echo "Timed out waiting for ${name} (${records:-missing})" >&2; exit 1; }
  sleep "${WAIT_FOR_JOB_POLL_SECONDS:-5}"
done
[[ "${conclusion}" == "success" ]] || { echo "${name} finished ${conclusion} (attempt ${attempt})" >&2; exit 1; }
echo "${name} succeeded (attempt ${attempt})."
