// Shared app-identity and signing defaults, attached to the project as the
// base configuration for both build configurations (Debug and Release).
//
// Never edit this file or project.pbxproj to sign with your own Apple team.
// Create Config/Local.xcconfig (gitignored) instead — see DEVELOPMENT.md
// ("Signing with your own Apple team").

DEVELOPMENT_TEAM = Q28NF3NH3D
APP_IDENTIFIER_SUFFIX =
APP_BUNDLE_IDENTIFIER = dev.kil.talaria$(APP_IDENTIFIER_SUFFIX)
APP_GROUP_IDENTIFIER = group.dev.kil.talaria$(APP_IDENTIFIER_SUFFIX)
// Private CloudKit container for server-setup and preference sync (TAL-91).
// Must be enabled on the App ID in Certificates, Identifiers & Profiles; see
// docs/icloud-sync-setup.md.
ICLOUD_CONTAINER_IDENTIFIER = iCloud.dev.kil.talaria$(APP_IDENTIFIER_SUFFIX)
// Primary Icon Composer icon; Config/Dev.xcconfig swaps in the DEV-banner icon.
APP_ICON_NAME = Talaria

// Optional per-machine overrides. This include must stay last: later
// assignments win, so Local.xcconfig values override the defaults above.
#include? "Local.xcconfig"
