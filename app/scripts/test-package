#!/usr/bin/env bash
# Usage: scripts/test-package [--repeat N] [TalariaKitTests/Class[/testMethod] ...]
# Runs TalariaKit's package tests with `swift test`: no simulator (TAL-399). Without identifiers it runs every test once.
# With identifiers it builds once, then runs exactly those, up to N times (1 to 100, default 1) with --skip-build,
# stopping at the first failing attempt (TAL-2390). SwiftPM's own repetition flags apply only to Swift Testing, so the
# attempts are this loop. Each attempt must run every identifier exactly once and nothing else (ci/hosted-test-shard).
# Logs: TALARIA_PACKAGE_RESULTS (default .codex-tmp/package-tests/<run>/), one attempt-N.log each.
# Exit: 0 every attempt passed; 1 a test failed (that attempt's log is kept); 64 an invalid request; 65 an attempt ran other than the
# selection; 70 the build failed, or an attempt failed without a failing test (infrastructure).
set -euo pipefail

app=$(cd "$(dirname "$(realpath "$0")")/.." && pwd -P)
repeat=1
if [[ "${1:-}" == --repeat ]]; then
    repeat=${2:?--repeat needs a count}
    shift 2
fi
cd "$app"
run_dir=${TALARIA_PACKAGE_RESULTS:-$app/.codex-tmp/package-tests/$(date +%Y%m%d-%H%M%S)-$$}
mkdir -p "$run_dir"
filter=()
if (( $# )); then
    ci/hosted-test-shard focus "$repeat" "$@" > "$run_dir/plan.json" || exit 64
    jq -e '.target == "TalariaKitTests"' "$run_dir/plan.json" > /dev/null ||
        { echo "scripts/test-package runs TalariaKitTests identifiers; use scripts/test-ios for TalariaTests." >&2; exit 64; }
    filter=(--filter "$(ci/hosted-test-shard filter "$run_dir/plan.json")")
elif [[ "$repeat" != 1 ]]; then
    echo "--repeat needs identifiers: repeating the whole package is not a diagnostic." >&2
    exit 64
fi

swift build --package-path TalariaKit --build-tests --only-use-versions-from-resolved-file ||
    { echo "The package tests did not build." >&2; exit 70; }
for attempt in $(seq "$repeat"); do
    log="$run_dir/attempt-$attempt.log"
    status=0
    TALARIA_TEST_ATTEMPT=$attempt swift test --package-path TalariaKit --skip-build ${filter[@]+"${filter[@]}"} > "$log" 2>&1 ||
        status=$?
    if (( status )); then
        if grep -qE "^Test Case '-\[[^]]+\]' failed" "$log"; then
            grep -E "error: |^Test Case '-\[[^]]+\]' failed" "$log" | head -20 >&2
            echo "Attempt $attempt of $repeat failed a test; its log: $log" >&2
            exit 1
        fi
        tail -20 "$log" >&2
        echo "Attempt $attempt of $repeat failed without a failing test (infrastructure); its log: $log" >&2
        exit 70
    fi
    if (( ${#filter[@]} )); then
        mkdir -p "$run_dir/attempt-$attempt"
        ci/hosted-test-shard cases "$log" > "$run_dir/attempt-$attempt/shard-1.txt"
        ci/hosted-test-shard check "$run_dir/plan.json" "$run_dir/attempt-$attempt" > /dev/null ||
            { echo "Attempt $attempt ran other than the selection; its log: $log" >&2; exit 65; }
    fi
    echo "Attempt $attempt of $repeat passed: $(grep -oE 'Executed [0-9]+ tests?' "$log" | tail -1)."
done
echo "All $repeat attempt(s) passed. Logs: $run_dir"
