#!/usr/bin/env bash
# Prepares a booted simulator for hosted tests: the keyboard's one-time slide-to-type introduction is marked as shown,
# the notification service answers (scripts/ready-simulator-notifications, TAL-651), photo import is warmed on a
# best-effort basis (scripts/seed-simulator-photo, TAL-633), and the document picker's frameworks are warm
# (scripts/ready-simulator-documents, TAL-751). The introduction takes the first software keyboard
# down, and the composer collapses with it, on every freshly booted simulator (TAL-668); iOS 27 records it under
# TextInput's DidShowContinuousPathIntroduction preference. --keyboard-only does just that, for a simulator whose
# tests need no notifications, photos or document picker.
# GitHub Actions owns a disposable simulator and may reboot it once after notification readiness times out.
# Usage: scripts/prepare-ui-simulator [--keyboard-only] <simulator-udid>

set -euo pipefail
keyboard_only=false
recover_notifications=${GITHUB_ACTIONS:-false}
if [[ "${1:-}" == --keyboard-only ]]; then
    keyboard_only=true
    shift
fi
(( $# == 1 )) || { echo "Usage: scripts/prepare-ui-simulator [--keyboard-only] <simulator-udid>" >&2; exit 64; }
simulator_id=$1
scripts=$(cd "$(dirname "$(realpath "$0")")" && pwd -P)

prepare_step() {
    local name=$1 started=$SECONDS exit_status=0 budget=60
    # Match CI's initial boot limit; notification attempts retain their own 60-second limit.
    [[ "$name" == reboot ]] && budget=600
    # An absolute epoch deadline for the Python supervisor; EPOCHREALTIME needs bash 5.
    local now=$EPOCHREALTIME
    local deadline="$(( ${now%[.,]*} + budget )).${now#*[.,]}"
    shift
    echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') $name start elapsed=0s"
    if [[ "$name" == notifications || "$name" == photo || "$name" == reboot ]]; then
        # Hosted timing exceeded 60s in these clients; include their cleanup in the same budget.
        python3 - "$deadline" "$budget" "$name" "$@" <<'PYTHON' || exit_status=$?
import os
import signal
import subprocess
import sys
import time

deadline = float(sys.argv[1])
budget = sys.argv[2]
step = sys.argv[3]
process = subprocess.Popen(sys.argv[4:], start_new_session=True)

def signal_clients(signum):
    try:
        os.killpg(process.pid, signum)
    except (ProcessLookupError, PermissionError):
        # Group signaling can be denied; the helper PID is still ours to stop.
        try:
            process.send_signal(signum)
        except ProcessLookupError:
            pass

for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
    signal.signal(signum, lambda received, _: sys.exit(128 + received))
try:
    try:
        # Reserve the final second of the budget for helper/probe cleanup.
        exit_status = process.wait(timeout=max(0, deadline - time.time() - 1))
    except subprocess.TimeoutExpired:
        print(f"{step} timed out ({budget}-second budget including cleanup).", file=sys.stderr)
        # Hosted tests inject image bytes; the library asset only warms Photos. Readiness remains mandatory.
        exit_status = 0 if step == "photo" else 124
finally:
    signal_clients(signal.SIGTERM)
    try:
        process.wait(timeout=min(1, max(0, deadline - time.time())))
    except subprocess.TimeoutExpired:
        pass
    signal_clients(signal.SIGKILL)
    process.wait()
sys.exit(exit_status if exit_status >= 0 else 128 - exit_status)
PYTHON
    else
        "$@" || exit_status=$?
    fi
    echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') $name end elapsed=$(( SECONDS - started ))s"
    return "$exit_status"
}

for attempt in 1 2; do
    prepare_step keyboard xcrun simctl spawn "$simulator_id" defaults write com.apple.keyboard.preferences DidShowContinuousPathIntroduction -bool true
    [[ "$keyboard_only" == true ]] && exit 0
    # The successful keyboard spawn just verified this simulator is running; do not repeat its boot wait.
    if prepare_step notifications "$scripts/ready-simulator-notifications" --already-booted "$simulator_id"; then
        break
    else
        notification_status=$?
    fi
    if [[ "$recover_notifications" != true || "$attempt" == 2 || "$notification_status" != 124 ]]; then
        exit "$notification_status"
    fi
    echo "Notification readiness timed out; rebooting the disposable simulator once." >&2
    prepare_step reboot bash -c 'xcrun simctl shutdown "$1" && xcrun simctl bootstatus "$1" -b' -- "$simulator_id"
done
prepare_step photo "$scripts/seed-simulator-photo" "$simulator_id"
prepare_step documents "$scripts/ready-simulator-documents" "$simulator_id"
