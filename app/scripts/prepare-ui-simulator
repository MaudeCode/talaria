#!/bin/zsh
# Prepares a booted simulator for UI tests: the keyboard's one-time slide-to-type introduction is marked as shown,
# the notification service answers (scripts/ready-simulator-notifications, TAL-651), the Photos library holds a
# photo the tests own (scripts/seed-simulator-photo, TAL-633) and the document picker's frameworks are warm
# (scripts/ready-simulator-documents, TAL-751). The introduction takes the first software keyboard
# down, and the composer collapses with it, on every freshly booted simulator (TAL-668); iOS 27 records it under
# TextInput's DidShowContinuousPathIntroduction preference. --keyboard-only does just that, for a simulator whose
# tests need no notifications, photos or document picker.
# Usage: scripts/prepare-ui-simulator [--keyboard-only] <simulator-udid>

set -euo pipefail
keyboard_only=false
if [[ "${1:-}" == --keyboard-only ]]; then
    keyboard_only=true
    shift
fi
(( $# == 1 )) || { print -u2 "Usage: scripts/prepare-ui-simulator [--keyboard-only] <simulator-udid>"; exit 64; }
simulator_id=$1
scripts=${0:A:h}

prepare_step() {
    local name=$1 started=$SECONDS exit_status=0
    shift
    print -r -- "$(date -u '+%Y-%m-%dT%H:%M:%SZ') $name start elapsed=0s"
    "$@" || exit_status=$?
    print -r -- "$(date -u '+%Y-%m-%dT%H:%M:%SZ') $name end elapsed=$(( SECONDS - started ))s"
    return "$exit_status"
}

prepare_step keyboard xcrun simctl spawn "$simulator_id" defaults write com.apple.keyboard.preferences DidShowContinuousPathIntroduction -bool true
[[ "$keyboard_only" == true ]] && exit 0
prepare_step notifications "$scripts/ready-simulator-notifications" "$simulator_id"
prepare_step photo "$scripts/seed-simulator-photo" "$simulator_id"
prepare_step documents "$scripts/ready-simulator-documents" "$simulator_id"
