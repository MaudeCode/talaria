#!/usr/bin/env bash

set -euo pipefail

repo_root=$(cd "$(dirname "$(realpath "$0")")/.." && pwd -P)
[[ "${_TALARIA_ENV_LOADED:-}" == 1 ]] || exec "$repo_root/scripts/load-env" "$repo_root/scripts/run-ios-device" "$@"
build_dir="$repo_root/.codex-tmp/device-build"
# Talaria Dev (Config/Dev.xcconfig) installs beside the App Store/TestFlight app and never replaces it.
dev_bundle_id=dev.kil.talaria.branch
fresh=false
no_launch=false

usage() {
    echo "Usage: scripts/run-ios-device [--fresh] [--no-launch]"
    echo
    echo "Builds, installs, and launches Talaria Dev on the connected physical iPhone."
    echo "  --fresh  Clear the local device build cache first. Phone data is preserved."
    echo "  --no-launch  Install the app without launching it."
    echo
    echo "Set TALARIA_DEVICE_ID to a hardware UDID or CoreDevice identifier when"
    echo "more than one physical iPhone is paired."
}

while (( $# > 0 )); do
    case "$1" in
        --fresh)
            fresh=true
            ;;
        --no-launch)
            no_launch=true
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 64
            ;;
    esac
    shift
done

if [[ "$fresh" == true && -d "$build_dir" ]]; then
    [[ ! -L "$build_dir" ]] || {
        echo "Refusing to clear symlinked build directory: $build_dir" >&2
        exit 1
    }
    echo "Clearing $build_dir"
    find "$build_dir" -mindepth 1 -delete
fi
mkdir -p "$build_dir"

device_id=$("$repo_root/scripts/select-ios-device") || exit

cd "$repo_root"
echo "Building for iPhone $device_id"
build_log="$build_dir/build.log"
if ! xcodebuild build -quiet \
    -project Talaria.xcodeproj \
    -scheme Talaria \
    -configuration Debug \
    -destination "platform=iOS,id=$device_id" \
    -derivedDataPath "$build_dir" \
    -xcconfig Config/Dev.xcconfig \
    COMPILER_INDEX_STORE_ENABLE=NO >"$build_log" 2>&1; then
    cat "$build_log" >&2
    exit 1
fi
echo "Build complete"

app_path="$build_dir/Build/Products/Debug-iphoneos/Talaria.app"
[[ -d "$app_path" ]] || {
    echo "Build succeeded but the app was not found at $app_path" >&2
    exit 1
}
codesign --verify --deep --strict "$app_path"
PATH="$PATH:/usr/libexec"
bundle_id=$(PlistBuddy -c 'Print :CFBundleIdentifier' "$app_path/Info.plist")
[[ "$bundle_id" == "$dev_bundle_id" ]] || {
    echo "Refusing to install $bundle_id; expected Talaria Dev ($dev_bundle_id)." >&2
    exit 1
}

echo "Installing $bundle_id"
xcrun devicectl device install app --device "$device_id" "$app_path"

if [[ "$no_launch" == true ]]; then
    echo "Launch skipped"
    exit 0
fi

echo "Launching $bundle_id"
if ! launch_output=$(xcrun devicectl device process launch \
    --device "$device_id" \
    --terminate-existing \
    "$bundle_id" 2>&1); then
    if [[ "$launch_output" == *"reason: Locked"* ]]; then
        echo "Installed successfully. Unlock the iPhone and rerun; the cached build will be fast." >&2
    else
        printf '%s\n' "$launch_output" >&2
    fi
    exit 1
fi
printf '%s\n' "$launch_output"
