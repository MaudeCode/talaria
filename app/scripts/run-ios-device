#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
[[ "${_TALARIA_ENV_LOADED:-}" == 1 ]] || exec "$repo_root/scripts/load-env" "$repo_root/scripts/run-ios-device" "$@"
build_dir="$repo_root/.codex-tmp/device-build"
# Talaria Dev (Config/Dev.xcconfig) installs beside the App Store/TestFlight app and never replaces it.
dev_bundle_id=dev.kil.talaria.branch
fresh=false
no_launch=false

usage() {
    print "Usage: scripts/run-ios-device [--fresh] [--no-launch]"
    print
    print "Builds, installs, and launches Talaria Dev on the connected physical iPhone."
    print "  --fresh  Clear the local device build cache first. Phone data is preserved."
    print "  --no-launch  Install the app without launching it."
    print
    print "Set TALARIA_DEVICE_ID to a hardware UDID or CoreDevice identifier when"
    print "more than one physical iPhone is paired."
}

while (( $# > 0 )); do
    case "$1" in
        --fresh)
            fresh=true
            ;;
        --no-launch)
            no_launch=true
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            print -u2 "Unknown option: $1"
            usage >&2
            exit 64
            ;;
    esac
    shift
done

if [[ "$fresh" == true && -d "$build_dir" ]]; then
    [[ ! -L "$build_dir" ]] || {
        print -u2 "Refusing to clear symlinked build directory: $build_dir"
        exit 1
    }
    print "Clearing $build_dir"
    find "$build_dir" -mindepth 1 -delete
fi
mkdir -p "$build_dir"

device_id=$("$repo_root/scripts/select-ios-device") || exit

cd "$repo_root"
print "Building for iPhone $device_id"
build_log="$build_dir/build.log"
if ! xcodebuild build -quiet \
    -project Talaria.xcodeproj \
    -scheme Talaria \
    -configuration Debug \
    -destination "platform=iOS,id=$device_id" \
    -derivedDataPath "$build_dir" \
    -xcconfig Config/Dev.xcconfig \
    -allowProvisioningUpdates \
    COMPILER_INDEX_STORE_ENABLE=NO >"$build_log" 2>&1; then
    cat "$build_log" >&2
    exit 1
fi
print "Build complete"

app_path="$build_dir/Build/Products/Debug-iphoneos/Talaria.app"
[[ -d "$app_path" ]] || {
    print -u2 "Build succeeded but the app was not found at $app_path"
    exit 1
}
codesign --verify --deep --strict "$app_path"
bundle_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app_path/Info.plist")
[[ "$bundle_id" == "$dev_bundle_id" ]] || {
    print -u2 "Refusing to install $bundle_id; expected Talaria Dev ($dev_bundle_id)."
    exit 1
}

print "Installing $bundle_id"
xcrun devicectl device install app --device "$device_id" "$app_path"

if [[ "$no_launch" == true ]]; then
    print "Launch skipped"
    exit 0
fi

print "Launching $bundle_id"
if ! launch_output=$(xcrun devicectl device process launch \
    --device "$device_id" \
    --terminate-existing \
    "$bundle_id" 2>&1); then
    if [[ "$launch_output" == *"reason: Locked"* ]]; then
        print -u2 "Installed successfully. Unlock the iPhone and rerun; the cached build will be fast."
    else
        print -u2 "$launch_output"
    fi
    exit 1
fi
print "$launch_output"
