#!/usr/bin/env bash
# Warms the system document picker on a booted simulator (TAL-751). The picker's first presentation after boot
# cold-launches com.apple.DocumentManagerUICore.Service and the file-provider and icon services it browses: 8-18 s on a
# hosted runner against 5-11 s for the next one, and past the UI tests' 20 s wait in UI suite run 38144004591. The
# service is an app extension simctl cannot launch, so the Files app, which loads the same DocumentManager frameworks
# and browses the same providers, runs until it logs that its first collection finished gathering. This runs while
# the build does in CI.
# Usage: scripts/ready-simulator-documents <simulator-udid>

set -euo pipefail
(( $# == 1 )) || { echo "Usage: scripts/ready-simulator-documents <simulator-udid>" >&2; exit 64; }
simulator_id=$1

log_file=$(mktemp "${TMPDIR:-/tmp}/talaria-files-log.XXXXXX")
stream_pid=""
launch_pid=""
info_pid=""
started=$SECONDS
deadline=$(( started + 60 ))
cleanup() {
    local exit_status=$?
    set +e
    for pid in "$info_pid" "$stream_pid" "$launch_pid"; do
        [[ -z "$pid" ]] || kill "$pid" 2>/dev/null
    done
    # Termination is part of the same deadline; a stuck simctl must not stall the shard either.
    xcrun simctl terminate "$simulator_id" com.apple.DocumentsApp >/dev/null 2>&1 &
    local terminate_pid=$!
    while (( SECONDS < deadline )) && {
        kill -0 "$stream_pid" 2>/dev/null ||
        { [[ -n "$launch_pid" ]] && kill -0 "$launch_pid" 2>/dev/null; } ||
        kill -0 "$terminate_pid" 2>/dev/null
    }; do
        sleep 0.1
    done
    for pid in "$info_pid" "$stream_pid" "$launch_pid" "$terminate_pid"; do
        [[ -z "$pid" ]] && continue
        kill -KILL "$pid" 2>/dev/null
        wait "$pid" 2>/dev/null
    done
    rm -f "$log_file"
    return "$exit_status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# Some simulator images ship no Files app, such as the iPhone Duo's iOS 27.1 (TAL-1456): nothing there warms the
# picker, and launching it fails. The lookup takes under a second; one stalled behind a busy CoreSimulator gets 15 s of
# the deadline, and then, like any other lookup failure, the launch below goes ahead and reports what it finds.
xcrun simctl appinfo "$simulator_id" com.apple.DocumentsApp >"$log_file" 2>&1 &
info_pid=$!
while kill -0 "$info_pid" 2>/dev/null && (( SECONDS < started + 15 )); do
    sleep 0.1
done
if ! kill -0 "$info_pid" 2>/dev/null; then
    info_status=0
    wait "$info_pid" || info_status=$?
    info_pid=""
    if (( info_status != 0 )) && grep -q "No application record found" "$log_file"; then
        echo "Simulator $simulator_id has no Files app; the document picker has nothing to warm."
        exit 0
    fi
fi
: >"$log_file"

xcrun simctl spawn "$simulator_id" log stream --style ndjson --level debug --timeout 60 \
    --predicate 'process == "Files" AND eventMessage CONTAINS "collectionDidFinishGathering"' >"$log_file" 2>&1 &
stream_pid=$!
xcrun simctl launch "$simulator_id" com.apple.DocumentsApp >/dev/null &
launch_pid=$!
# Reserve five seconds for the termination client to start and send its request on a busy host.
while (( SECONDS < deadline - 5 )); do
    if [[ -n "$launch_pid" ]] && ! kill -0 "$launch_pid" 2>/dev/null; then
        wait "$launch_pid"
        launch_pid=""
    fi
    if [[ -z "$launch_pid" ]] && grep -q '"eventMessage"[[:space:]]*:.*collectionDidFinishGathering' "$log_file"; then
        echo "Files finished gathering on simulator $simulator_id after $(( SECONDS - started ))s."
        exit 0
    fi
    sleep 1
done
echo "Files never finished gathering on simulator $simulator_id after $(( SECONDS - started ))s; its document picker may still start cold." >&2
