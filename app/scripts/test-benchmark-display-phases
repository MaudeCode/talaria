#!/usr/bin/env python3
"""Synthetic check of benchmark-display-phases' interval pairing and miss counting; never touches a simulator."""
import importlib.machinery
import importlib.util
from pathlib import Path

path = Path(__file__).resolve().parent / "benchmark-display-phases"
loader = importlib.machinery.SourceFileLoader("benchmark_display_phases", str(path))
benchmark = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(benchmark)


def event(pid, name, signpost_id, kind, stamp, message=""):
    return dict(processID=pid, signpostName=name, signpostID=signpost_id, signpostType=kind,
                timestamp=f"2026-11-09 07:10:{stamp}-0800", eventMessage=message)


launched = benchmark.intervals([
    event(7, "Launch", 1, "begin", "10.000000"),
    event(7, "Launch Ready", 2, "begin", "10.000000"),
    event(8, "Launch", 1, "end", "10.100000", "outcome=server rows=1"),  # another process
    event(7, "Launch", 1, "end", "10.250000", "outcome=cache rows=3"),
    event(7, "Launch Ready", 2, "end", "11.500000", "outcome=server rows=4"),
    event(7, "Session Open", 3, "begin", "12.000000"),
    event(7, "Session Open", 3, "end", "12.100000", "outcome=replaced rows=0"),
], 7)
assert launched == {
    "Launch": [(250.0, "cache")],
    "Launch Ready": [(1500.0, "server")],
    "Session Open": [(100.0, "replaced")],
}, launched

summary = benchmark.summarize({"A.app": [launched, {"Launch": [(350.0, "composer")]}]})["A.app"]
assert summary["Launch"] == (300.0, 250.0, 350.0, 2, 0), summary["Launch"]
assert summary["Session Open"] == (None, None, None, 0, 2), "Not reached and never ended are misses"
assert summary["Session Open Ready"] == (None, None, None, 0, 2), summary["Session Open Ready"]
print("benchmark-display-phases checks passed")
