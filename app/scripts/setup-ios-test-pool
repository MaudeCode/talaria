#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
pool_size=${IOS_SIMULATOR_POOL_SIZE:-6}
pool_runtime_dir=${IOS_SIMULATOR_POOL_DIR:-/tmp/ios-simulator-pool-$EUID}
pool_lock="$pool_runtime_dir/pool.lock"
lease_dir="$pool_runtime_dir/leases"
refresh=false
typeset -a held_lease_files=()

usage() {
    print "Usage: scripts/setup-ios-test-pool [--refresh]"
}

if (( $# > 1 )); then
    usage >&2
    exit 64
fi
if (( $# == 1 )); then
    [[ "$1" == "--refresh" ]] || {
        usage >&2
        exit 64
    }
    refresh=true
fi
if [[ "$pool_size" != <-> || "$pool_size" -lt 1 ]]; then
    print -u2 "IOS_SIMULATOR_POOL_SIZE must be a positive integer."
    exit 64
fi

mkdir -p "$lease_dir"

cleanup() {
    for lease_file in "${held_lease_files[@]}"; do
        unlink "$lease_file" 2>/dev/null || true
    done
    unlink "$pool_lock" 2>/dev/null || true
}

if ! /usr/bin/shlock -f "$pool_lock" -p $$; then
    print -u2 "The iOS simulator pool is already being configured. Retry when it finishes."
    exit 75
fi
trap cleanup EXIT
trap 'exit 130' INT TERM

# Reuse the existing shared pool's runtime/model, even when a newer SDK is installed.
selection=$(xcrun simctl list devices available --json | /usr/bin/jq -r \
    --arg requested "${IOS_SIMULATOR_RUNTIME:-}" '
    [.devices | to_entries[] | .key as $runtime |
     select($requested == "" or $requested == $runtime) | .value[] |
     select(.name | test("^iOS Test [1-9][0-9]*$")) |
     [.udid, $runtime, .deviceTypeIdentifier]] | first // [] | @tsv
')
[[ -n "$selection" ]] || selection=$("$repo_root/scripts/select-ios-simulator")
IFS=$'\t' read -r _ runtime_id device_type_id <<< "$selection"

pool_snapshot() {
    xcrun simctl list devices --json | /usr/bin/jq -r '
        [.devices[][] | select(.name | test("^iOS Test [0-9]+$"))] |
        sort_by(.name, .udid) | .[] | [.name, .udid, .state] | @tsv
    '
}

if [[ "$refresh" == true ]]; then
    before=$(pool_snapshot)
    while IFS=$'\t' read -r _ simulator_id _; do
        [[ -n "$simulator_id" ]] || continue
        lease_file="$lease_dir/$simulator_id.lock"
        if ! /usr/bin/shlock -f "$lease_file" -p $$; then
            print -u2 "An iOS pool simulator is leased. Retry when its test run finishes."
            exit 75
        fi
        held_lease_files+=("$lease_file")
    done <<< "$before"

    after=$(pool_snapshot)
    [[ "$before" == "$after" ]] || {
        print -u2 "The iOS simulator pool changed during refresh preflight. No devices were removed."
        exit 75
    }
    if print -r -- "$after" | awk -F '\t' 'NF && $3 != "Shutdown" { found=1 } END { exit !found }'; then
        print -u2 "An iOS pool simulator is active. No devices were removed."
        exit 75
    fi

    while IFS=$'\t' read -r _ simulator_id _; do
        [[ -n "$simulator_id" ]] || continue
        xcrun simctl delete "$simulator_id"
        print "Removed iOS pool simulator $simulator_id"
    done <<< "$after"
fi

for (( slot = 1; slot <= pool_size; slot++ )); do
    simulator_name="iOS Test $slot"
    devices_json=$(xcrun simctl list devices --json)
    match_count=$(print -r -- "$devices_json" | /usr/bin/jq --arg name "$simulator_name" \
        '[.devices[][] | select(.name == $name)] | length')

    if (( match_count > 1 )); then
        print -u2 "Multiple simulators are named $simulator_name. Run with --refresh."
        exit 69
    fi
    if (( match_count == 1 )); then
        matches_source=$(print -r -- "$devices_json" | /usr/bin/jq -e \
            --arg name "$simulator_name" --arg runtime "$runtime_id" --arg type "$device_type_id" '
                any(.devices | to_entries[];
                    .key == $runtime and any(.value[]; .name == $name and .deviceTypeIdentifier == $type)
                )
            ' >/dev/null && print yes || print no)
        [[ "$matches_source" == yes ]] || {
            print -u2 "$simulator_name uses a stale runtime or device type. Run with --refresh."
            exit 69
        }
        print "Reusing $simulator_name"
        continue
    fi

    simulator_id=$(xcrun simctl create "$simulator_name" "$device_type_id" "$runtime_id")
    print "Created $simulator_name ($simulator_id)"
    xcrun simctl boot "$simulator_id"
    xcrun simctl bootstatus "$simulator_id" -b >/dev/null
    xcrun simctl shutdown "$simulator_id"
    print "Warmed $simulator_name"
done
