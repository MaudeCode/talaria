#!/usr/bin/env python3
"""Exercise simulator preparation with disposable tools; never touches a simulator."""
import os
from pathlib import Path
import re
import signal
import subprocess
import tempfile
import time
import unittest

SCRIPTS = Path(__file__).resolve().parent
FAKE_XCRUN = '''#!/usr/bin/env python3
import os, pathlib, signal, sys, time
state = pathlib.Path(os.environ['PREPARE_TEST_STATE'])
args = sys.argv[1:]
if os.environ.get('PREPARE_TEST_MODE') == 'timeout' and args[1] == 'terminate':
    time.sleep(2)  # A busy host can delay the termination client before its request is dispatched.
with (state / 'calls').open('a') as log:
    log.write(' '.join(args) + '\\n')
if os.environ.get('PREPARE_TEST_MODE') == 'verified-boot':
    if args[1] == 'spawn' and 'defaults' in args:
        (state / 'boot-verified').touch()
    if args[1] == 'bootstatus' and (state / 'boot-verified').exists():
        (state / 'redundant-bootstrap.pid').write_text(str(os.getpid()))
        while True:
            time.sleep(1)
    if args[1] == 'push':
        (state / 'notification-probed').touch()
        sys.exit(1)  # The booted service answered for the uninstalled probe bundle.
    sys.exit(0)
if os.environ.get('PREPARE_TEST_MODE') in ('photo-timeout', 'photo-error') and args[1] == 'addmedia':
    assert pathlib.Path(args[-1]).read_bytes().startswith(bytes.fromhex('ffd8'))
    (state / 'photo-payload').write_text(args[-1])
    (state / 'photo-client.pid').write_text(str(os.getpid()))
    (state / 'photo-helper.pid').write_text(str(os.getppid()))
    if os.environ['PREPARE_TEST_MODE'] == 'photo-error':
        sys.exit(42)
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    while True:
        time.sleep(1)
if os.environ.get('PREPARE_TEST_MODE') in ('notification-restart', 'notification-slow'):
    if args[1] == 'push':
        counter = state / 'notification-pushes'
        attempt = int(counter.read_text()) + 1 if counter.exists() else 1
        counter.write_text(str(attempt))
        (state / f'notification-push-{attempt}.pid').write_text(str(os.getpid()))
        if os.environ['PREPARE_TEST_MODE'] == 'notification-slow':
            time.sleep(7)  # A ready server, but a starved runner's push round trip outlasts 5 s.
        else:
            while not (state / 'dasd-restarted').exists():
                time.sleep(.05)  # SpringBoard's server starts once dasd restarts.
        print('Synthetic notification authorization failure', file=sys.stderr)
        sys.exit(1)  # Unauthorized for the uninstalled bundle: the notification server answered.
    if 'launchctl' in args:
        (state / 'notification-restart.pid').write_text(str(os.getpid()))
        if os.environ['PREPARE_TEST_MODE'] == 'notification-slow':
            sys.exit(0)
        (state / 'dasd-restarted').touch()
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        while True:
            time.sleep(1)
    sys.exit(0)
if 'stream' in args:
    (state / 'stream.pid').write_text(str(os.getpid()))
    print('Filtering: collectionDidFinishGathering', flush=True)
    while not (state / 'launched').exists():
        time.sleep(.01)
    if os.environ.get('PREPARE_TEST_MODE') == 'success':
        print('{"eventMessage":"collectionDidFinishGathering"}', flush=True)
    while True:
        time.sleep(1)
if 'show' in args:
    time.sleep(.1)  # An expensive full-log scan must not extend the deadline.
if len(args) > 1 and args[1] == 'terminate':
    (state / 'terminate.pid').write_text(str(os.getpid()))
    if os.environ.get('PREPARE_TEST_MODE') == 'timeout':
        while True:
            time.sleep(1)
if len(args) > 1 and args[1] == 'launch':
    (state / 'launch.pid').write_text(str(os.getpid()))
    time.sleep(.1)  # Give the independently started stream time to attach.
    (state / 'launched').touch()
    if os.environ.get('PREPARE_TEST_MODE') == 'interrupt':
        while True:
            time.sleep(1)
    if os.environ.get('PREPARE_TEST_MODE') == 'launch-failure':
        sys.exit(42)
'''


class PreparationTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix='talaria-prepare-test-')
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name)
        self.bin = self.root / 'bin'
        self.bin.mkdir()
        self.scratch = self.root / 'tmp'
        self.scratch.mkdir()
        self.stopped = {}
        tool = self.bin / 'xcrun'
        tool.write_text(FAKE_XCRUN)
        tool.chmod(0o755)
        self.env = dict(os.environ, PATH=f'{self.bin}:{os.environ["PATH"]}',
                        PREPARE_TEST_STATE=str(self.root), TMPDIR=str(self.scratch) + '/', GITHUB_ACTIONS='false')

    def stop_process(self, process, *pid_files):
        if process in self.stopped:
            return self.stopped[process]
        owned_pids = [process.pid]
        for name in pid_files:
            marker = self.root / name
            if marker.exists():
                owned_pids.append(int(marker.read_text()))
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass
        for pid in owned_pids:
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        result = process.communicate() if not process.stdout.closed else ('', None)
        self.stopped[process] = result
        return result

    def run_documents(self, mode, interrupt=False):
        self.env['PREPARE_TEST_MODE'] = mode
        start = time.monotonic()
        process = subprocess.Popen([str(SCRIPTS / 'ready-simulator-documents'), 'synthetic-simulator'],
                                   env=self.env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                   text=True, start_new_session=True)
        self.document_process = process
        self.addCleanup(self.stop_process, process, 'stream.pid', 'launch.pid', 'terminate.pid')
        try:
            if interrupt:
                deadline = time.monotonic() + 5
                while not (self.root / 'launched').exists() and time.monotonic() < deadline:
                    time.sleep(.01)
                self.assertTrue((self.root / 'launched').exists(), 'Files launch was never attempted')
                process.send_signal(signal.SIGTERM)
            output, _ = process.communicate(timeout=63 if mode == 'timeout' else 8)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            output, _ = process.communicate()
            self.fail(f'Files warm-up exceeded its 60-second wall-clock bound: {output}')
        elapsed = time.monotonic() - start
        return process.returncode, output, elapsed

    def assert_cleanup(self):
        calls = (self.root / 'calls').read_text().splitlines()
        self.assertIn('simctl terminate synthetic-simulator com.apple.DocumentsApp', calls)
        stream_pid = self.root / 'stream.pid'
        self.assertTrue(stream_pid.exists(), 'No live log stream was started')
        for name in ('stream', 'launch', 'terminate'):
            with self.assertRaises(ProcessLookupError, msg=f'The {name} process survived script exit'):
                os.kill(int((self.root / f'{name}.pid').read_text()), 0)
        self.assertEqual(list(self.scratch.iterdir()), [], 'The stream log leaked')
        self.assertEqual(sum('log stream ' in call for call in calls), 1, calls)
        self.assertFalse(any('log show ' in call for call in calls), calls)

    def test_deadline_and_timeout_cleanup(self):
        code, output, elapsed = self.run_documents('timeout')
        self.assertEqual(code, 0, output)  # A cold document picker remains a warning.
        self.assertGreaterEqual(elapsed, 59, output)
        self.assertLess(elapsed, 63, output)
        self.assertRegex(output, r'Files never finished gathering.*[0-9]+s')
        self.assert_cleanup()

    def test_success_failure_and_signal_cleanup(self):
        for mode, interrupt, expected in [('success', False, 0), ('launch-failure', False, 42),
                                           ('interrupt', True, 143)]:
            with self.subTest(mode=mode):
                for item in self.root.glob('*'):
                    if item.is_file():
                        item.unlink()
                try:
                    code, output, _ = self.run_documents(mode, interrupt)
                    self.assertEqual(code, expected, output)
                    if mode == 'success':
                        self.assertRegex(output, r'Files finished gathering.*[0-9]+s')
                    self.assert_cleanup()
                finally:
                    self.stop_process(self.document_process, 'stream.pid', 'launch.pid', 'terminate.pid')

    def run_notification_readiness(self, mode, timeout):
        self.env['PREPARE_TEST_MODE'] = mode
        # The deadline must not depend on another external client starting promptly on a busy runner.
        sleeper = self.bin / 'sleep'
        sleeper.write_text('#!/bin/sh\nexec python3 -c "import time; time.sleep(30)"\n')
        sleeper.chmod(0o755)
        process = subprocess.Popen([str(SCRIPTS / 'ready-simulator-notifications'), 'synthetic-simulator'],
                                   env=self.env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                   text=True, start_new_session=True)
        self.addCleanup(self.stop_process, process, 'notification-push-1.pid', 'notification-restart.pid')
        started = time.monotonic()
        try:
            output, _ = process.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            output, _ = self.stop_process(process, 'notification-push-1.pid', 'notification-restart.pid')
            pushes = (self.root / 'notification-pushes').read_text()
            self.fail(f'The server answered, but readiness never saw it within {timeout}s ({pushes} probes): {output}')
        return process.returncode, output, time.monotonic() - started

    def assert_notification_clients_stopped(self, output):
        self.assertIn('Synthetic notification authorization failure', output)
        self.assertIn('simctl bootstatus synthetic-simulator -b', (self.root / 'calls').read_text())
        for name in ('notification-push-1.pid', 'notification-restart.pid'):
            with self.assertRaises(ProcessLookupError, msg=f'{name} survived readiness completion'):
                os.kill(int((self.root / name).read_text()), 0)
        self.assertEqual(list(self.scratch.iterdir()), [], 'Notification payload leaked')

    def test_pending_probe_sees_the_server_a_stalled_dasd_restart_unblocked(self):
        code, output, elapsed = self.run_notification_readiness('notification-restart', timeout=13)
        self.assertEqual(code, 0, output)
        self.assertLess(elapsed, 12, output)
        # The probe that was waiting when dasd restarted is the one that answers; it is never cut short (TAL-2352).
        self.assertEqual((self.root / 'notification-pushes').read_text(), '1')
        self.assertIn('restart client did not finish within 5s; still waiting on the probe', output)
        self.assert_notification_clients_stopped(output)

    def test_probe_slower_than_five_seconds_still_answers(self):
        # Hosted runners took 1 to 5 s for an answering push and a starved one longer, so a probe cut short after 5 s
        # never saw a ready server (TAL-2352).
        code, output, elapsed = self.run_notification_readiness('notification-slow', timeout=15)
        self.assertEqual(code, 0, output)
        self.assertLess(elapsed, 12, output)
        self.assertEqual((self.root / 'notification-pushes').read_text(), '1')
        self.assertRegex(output, r'Notification probe answered after [0-9]+s \(status 1\)')
        self.assert_notification_clients_stopped(output)

    def copy_prepare_script(self, *helpers):
        repo = self.root / 'scripts'
        repo.mkdir()
        for name in ('prepare-ui-simulator', *helpers):
            script = repo / name
            script.write_bytes((SCRIPTS / name).read_bytes())
            script.chmod(0o755)
        return repo / 'prepare-ui-simulator'

    def test_preparation_probes_notifications_after_keyboard_verified_boot(self):
        script = self.copy_prepare_script('ready-simulator-notifications')
        for name in ('seed-simulator-photo', 'ready-simulator-documents'):
            helper = script.with_name(name)
            helper.write_text('#!/bin/sh\nexit 0\n')
            helper.chmod(0o755)
        process = subprocess.Popen([str(script), 'synthetic-simulator'],
                                   env=dict(self.env, PREPARE_TEST_MODE='verified-boot'),
                                   stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                   text=True, start_new_session=True)
        self.addCleanup(self.stop_process, process, 'redundant-bootstrap.pid')
        output, _ = process.communicate(timeout=63)
        self.assertEqual(process.returncode, 0, output)
        self.assertTrue((self.root / 'notification-probed').exists(), output)
        self.assertIn('documents end', output)
        self.assertEqual(list(self.scratch.iterdir()), [], 'Notification scratch files leaked')

    def test_photo_warmup_deadline_continues_preparation(self):
        script = self.copy_prepare_script('seed-simulator-photo')
        for name in ('ready-simulator-notifications', 'ready-simulator-documents'):
            helper = script.with_name(name)
            helper.write_text('#!/bin/sh\nexit 0\n')
            helper.chmod(0o755)
        process = subprocess.Popen([str(script), 'synthetic-simulator'],
                                   env=dict(self.env, PREPARE_TEST_MODE='photo-timeout'),
                                   stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                   text=True, start_new_session=True)
        started = time.monotonic()
        try:
            try:
                output, _ = process.communicate(timeout=63)
            except subprocess.TimeoutExpired:
                self.fail('Photo warm-up exceeded its 60-second wall-clock budget')
            self.assertEqual(process.returncode, 0, output)
            self.assertLess(time.monotonic() - started, 63, output)
            self.assertIn('photo timed out (60-second budget including cleanup)', output)
            self.assertIn('documents end', output)
            for name in ('photo-helper.pid', 'photo-client.pid'):
                with self.assertRaises(ProcessLookupError, msg=f'{name} survived photo warm-up'):
                    os.kill(int((self.root / name).read_text()), 0)
            self.assertEqual(list(self.scratch.iterdir()), [], 'Photo payload leaked')
        finally:
            self.stop_process(process, 'photo-helper.pid', 'photo-client.pid')

    def test_photo_payload_cleanup_preserves_import_error(self):
        process = subprocess.Popen([str(SCRIPTS / 'seed-simulator-photo'), 'synthetic-simulator'],
                                   env=dict(self.env, PREPARE_TEST_MODE='photo-error'),
                                   stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                   text=True, start_new_session=True)
        try:
            output, _ = process.communicate(timeout=5)
            self.assertEqual(process.returncode, 42, output)
            payload = Path((self.root / 'photo-payload').read_text())
            self.assertIn(self.scratch, payload.parents, 'Photo payload escaped the requested temporary directory')
            self.assertFalse(payload.exists(), 'Photo payload survived import failure')
            self.assertEqual(list(self.scratch.iterdir()), [], 'Photo payload leaked after import failure')
        finally:
            self.stop_process(process, 'photo-client.pid')
            receipt = self.root / 'photo-payload'
            if receipt.exists():
                payload = Path(receipt.read_text())
                if payload.name.startswith('talaria-ui-photo.') and payload.suffix == '.jpg':
                    # The baseline helper appends .jpg to a separately created tempfile; both are test-owned.
                    payload.unlink(missing_ok=True)
                    payload.with_suffix('').unlink(missing_ok=True)

    def test_group_permission_error_preserves_interruption(self):
        script = self.copy_prepare_script()
        hooks = self.root / 'python-hooks'
        hooks.mkdir()
        # Inject the observed syscall error through Python's existing startup interface, without a root process.
        (hooks / 'sitecustomize.py').write_text('\n'.join([
            'import errno, os, pathlib, sys',
            'if sys.argv[0] == "-":',
            '    state = pathlib.Path(os.environ["PREPARE_TEST_STATE"])',
            '    (state / "wrapper.pid").write_text(str(os.getpid()))',
            '    def denied(*args):',
            '        raise PermissionError(errno.EPERM, "simulated hosted group permission failure")',
            '    os.killpg = denied',
        ]) + '\n')
        notifications = script.with_name('ready-simulator-notifications')
        notifications.write_text('\n'.join([
            '#!/usr/bin/env python3',
            'import os, pathlib, time',
            'state = pathlib.Path(os.environ["PREPARE_TEST_STATE"])',
            '(state / "permission-child.pid").write_text(str(os.getpid()))',
            'while True: time.sleep(1)',
        ]) + '\n')
        notifications.chmod(0o755)
        process = subprocess.Popen([str(script), 'synthetic-simulator'],
                                   env=dict(self.env, PYTHONPATH=str(hooks)),
                                   stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                   text=True, start_new_session=True)
        try:
            deadline = time.monotonic() + 3
            while not (self.root / 'permission-child.pid').exists() and time.monotonic() < deadline:
                time.sleep(.01)
            self.assertTrue((self.root / 'permission-child.pid').exists(), 'Notification client never started')
            os.kill(int((self.root / 'wrapper.pid').read_text()), signal.SIGTERM)
            try:
                process.wait(timeout=4)
            except subprocess.TimeoutExpired:
                self.fail('Denied group signaling left the owned notification helper running')
            # Capture liveness before test-owned cleanup drains pipes held by a leaked helper.
            try:
                os.kill(int((self.root / 'permission-child.pid').read_text()), 0)
                child_alive = True
            except ProcessLookupError:
                child_alive = False
            output, _ = self.stop_process(process, 'wrapper.pid', 'permission-child.pid')
            self.assertEqual(process.returncode, 143, output)
            self.assertNotIn('PermissionError', output)
            self.assertNotIn('photo start', output)
            self.assertFalse(child_alive, 'Denied group signaling leaked the owned notification helper')
        finally:
            self.stop_process(process, 'wrapper.pid', 'permission-child.pid')

    def test_notification_step_deadline_kills_descendants(self):
        script = self.copy_prepare_script()
        notifications = script.with_name('ready-simulator-notifications')
        notifications.write_text('\n'.join([
            '#!/usr/bin/env python3',
            'import os, pathlib, signal, subprocess, time',
            'state = pathlib.Path(os.environ["PREPARE_TEST_STATE"])',
            '(state / "notifications.pid").write_text(str(os.getpid()))',
            'signal.signal(signal.SIGTERM, signal.SIG_IGN)',
            'child = subprocess.Popen(["sleep", "300"])',
            '(state / "probe.pid").write_text(str(child.pid))',
            'while True: time.sleep(1)',
        ]) + '\n')
        notifications.chmod(0o755)
        # On CI too: a reboot restarted the server's own startup on the same busy runner and never helped (TAL-2352).
        process = subprocess.Popen([str(script), 'synthetic-simulator'], env=dict(self.env, GITHUB_ACTIONS='true'),
                                   stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                   text=True, start_new_session=True)
        start = time.monotonic()
        try:
            try:
                output, _ = process.communicate(timeout=150)
            except subprocess.TimeoutExpired:
                self.fail('Notification preparation exceeded its wall-clock bound')
            self.assertIn("notifications timed out (90-second budget including cleanup): "
                          "SpringBoard's notification server never answered the probe push", output)
            self.assertEqual(process.returncode, 124, output)
            self.assertLess(time.monotonic() - start, 93, output)
            self.assertGreaterEqual(time.monotonic() - start, 89, output)
            self.assertEqual(len(re.findall(r'notifications end elapsed=[0-9]+s', output)), 1, output)
            self.assertNotIn('simctl shutdown', (self.root / 'calls').read_text())
            self.assertNotIn('photo start', output)
            probe_pid = int((self.root / 'probe.pid').read_text())
            # An orphan can briefly be a zombie while init reaps it on Linux.
            reap_deadline = time.monotonic() + 2
            while True:
                try:
                    os.kill(probe_pid, 0)
                except ProcessLookupError:
                    break
                self.assertLess(time.monotonic(), reap_deadline, 'A notification probe survived its deadline')
                time.sleep(.01)
        finally:
            self.stop_process(process, 'notifications.pid', 'probe.pid')

    def test_prepare_step_timings_and_keyboard_only(self):
        # Keep the real orchestration script; replace only its external step executables.
        script = self.copy_prepare_script()
        repo = script.parent
        for name in ('ready-simulator-notifications', 'seed-simulator-photo', 'ready-simulator-documents'):
            step = repo / name
            step.write_text('#!/bin/sh\nprintf "%s\\n" "$0 $*" >> "$PREPARE_TEST_STATE/steps"\n'
                            'if [ "${0##*/}" = "${PREPARE_FAIL_STEP:-}" ]; then exit "${PREPARE_STEP_EXIT:-0}"; fi\n')
            step.chmod(0o755)
        for options, steps, expected, failed_step in [
                ([], ['keyboard', 'notifications', 'photo', 'documents'], 0, ''),
                (['--keyboard-only'], ['keyboard'], 0, ''),
                # Hosted shards whose tests never wait on the notification server (TAL-2352).
                (['--without-notifications'], ['keyboard', 'photo', 'documents'], 0, ''),
                ([], ['keyboard', 'notifications'], 42, 'ready-simulator-notifications'),
                ([], ['keyboard', 'notifications', 'photo'], 42, 'seed-simulator-photo')]:
            with self.subTest(options=options, expected=expected):
                (self.root / 'steps').unlink(missing_ok=True)
                result = subprocess.run([str(repo / 'prepare-ui-simulator'), *options, 'synthetic-simulator'],
                                        env=dict(self.env, PREPARE_STEP_EXIT=str(expected), PREPARE_FAIL_STEP=failed_step),
                                        capture_output=True, text=True, timeout=5)
                self.assertEqual(result.returncode, expected, result.stderr)
                lines = result.stdout.splitlines()
                self.assertEqual(len(lines), len(steps) * 2, result.stdout)
                for index, step in enumerate(steps):
                    for offset, phase in enumerate(('start', 'end')):
                        self.assertRegex(lines[index * 2 + offset],
                                         rf'^\d{{4}}-\d{{2}}-\d{{2}}T\S+ {step} {phase} elapsed=[0-9]+s$')
                calls = (self.root / 'steps').read_text().splitlines() if (self.root / 'steps').exists() else []
                self.assertEqual(len(calls), len(steps) - 1)


if __name__ == '__main__':
    unittest.main()
