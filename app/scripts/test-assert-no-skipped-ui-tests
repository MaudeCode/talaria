#!/usr/bin/env python3
"""Synthetic xcresult output verifies selected smoke execution and skip failures."""

import json
import os
from pathlib import Path
import subprocess
import tempfile

script = Path(__file__).with_name("assert-no-skipped-ui-tests")
with tempfile.TemporaryDirectory(prefix="talaria-ui-results-") as temporary:
    root = Path(temporary)
    result = root / "result.xcresult"
    result.mkdir()
    fixture = root / "result.json"
    xcrun = root / "xcrun"
    xcrun.write_text('#!/bin/sh\ncat "$CI_RESULT_FIXTURE"\n')
    xcrun.chmod(0o755)
    env = {"PATH": str(root) + os.pathsep + os.environ["PATH"], "HOME": str(root), "CI_RESULT_FIXTURE": str(fixture)}
    prefix = "test://com.apple.xcode/Talaria/TalariaUITests/"
    smoke = {"nodeType": "Test Case", "result": "Passed",
             "nodeIdentifierURL": prefix + "ChatNavigationUITests/testChatSessionOpensFromList()"}
    for nodes, focused, expected in (([smoke], True, 0), ([], True, 1), ([], False, 0),
                                    ([{**smoke, "result": "Skipped"}], True, 1),
                                    ([{**smoke, "result": "Failed"}], True, 1),
                                    ([{**smoke, "nodeIdentifierURL": prefix + "Other/test()"}], True, 1),
                                    ([{**smoke, "result": "Skipped"}], False, 1)):
        fixture.write_text(json.dumps({"testNodes": nodes}))
        command = [str(script), str(result), *(["--require-launch-smoke"] if focused else [])]
        completed = subprocess.run(command, env=env, capture_output=True, text=True)
        assert completed.returncode == expected, (nodes, completed.stderr)
print("UI skip and required launch-smoke checks passed.")
