#!/usr/bin/env python3
"""Synthetic xcresult output verifies that a skipped UI test fails the check."""

import json
import os
from pathlib import Path
import subprocess
import tempfile

script = Path(__file__).with_name("assert-no-skipped-ui-tests")
with tempfile.TemporaryDirectory(prefix="talaria-ui-results-") as temporary:
    root = Path(temporary)
    result = root / "result.xcresult"
    result.mkdir()
    fixture = root / "result.json"
    xcrun = root / "xcrun"
    xcrun.write_text('#!/bin/sh\ncat "$CI_RESULT_FIXTURE"\n')
    xcrun.chmod(0o755)
    env = {"PATH": str(root) + os.pathsep + os.environ["PATH"], "HOME": str(root), "CI_RESULT_FIXTURE": str(fixture)}
    prefix = "test://com.apple.xcode/Talaria/TalariaUITests/"
    smoke = {"nodeType": "Test Case", "result": "Passed",
             "nodeIdentifierURL": prefix + "ChatNavigationUITests/testChatSessionOpensFromList()"}
    for nodes, expected in (([smoke], 0), ([], 0), ([{**smoke, "result": "Skipped"}], 1),
                            ([{**smoke, "result": "Skipped", "nodeIdentifierURL": "test://com.apple.xcode/Talaria/TalariaTests/X/test()"}], 0)):
        fixture.write_text(json.dumps({"testNodes": nodes}))
        completed = subprocess.run([str(script), str(result)], env=env, capture_output=True, text=True)
        assert completed.returncode == expected, (nodes, completed.stderr)
    assert subprocess.run([str(script), str(result), "--require-launch-smoke"], env=env, capture_output=True).returncode == 64
print("UI skip checks passed.")
