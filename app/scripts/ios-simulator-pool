#!/bin/zsh
# Shared protocol v1. Keep this portable helper identical across adopting repos.
# Source it for ios_pool_acquire/release, or execute it with a command to lease.

pool_runtime_dir=${IOS_SIMULATOR_POOL_DIR:-/tmp/ios-simulator-pool-$EUID}
pool_lock="$pool_runtime_dir/pool.lock"
lease_dir="$pool_runtime_dir/leases"
lease_file=""
simulator_id=""
simulator_disposable=false
pool_lock_held=false

ios_pool_lock() {
    mkdir -p "$lease_dir"
    for _ in {1..20}; do
        if /usr/bin/shlock -f "$pool_lock" -p $$; then
            pool_lock_held=true
            return
        fi
        sleep 0.05
    done
    print -u2 "The shared iOS simulator pool is being configured. Retry when it finishes."
    return 75
}

ios_pool_release() {
    if [[ -n "$simulator_id" ]]; then
        # Keep a failed shutdown out of circulation: acquisition rejects booted devices.
        xcrun simctl shutdown "$simulator_id" >/dev/null 2>&1 || true
        # Test hosts leak state into the device; the next lease starts clean.
        # Only pool devices are disposable: an explicit ID may name a personal simulator.
        if [[ "$simulator_disposable" == true ]]; then
            if xcrun simctl erase "$simulator_id" >/dev/null 2>&1; then
                rm -f "$lease_dir/$simulator_id.dirty"
            else
                # Quarantine: acquisition must erase the device before reusing it.
                : > "$lease_dir/$simulator_id.dirty"
                print -u2 "Could not erase $simulator_id; it stays out of the pool until an erase succeeds."
            fi
        fi
    fi
    [[ -z "$lease_file" ]] || unlink "$lease_file" 2>/dev/null || true
    simulator_id=""
    simulator_disposable=false
    lease_file=""
    if [[ "$pool_lock_held" == true ]]; then
        unlink "$pool_lock" 2>/dev/null || true
        pool_lock_held=false
    fi
}

ios_pool_acquire() {
    # zsh skips the caller's EXIT trap when errexit fires on a function's status,
    # so a failed acquisition releases the pool lock and any lease it took itself.
    ios_pool_try_acquire && return
    local acquire_status=$?
    ios_pool_release
    return "$acquire_status"
}

ios_pool_try_acquire() {
    ios_pool_lock || return $?
    local devices_json candidates candidate_id candidate_state candidate_disposable candidate_lease candidate
    devices_json=$(xcrun simctl list devices available --json) || return $?
    candidates=$(print -r -- "$devices_json" | /usr/bin/jq -r \
        --arg id "${IOS_SIMULATOR_ID:-}" --arg runtime "${IOS_SIMULATOR_RUNTIME:-}" \
        --arg type "${IOS_SIMULATOR_DEVICE_TYPE:-}" '
        [.devices | to_entries[] |
         select(.key | startswith("com.apple.CoreSimulator.SimRuntime.iOS-")) |
         select($runtime == "" or .key == $runtime) | .value[] |
         # A device type (an iPhone Duo for layout tests) may name a model outside the pool.
         select(if $id != "" then .udid == $id
                elif $type != "" then .deviceTypeIdentifier == $type
                else (.name | test("^iOS Test [1-9][0-9]*$")) end)] |
        sort_by(.name) | .[] | [.udid, .state, (.name | test("^iOS Test [1-9][0-9]*$"))] | @tsv
    ') || return $?
    if [[ -z "$candidates" ]]; then
        print -u2 "No idle compatible iOS pool device is available. Run scripts/setup-ios-test-pool or inspect booted devices."
        return 69
    fi
    for candidate in "${(@f)candidates}"; do
        IFS=$'\t' read -r candidate_id candidate_state candidate_disposable <<< "$candidate"
        # A crashed owner may leave children running. Never reuse its booted device.
        [[ "$candidate_state" == Shutdown ]] || continue
        candidate_lease="$lease_dir/$candidate_id.lock"
        if /usr/bin/shlock -f "$candidate_lease" -p $$; then
            if [[ -e "$lease_dir/$candidate_id.dirty" ]]; then
                if [[ "$candidate_disposable" != true ]]; then
                    # A marker from before the device left the pool: never erase a non-pool device.
                    rm -f "$lease_dir/$candidate_id.dirty"
                elif xcrun simctl erase "$candidate_id" >/dev/null 2>&1; then
                    rm -f "$lease_dir/$candidate_id.dirty"
                else
                    unlink "$candidate_lease" 2>/dev/null || true
                    continue
                fi
            fi
            simulator_id="$candidate_id"
            simulator_disposable="$candidate_disposable"
            lease_file="$candidate_lease"
            break
        fi
    done
    if [[ -z "$simulator_id" ]]; then
        print -u2 "Every matching iOS pool simulator is leased or booted. Retry when another run finishes."
        return 75
    fi
    unlink "$pool_lock"
    pool_lock_held=false
    xcrun simctl bootstatus "$simulator_id" -b >/dev/null
}

if [[ "$ZSH_EVAL_CONTEXT" == toplevel ]]; then
    set -euo pipefail
    (( $# > 0 )) || { print -u2 'Usage: ios-simulator-pool command [args...]'; exit 64; }
    pool_command_pid=""
    cleanup() {
        if [[ -n "$pool_command_pid" ]]; then
            kill -TERM "$pool_command_pid" 2>/dev/null || true
            wait "$pool_command_pid" 2>/dev/null || true
        fi
        ios_pool_release
    }
    trap cleanup EXIT
    trap 'exit 130' INT TERM
    ios_pool_acquire
    # Sourced callers keep their original selector; only child commands get the result.
    export IOS_SIMULATOR_ID="$simulator_id"
    "$@" &
    pool_command_pid=$!
    result=0
    wait "$pool_command_pid" || result=$?
    pool_command_pid=""
    exit "$result"
fi
