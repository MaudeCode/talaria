#!/bin/zsh
# Adds one disposable photo to a booted simulator's library, so UI tests that pick from Photos
# own the photo they pick instead of relying on the simulator's sample library (TAL-633).
# Usage: scripts/seed-simulator-photo <simulator-udid>

set -euo pipefail
(( $# == 1 )) || { print -u2 "Usage: scripts/seed-simulator-photo <simulator-udid>"; exit 64; }

photo=$(mktemp -t talaria-ui-photo).jpg
trap 'rm -f "$photo"' EXIT
# A 64x48 solid-blue JPEG, inline so no image file is committed.
print -rn -- '' | base64 -d > "$photo"
xcrun simctl addmedia "$1" "$photo"
