#!/usr/bin/env python3
"""Synthetic cross-project lease checks; never touches real simulators."""
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import time

root = Path(__file__).resolve().parent
with tempfile.TemporaryDirectory(prefix='ios-pool-check-') as directory:
    work = Path(directory)
    tools = work / 'bin'
    tools.mkdir()
    for project in ('one', 'two'):
        (work / project).mkdir()
        shutil.copy(root / 'ios-simulator-pool', work / project / 'pool')
    fixture = work / 'devices.json'
    devices = [dict(name=f'iOS Test {n}', udid=f'00000000-0000-0000-0000-{n:012}',
                    state='Shutdown', deviceTypeIdentifier='com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro')
               for n in (1, 2)]
    personal = dict(name='Personal iPhone', udid='00000000-0000-0000-0000-000000000099', state='Shutdown',
                    deviceTypeIdentifier='com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro')
    def save():
        fixture.write_text(json.dumps({'devices': {'com.apple.CoreSimulator.SimRuntime.iOS-27-0': devices + [personal]}}))
    save()
    fake = tools / 'xcrun'
    fake.write_text('''#!/bin/zsh
if [[ "$1 $2 $3" == "simctl list devices" ]]; then
    cat "$POOL_FIXTURE"
elif [[ "$1 $2 $3" == "simctl list runtimes" ]]; then
    cat "$POOL_RUNTIMES"
elif [[ "$1 $2" == "simctl delete" ]]; then
    print "$3" >> "$POOL_DELETIONS"
elif [[ "$1 $2" == "simctl create" ]]; then
    print -r -- "$3|$4|$5" >> "$POOL_CREATIONS"
    print 00000000-0000-0000-0000-00000000c0de
elif [[ "$1 $2" == "simctl erase" ]]; then
    print "$3" >> "$POOL_ERASURES"
    [[ ! -e "$POOL_ERASE_FAIL" ]] || exit 1
fi
''')
    fake.chmod(0o755)
    runtimes = work / 'runtimes.json'
    runtimes.write_text(json.dumps({'runtimes': [
        dict(identifier='com.apple.CoreSimulator.SimRuntime.iOS-26-4', buildversion='23E254a'),
        dict(identifier='com.apple.CoreSimulator.SimRuntime.iOS-27-0', buildversion='24A5408d')]}))
    env = dict(os.environ, PATH=f'{tools}:{os.environ["PATH"]}',
               IOS_SIMULATOR_POOL_DIR=str(work / 'leases'), POOL_FIXTURE=str(fixture),
               POOL_RUNTIMES=str(runtimes),
               POOL_DELETIONS=str(work / 'deletions'), POOL_CREATIONS=str(work / 'creations'), POOL_ERASURES=str(work / 'erasures'),
               POOL_ERASE_FAIL=str(work / 'erase-fail'))
    for key in ('IOS_SIMULATOR_ID', 'IOS_SIMULATOR_RUNTIME', 'IOS_SIMULATOR_DEVICE_TYPE'):
        env.pop(key, None)
    processes = []
    def invoke(project='two', expected=0, **overrides):
        result = subprocess.run([str(work / project / 'pool'), '/bin/zsh', '-c',
                                 'print -r -- "$IOS_SIMULATOR_ID"'], env=dict(env, **overrides),
                                capture_output=True, text=True, timeout=10)
        assert result.returncode == expected, (result.returncode, result.stdout, result.stderr)
        return result.stdout.strip()
    def erasures():
        path = work / 'erasures'
        return path.read_text().split() if path.exists() else []
    def owner():
        ready = work / 'ready'
        ready.unlink(missing_ok=True)
        command = 'import os,time,pathlib; pathlib.Path(os.environ["READY"]).write_text(str(os.getpid())); time.sleep(30)'
        process = subprocess.Popen([str(work / 'one' / 'pool'), sys.executable, '-c', command],
                                   env=dict(env, READY=str(ready)), stdout=subprocess.DEVNULL,
                                   stderr=subprocess.PIPE)
        processes.append(process)
        for _ in range(200):
            if ready.exists():
                return process, int(ready.read_text())
            assert process.poll() is None, process.stderr.read().decode()
            time.sleep(.02)
        raise AssertionError('lease owner did not start')
    def select(expected=0, **overrides):
        result = subprocess.run([str(root / 'select-ios-simulator')], env=dict(env, **overrides),
                                capture_output=True, text=True, timeout=10)
        assert result.returncode == expected, (result.returncode, result.stdout, result.stderr)
        return result.stdout.strip().split('\t') if expected == 0 else result.stderr.strip()
    def selector_fixture(released, beta):
        fixture.write_text(json.dumps({'devices': {
            'com.apple.CoreSimulator.SimRuntime.iOS-26-4': [released],
            'com.apple.CoreSimulator.SimRuntime.iOS-27-0': [beta]}}))
    try:
        # Selection ignores prerelease runtimes unless one is requested explicitly.
        released = dict(personal, udid='00000000-0000-0000-0000-000000000264')
        beta = dict(personal, udid='00000000-0000-0000-0000-000000000270')
        selector_fixture(released, beta)
        assert select() == [released['udid'], 'com.apple.CoreSimulator.SimRuntime.iOS-26-4',
                            personal['deviceTypeIdentifier']]
        assert select(IOS_SIMULATOR_RUNTIME='com.apple.CoreSimulator.SimRuntime.iOS-27-0')[0] == beta['udid']
        ipad = dict(released, deviceTypeIdentifier='com.apple.CoreSimulator.SimDeviceType.iPad-Pro-11-inch-M4')
        selector_fixture(ipad, beta)
        assert select(expected=69) == 'No available iPhone simulator was found.'
        assert not (work / 'creations').exists()
        # A fresh hosted image may have no matching device: create one on the newest released runtime,
        # newest supported iPhone first unless a device type is requested.
        phone = lambda name: dict(identifier='com.apple.CoreSimulator.SimDeviceType.' + name.replace(' ', '-'),
                                  name=name, productFamily='iPhone')
        catalog = [phone('iPhone 18 Pro'), phone('iPhone 17'),
                   dict(identifier='com.apple.CoreSimulator.SimDeviceType.iPad-Air', name='iPad Air', productFamily='iPad')]
        runtimes.write_text(json.dumps({'runtimes': [
            dict(identifier='com.apple.CoreSimulator.SimRuntime.iOS-26-4', buildversion='23E254a', supportedDeviceTypes=catalog),
            dict(identifier='com.apple.CoreSimulator.SimRuntime.iOS-27-0', buildversion='24A5408d', supportedDeviceTypes=catalog),
            dict(identifier='com.apple.CoreSimulator.SimRuntime.iOS-26-5', buildversion='23F77', isAvailable=False,
                 supportedDeviceTypes=catalog)]}))
        created = '00000000-0000-0000-0000-00000000c0de'
        assert select() == [created, 'com.apple.CoreSimulator.SimRuntime.iOS-26-4', catalog[0]['identifier']]
        # An existing phone of another model does not satisfy a requested device type.
        selector_fixture(released, beta)
        assert select(IOS_SIMULATOR_DEVICE_TYPE=catalog[1]['identifier'],
                      IOS_SIMULATOR_RUNTIME='com.apple.CoreSimulator.SimRuntime.iOS-27-0') == [
            created, 'com.apple.CoreSimulator.SimRuntime.iOS-27-0', catalog[1]['identifier']]
        assert select(IOS_SIMULATOR_DEVICE_TYPE=personal['deviceTypeIdentifier'])[0] == released['udid']
        assert (work / 'creations').read_text().splitlines() == [
            'iPhone 18 Pro|com.apple.CoreSimulator.SimDeviceType.iPhone-18-Pro|com.apple.CoreSimulator.SimRuntime.iOS-26-4',
            'iPhone 17|com.apple.CoreSimulator.SimDeviceType.iPhone-17|com.apple.CoreSimulator.SimRuntime.iOS-27-0']
        # An unavailable or unsupported target still fails clearly instead of creating anything.
        assert select(expected=69, IOS_SIMULATOR_DEVICE_TYPE='com.apple.CoreSimulator.SimDeviceType.iPad-Air') \
            == 'No available iPhone simulator was found.'
        assert select(expected=69, IOS_SIMULATOR_RUNTIME='com.apple.CoreSimulator.SimRuntime.iOS-26-5') \
            == 'No available iPhone simulator was found.'
        save()
        first, child = owner()
        assert invoke() == devices[1]['udid']  # Independent checkout chooses another slot.
        assert erasures() == [devices[1]['udid']]  # Release wipes the device it leased.
        invoke(expected=75, IOS_SIMULATOR_ID=devices[0]['udid'])
        assert erasures() == [devices[1]['udid']]  # A failed acquisition erases nothing.
        assert invoke(IOS_SIMULATOR_ID=personal['udid']) == personal['udid']
        assert erasures() == [devices[1]['udid']]  # An explicitly selected non-pool device is never erased.
        assert invoke(IOS_SIMULATOR_ID=devices[1]['udid']) == devices[1]['udid']
        invoke(expected=69, IOS_SIMULATOR_ID='missing')
        invoke(expected=69, IOS_SIMULATOR_RUNTIME='com.apple.CoreSimulator.SimRuntime.iOS-18-0')
        # Setup shares leases and cannot refresh beneath an active consumer.
        result = subprocess.run([str(root / 'setup-ios-test-pool'), '--refresh'], env=env,
                                capture_output=True, timeout=10)
        assert result.returncode == 75, result.stderr
        assert not (work / 'deletions').exists()
        # Booted devices are never reused, even with a stale or absent owner lock.
        devices[1]['state'] = 'Booted'
        save()
        invoke(expected=75)
        first.terminate()
        assert first.wait(timeout=10) == 130
        assert invoke() == devices[0]['udid']
        result = subprocess.run([str(root / 'setup-ios-test-pool'), '--refresh'], env=env,
                                capture_output=True, timeout=10)
        assert result.returncode == 75, result.stderr
        assert not (work / 'deletions').exists()
        crashed, orphan = owner()
        devices[0]['state'] = 'Booted'
        save()
        crashed.kill()
        crashed.wait(timeout=10)
        invoke(expected=75)  # A surviving test process must not lose its simulator.
        os.kill(orphan, signal.SIGTERM)
        devices[0]['state'] = devices[1]['state'] = 'Shutdown'
        save()
        assert invoke() == devices[0]['udid']  # shlock recovers the dead PID.
        result = subprocess.run([str(work / 'two' / 'pool'), '/bin/zsh', '-c', 'exit 42'], env=env)
        assert result.returncode == 42
        assert invoke() == devices[0]['udid']
        # A device whose erase fails is quarantined until an erase succeeds.
        dirty = work / 'leases' / 'leases' / (devices[0]['udid'] + '.dirty')
        (work / 'erase-fail').touch()
        assert invoke() == devices[0]['udid']
        assert dirty.exists()
        assert invoke() == devices[1]['udid']  # Acquisition retried the erase, failed, and skipped it.
        (work / 'erase-fail').unlink()
        assert invoke() == devices[0]['udid']  # A successful erase on acquire clears the quarantine.
        assert not dirty.exists()
        # A marker left by a device that has since left the pool is dropped, never erased.
        stale = work / 'leases' / 'leases' / (personal['udid'] + '.dirty')
        stale.touch()
        before = erasures()
        assert invoke(IOS_SIMULATOR_ID=personal['udid']) == personal['udid']
        assert erasures() == before
        assert not stale.exists()
        # Automatic reacquisition may move slots; explicit selection must stay pinned.
        for explicit in (False, True):
            repeated_env = dict(env, POOL_HELPER=str(work / 'one' / 'pool'))
            if explicit:
                repeated_env['IOS_SIMULATOR_ID'] = devices[0]['udid']
            repeated = subprocess.Popen(
                ['/bin/zsh', '-c', 'set -euo pipefail; source "$POOL_HELPER"; '
                 'trap ios_pool_release EXIT; ios_pool_acquire; ios_pool_release; '
                 'print ready; read -r proceed; ios_pool_acquire; print -r -- "$simulator_id"'],
                env=repeated_env, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                stderr=subprocess.PIPE, text=True)
            processes.append(repeated)
            assert repeated.stdout.readline().strip() == 'ready'
            blocker, child = owner()
            output, error = repeated.communicate('continue\n', timeout=10)
            assert repeated.returncode == (75 if explicit else 0), (repeated.returncode, output, error)
            if not explicit:
                assert output.strip() == devices[1]['udid']
            lease = work / 'leases' / 'leases' / (devices[0]['udid'] + '.lock')
            assert lease.read_text().strip() == str(blocker.pid)
            assert blocker.poll() is None
            blocker.terminate()
            assert blocker.wait(timeout=10) == 130
    finally:
        for process in processes:
            if process.poll() is None:
                process.terminate()
                process.wait(timeout=10)
print('Shared pool checks passed: released-runtime selection, creation on fresh images, independent callers, explicit IDs, exhaustion, runtime, refresh, erase on release, cancellation, crash, repeated acquire/release and exit status.')
