#!/usr/bin/env python3
"""Synthetic cross-project lease checks; never touches real simulators."""
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import time

root = Path(__file__).resolve().parent
with tempfile.TemporaryDirectory(prefix='ios-pool-check-') as directory:
    work = Path(directory)
    tools = work / 'bin'
    tools.mkdir()
    for project in ('one', 'two'):
        (work / project).mkdir()
        shutil.copy(root / 'ios-simulator-pool', work / project / 'pool')
    fixture = work / 'devices.json'
    devices = [dict(name=f'iOS Test {n}', udid=f'00000000-0000-0000-0000-{n:012}',
                    state='Shutdown', deviceTypeIdentifier='com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro')
               for n in (1, 2)]
    personal = dict(name='Personal iPhone', udid='00000000-0000-0000-0000-000000000099', state='Shutdown',
                    deviceTypeIdentifier='com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro')
    duo = dict(personal, name='iPhone Duo', udid='00000000-0000-0000-0000-0000000000d0',
               deviceTypeIdentifier='com.apple.CoreSimulator.SimDeviceType.iPhone-Duo')
    bystanders = []
    def save():
        fixture.write_text(json.dumps({'devices': {'com.apple.CoreSimulator.SimRuntime.iOS-27-0':
                                                   devices + [personal, duo] + bystanders}}))
    def sync():  # The fake shutdown edits the fixture; carry its states back before the next save.
        states = {d['udid']: d['state'] for runtime in json.loads(fixture.read_text())['devices'].values() for d in runtime}
        for device in devices + [personal, duo] + bystanders:
            device['state'] = states[device['udid']]
    save()
    fake = tools / 'xcrun'
    fake.write_text('''#!/usr/bin/env bash
if [[ "$1 $2 $3" == "simctl list devices" ]]; then
    cat "$POOL_FIXTURE"
elif [[ "$1 $2 $3" == "simctl list runtimes" ]]; then
    cat "$POOL_RUNTIMES"
elif [[ "$1 $2" == "simctl delete" ]]; then
    echo "$3" >> "$POOL_DELETIONS"
elif [[ "$1 $2" == "simctl create" ]]; then
    echo "$3|$4|$5" >> "$POOL_CREATIONS"
    echo 00000000-0000-0000-0000-00000000c0de
elif [[ "$1 $2" == "simctl bootstatus" ]]; then
    [[ ! -e "$POOL_BOOT_FAIL" ]] || exit 1
elif [[ "$1 $2" == "simctl shutdown" ]]; then
    echo "$3" >> "$POOL_SHUTDOWNS"
    /usr/bin/jq --arg id "$3" '(.devices[][] | select(.udid == $id) | .state) = "Shutdown"' "$POOL_FIXTURE" \
        > "$POOL_FIXTURE.new" && mv "$POOL_FIXTURE.new" "$POOL_FIXTURE"
elif [[ "$1 $2" == "simctl erase" ]]; then
    echo "$3" >> "$POOL_ERASURES"
    [[ ! -e "$POOL_ERASE_FAIL" ]] || exit 1
fi
''')
    fake.chmod(0o755)
    runtimes = work / 'runtimes.json'
    runtimes.write_text(json.dumps({'runtimes': [
        dict(identifier='com.apple.CoreSimulator.SimRuntime.iOS-26-4', buildversion='23E254a'),
        dict(identifier='com.apple.CoreSimulator.SimRuntime.iOS-27-0', buildversion='24A5408d')]}))
    env = dict(os.environ, PATH=f'{tools}:{os.environ["PATH"]}',
               IOS_SIMULATOR_POOL_DIR=str(work / 'leases'), POOL_FIXTURE=str(fixture),
               POOL_RUNTIMES=str(runtimes),
               POOL_DELETIONS=str(work / 'deletions'), POOL_CREATIONS=str(work / 'creations'), POOL_ERASURES=str(work / 'erasures'),
               POOL_SHUTDOWNS=str(work / 'shutdowns'),
               POOL_ERASE_FAIL=str(work / 'erase-fail'), POOL_BOOT_FAIL=str(work / 'boot-fail'))
    for key in ('IOS_SIMULATOR_ID', 'IOS_SIMULATOR_RUNTIME', 'IOS_SIMULATOR_DEVICE_TYPE'):
        env.pop(key, None)
    processes = []
    def acquire(project='two', expected=0, **overrides):
        result = subprocess.run([str(work / project / 'pool'), 'bash', '-c',
                                 'echo "$IOS_SIMULATOR_ID"'], env=dict(env, **overrides),
                                capture_output=True, text=True, timeout=10)
        assert result.returncode == expected, (result.returncode, result.stdout, result.stderr)
        return result
    def invoke(project='two', expected=0, **overrides):
        return acquire(project, expected, **overrides).stdout.strip()
    def erasures():
        path = work / 'erasures'
        return path.read_text().split() if path.exists() else []
    def shutdowns():
        path = work / 'shutdowns'
        return path.read_text().split() if path.exists() else []
    def owner(new_group=False, **overrides):
        ready = work / 'ready'
        ready.unlink(missing_ok=True)
        command = 'import os,time,pathlib; pathlib.Path(os.environ["READY"]).write_text(str(os.getpid())); time.sleep(30)'
        process = subprocess.Popen([str(work / 'one' / 'pool'), sys.executable, '-c', command],
                                   env=dict(env, READY=str(ready), **overrides), stdout=subprocess.DEVNULL,
                                   stderr=subprocess.PIPE, start_new_session=new_group)
        processes.append(process)
        wait_for(lambda: ready.exists() or process.poll() is not None, 'lease owner did not start')
        assert process.poll() is None, process.stderr.read().decode()
        return process, int(ready.read_text())
    def wait_for(check, failure):
        for _ in range(200):
            if check():
                return
            time.sleep(.02)
        raise AssertionError(failure)
    def select(expected=0, **overrides):
        result = subprocess.run([str(root / 'select-ios-simulator')], env=dict(env, **overrides),
                                capture_output=True, text=True, timeout=10)
        assert result.returncode == expected, (result.returncode, result.stdout, result.stderr)
        return result.stdout.strip().split('\t') if expected == 0 else result.stderr.strip()
    def selector_fixture(released, beta):
        fixture.write_text(json.dumps({'devices': {
            'com.apple.CoreSimulator.SimRuntime.iOS-26-4': [released],
            'com.apple.CoreSimulator.SimRuntime.iOS-27-0': [beta]}}))
    try:
        # Selection ignores prerelease runtimes unless one is requested explicitly.
        released = dict(personal, udid='00000000-0000-0000-0000-000000000264')
        beta = dict(personal, udid='00000000-0000-0000-0000-000000000270')
        selector_fixture(released, beta)
        assert select() == [released['udid'], 'com.apple.CoreSimulator.SimRuntime.iOS-26-4',
                            personal['deviceTypeIdentifier']]
        assert select(IOS_SIMULATOR_RUNTIME='com.apple.CoreSimulator.SimRuntime.iOS-27-0')[0] == beta['udid']
        # Only seeds end in a letter after their high build number; a released point update for new hardware keeps
        # the high number without it (iOS 27.1 is 24A94401) and is selected as the newest released runtime.
        released_runtimes = runtimes.read_text()
        point = dict(personal, udid='00000000-0000-0000-0000-000000000271')
        runtimes.write_text(json.dumps({'runtimes': json.loads(released_runtimes)['runtimes'] + [
            dict(identifier='com.apple.CoreSimulator.SimRuntime.iOS-27-1', buildversion='24A94401')]}))
        fixture.write_text(json.dumps({'devices': {
            'com.apple.CoreSimulator.SimRuntime.iOS-26-4': [released],
            'com.apple.CoreSimulator.SimRuntime.iOS-27-0': [beta],
            'com.apple.CoreSimulator.SimRuntime.iOS-27-1': [point]}}))
        assert select()[0] == point['udid']
        # Xcode can install a hardware-specific seed beside the released runtime of the same version.
        stable_runtime = 'com.apple.CoreSimulator.SimRuntime.iOS-27-2'
        hardware_runtime = stable_runtime + '-iPhone19-4'
        stable = dict(personal, udid='00000000-0000-0000-0000-000000000272')
        hardware = dict(personal, udid='00000000-0000-0000-0000-000000001904')
        runtimes.write_text(json.dumps({'runtimes': [
            dict(identifier=stable_runtime, buildversion='24B8117'),
            dict(identifier=hardware_runtime, buildversion='24B91016s')]}))
        fixture.write_text(json.dumps({'devices': {stable_runtime: [stable], hardware_runtime: [hardware]}}))
        assert select() == [stable['udid'], stable_runtime, personal['deviceTypeIdentifier']]
        assert select(IOS_SIMULATOR_RUNTIME=hardware_runtime) == [
            hardware['udid'], hardware_runtime, personal['deviceTypeIdentifier']]
        runtimes.write_text(released_runtimes)
        ipad = dict(released, deviceTypeIdentifier='com.apple.CoreSimulator.SimDeviceType.iPad-Pro-11-inch-M4')
        selector_fixture(ipad, beta)
        assert select(expected=69) == 'No available iPhone simulator was found.'
        assert not (work / 'creations').exists()
        # A fresh hosted image may have no matching device: create one on the newest released runtime,
        # newest supported iPhone first unless a device type is requested.
        phone = lambda name: dict(identifier='com.apple.CoreSimulator.SimDeviceType.' + name.replace(' ', '-'),
                                  name=name, productFamily='iPhone')
        catalog = [phone('iPhone 18 Pro'), phone('iPhone 17'),
                   dict(identifier='com.apple.CoreSimulator.SimDeviceType.iPad-Air', name='iPad Air', productFamily='iPad')]
        runtimes.write_text(json.dumps({'runtimes': [
            dict(identifier='com.apple.CoreSimulator.SimRuntime.iOS-26-4', buildversion='23E254a', supportedDeviceTypes=catalog),
            dict(identifier='com.apple.CoreSimulator.SimRuntime.iOS-27-0', buildversion='24A5408d', supportedDeviceTypes=catalog),
            dict(identifier='com.apple.CoreSimulator.SimRuntime.iOS-26-5', buildversion='23F77', isAvailable=False,
                 supportedDeviceTypes=catalog)]}))
        created = '00000000-0000-0000-0000-00000000c0de'
        assert select() == [created, 'com.apple.CoreSimulator.SimRuntime.iOS-26-4', catalog[0]['identifier']]
        # An existing phone of another model does not satisfy a requested device type.
        selector_fixture(released, beta)
        assert select(IOS_SIMULATOR_DEVICE_TYPE=catalog[1]['identifier'],
                      IOS_SIMULATOR_RUNTIME='com.apple.CoreSimulator.SimRuntime.iOS-27-0') == [
            created, 'com.apple.CoreSimulator.SimRuntime.iOS-27-0', catalog[1]['identifier']]
        assert select(IOS_SIMULATOR_DEVICE_TYPE=personal['deviceTypeIdentifier'])[0] == released['udid']
        assert (work / 'creations').read_text().splitlines() == [
            'iPhone 18 Pro|com.apple.CoreSimulator.SimDeviceType.iPhone-18-Pro|com.apple.CoreSimulator.SimRuntime.iOS-26-4',
            'iPhone 17|com.apple.CoreSimulator.SimDeviceType.iPhone-17|com.apple.CoreSimulator.SimRuntime.iOS-27-0']
        # An unavailable or unsupported target still fails clearly instead of creating anything.
        assert select(expected=69, IOS_SIMULATOR_DEVICE_TYPE='com.apple.CoreSimulator.SimDeviceType.iPad-Air') \
            == 'No available iPhone simulator was found.'
        assert select(expected=69, IOS_SIMULATOR_RUNTIME='com.apple.CoreSimulator.SimRuntime.iOS-26-5') \
            == 'No available iPhone simulator was found.'
        # The fresh-device path uses the same ordering and seed exclusion as existing-device selection.
        runtimes.write_text(json.dumps({'runtimes': [
            dict(identifier=stable_runtime, buildversion='24B8117', supportedDeviceTypes=catalog),
            dict(identifier=hardware_runtime, buildversion='24B91016s', supportedDeviceTypes=catalog)]}))
        fixture.write_text(json.dumps({'devices': {}}))
        assert select() == [created, stable_runtime, catalog[0]['identifier']]
        assert select(IOS_SIMULATOR_RUNTIME=hardware_runtime) == [created, hardware_runtime, catalog[0]['identifier']]
        save()
        first, child = owner()
        assert invoke() == devices[1]['udid']  # Independent checkout chooses another slot.
        assert erasures() == [devices[1]['udid']]  # Release wipes the device it leased.
        invoke(expected=75, IOS_SIMULATOR_ID=devices[0]['udid'])
        assert erasures() == [devices[1]['udid']]  # A failed acquisition erases nothing.
        assert not (work / 'leases' / 'pool.lock').exists()  # nor holds the pool against the next caller.
        assert invoke(IOS_SIMULATOR_ID=personal['udid']) == personal['udid']
        assert erasures() == [devices[1]['udid']]  # An explicitly selected non-pool device is never erased.
        # A device type leases any available simulator of that model, such as an iPhone Duo for layout tests,
        # and never erases a non-pool device either.
        assert invoke(IOS_SIMULATOR_DEVICE_TYPE=duo['deviceTypeIdentifier']) == duo['udid']
        assert erasures() == [devices[1]['udid']]
        invoke(expected=69, IOS_SIMULATOR_DEVICE_TYPE='com.apple.CoreSimulator.SimDeviceType.iPad-Air')
        assert invoke(IOS_SIMULATOR_ID=devices[1]['udid']) == devices[1]['udid']
        invoke(expected=69, IOS_SIMULATOR_ID='missing')
        invoke(expected=69, IOS_SIMULATOR_RUNTIME='com.apple.CoreSimulator.SimRuntime.iOS-18-0')
        # Setup shares leases and cannot refresh beneath an active consumer.
        result = subprocess.run([str(root / 'setup-ios-test-pool'), '--refresh'], env=env,
                                capture_output=True, timeout=10)
        assert result.returncode == 75, result.stderr
        assert not (work / 'deletions').exists()
        # A booted device without a lease, or under a live owner, is never reused.
        devices[1]['state'] = 'Booted'
        save()
        invoke(expected=75)
        first.terminate()
        assert first.wait(timeout=10) == 130
        assert invoke() == devices[0]['udid']
        result = subprocess.run([str(root / 'setup-ios-test-pool'), '--refresh'], env=env,
                                capture_output=True, timeout=10)
        assert result.returncode == 75, result.stderr
        assert not (work / 'deletions').exists()
        crashed, orphan = owner()
        devices[0]['state'] = 'Booted'
        save()
        crashed.kill()
        crashed.wait(timeout=10)
        invoke(expected=75)  # A surviving test process must not lose its simulator.
        os.kill(orphan, signal.SIGTERM)
        devices[0]['state'] = devices[1]['state'] = 'Shutdown'
        save()
        time.sleep(1.1)  # macOS shlock reclaims a dead owner's lock only once it is a second old.
        assert invoke() == devices[0]['udid']  # shlock recovers the dead PID.
        result = subprocess.run([str(work / 'two' / 'pool'), 'bash', '-c', 'exit 42'], env=env)
        assert result.returncode == 42
        assert invoke() == devices[0]['udid']
        # A harness timeout SIGKILLs a run's whole process group: no EXIT trap releases its booted device.
        # The next acquisition, for any selection, reclaims it once nothing in that group survives.
        leases = work / 'leases' / 'leases'
        def killed(**overrides):
            process, _ = owner(new_group=True, **overrides)
            os.killpg(process.pid, signal.SIGKILL)
            process.wait(timeout=10)
            wait_for(lambda: subprocess.run(['pgrep', '-g', str(process.pid)]).returncode == 1,
                     'killed process group did not exit')
            return process.pid
        bystanders.extend(dict(personal, name=name, udid=f'00000000-0000-0000-0000-0000000000b{n}')
                          for n, name in enumerate(('Hand-booted', 'Live lease', 'Old-script lease', 'Taken-over lease')))
        save()
        manual, live, legacy, taken = bystanders
        live_owner, _ = owner(IOS_SIMULATOR_ID=live['udid'])
        gone = subprocess.Popen(['true'])
        gone.wait()
        for old in (legacy, taken):  # An older copy writes no .pgid,
            (leases / (old['udid'] + '.lock')).write_text(f'{gone.pid}\n')
        stale_group = leases / (taken['udid'] + '.pgid')  # so one beside its lease is an earlier owner's.
        stale_group.write_text(f'{gone.pid}\n')
        os.utime(stale_group, (time.time() - 60,) * 2)
        dead = killed()
        for device in [devices[0]] + bystanders:
            device['state'] = 'Booted'
        save()
        time.sleep(1.1)  # macOS shlock reclaims a dead owner's lock only once it is a second old.
        before_erasures, before_shutdowns = erasures(), shutdowns()
        result = acquire(IOS_SIMULATOR_ID=personal['udid'])
        assert result.stdout.strip() == personal['udid']
        assert devices[0]['udid'] in result.stderr and str(dead) in result.stderr, result.stderr
        assert shutdowns()[len(before_shutdowns):] == [devices[0]['udid'], personal['udid']]
        assert erasures() == before_erasures + [devices[0]['udid']]
        assert not (leases / (devices[0]['udid'] + '.lock')).exists()
        assert not (leases / (devices[0]['udid'] + '.pgid')).exists()
        sync()
        assert [device['state'] for device in bystanders] == ['Booted'] * 4
        assert not set(shutdowns()) & {device['udid'] for device in bystanders}
        assert (leases / (live['udid'] + '.lock')).read_text().strip() == str(live_owner.pid)
        for old in (legacy, taken):
            assert (leases / (old['udid'] + '.lock')).read_text().strip() == str(gone.pid)
        assert not (leases / (manual['udid'] + '.lock')).exists()
        live_owner.terminate()
        assert live_owner.wait(timeout=10) == 130
        for path in ('.lock', '.pgid'):
            for old in (legacy, taken):
                (leases / (old['udid'] + path)).unlink(missing_ok=True)
        bystanders.clear()
        save()
        # A reclaimed non-pool device is shut down but never erased, and the selection that reclaimed it may lease it.
        dead = killed(IOS_SIMULATOR_DEVICE_TYPE=duo['deviceTypeIdentifier'])
        duo['state'] = 'Booted'
        save()
        time.sleep(1.1)
        before_erasures = erasures()
        assert invoke(IOS_SIMULATOR_DEVICE_TYPE=duo['deviceTypeIdentifier']) == duo['udid']
        assert erasures() == before_erasures
        sync()
        assert duo['state'] == 'Shutdown'
        # A device whose erase fails is quarantined until an erase succeeds.
        dirty = work / 'leases' / 'leases' / (devices[0]['udid'] + '.dirty')
        (work / 'erase-fail').touch()
        assert invoke() == devices[0]['udid']
        assert dirty.exists()
        assert invoke() == devices[1]['udid']  # Acquisition retried the erase, failed, and skipped it.
        (work / 'erase-fail').unlink()
        assert invoke() == devices[0]['udid']  # A successful erase on acquire clears the quarantine.
        assert not dirty.exists()
        # A marker left by a device that has since left the pool is dropped, never erased.
        stale = work / 'leases' / 'leases' / (personal['udid'] + '.dirty')
        stale.touch()
        before = erasures()
        assert invoke(IOS_SIMULATOR_ID=personal['udid']) == personal['udid']
        assert erasures() == before
        assert not stale.exists()
        # Automatic reacquisition may move slots; explicit selection must stay pinned.
        for explicit in (False, True):
            repeated_env = dict(env, POOL_HELPER=str(work / 'one' / 'pool'))
            if explicit:
                repeated_env['IOS_SIMULATOR_ID'] = devices[0]['udid']
            repeated = subprocess.Popen(
                ['bash', '-c', 'set -euo pipefail; source "$POOL_HELPER"; '
                 'trap ios_pool_release EXIT; ios_pool_acquire; ios_pool_release; '
                 'echo ready; read -r proceed; ios_pool_acquire; echo "$simulator_id"'],
                env=repeated_env, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                stderr=subprocess.PIPE, text=True)
            processes.append(repeated)
            assert repeated.stdout.readline().strip() == 'ready'
            blocker, child = owner()
            output, error = repeated.communicate('continue\n', timeout=10)
            assert repeated.returncode == (75 if explicit else 0), (repeated.returncode, output, error)
            if not explicit:
                assert output.strip() == devices[1]['udid']
            lease = work / 'leases' / 'leases' / (devices[0]['udid'] + '.lock')
            assert lease.read_text().strip() == str(blocker.pid)
            assert blocker.poll() is None
            blocker.terminate()
            assert blocker.wait(timeout=10) == 130
        # A failing or malformed simctl report runs nothing, erases nothing and leaves the pool usable.
        before = erasures()
        for report in ('{"devices": {', None):
            if report is None:
                fixture.unlink()
            else:
                fixture.write_text(report)
            result = subprocess.run([str(work / 'two' / 'pool'), 'bash', '-c', 'echo ran'], env=env,
                                    capture_output=True, text=True, timeout=10)
            assert result.returncode != 0 and result.stdout == '', (report, result)
            assert erasures() == before
            assert not list((work / 'leases' / 'leases').glob('*.lock')), report
            assert not (work / 'leases' / 'pool.lock').exists(), report
        save()
        # A lease whose boot fails is shut down, erased and returned before the command could run.
        (work / 'boot-fail').touch()
        before = erasures()
        result = subprocess.run([str(work / 'two' / 'pool'), 'bash', '-c', 'echo ran'], env=env,
                                capture_output=True, text=True, timeout=10)
        assert result.returncode != 0 and result.stdout == '', result
        assert erasures() == before + [devices[0]['udid']]
        assert not list((work / 'leases' / 'leases').glob('*.lock'))
        assert not (work / 'leases' / 'pool.lock').exists()
        (work / 'boot-fail').unlink()
        assert invoke() == devices[0]['udid']
    finally:
        for process in processes:
            if process.poll() is None:
                process.terminate()
                process.wait(timeout=10)
print('Shared pool checks passed: released-runtime selection, creation on fresh images, independent callers, explicit IDs, exhaustion, runtime, refresh, erase on release, cancellation, crash, repeated acquire/release, exit status, stale-lease reclamation after a killed process group, and cleanup after failed, malformed or '
      'unbootable acquisitions.')
