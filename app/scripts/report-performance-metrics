#!/usr/bin/env python3
"""Summarize an xcresult's performance metrics into performance-metrics.json/.txt and the job summary."""

import json
import os
from pathlib import Path
import subprocess
import sys


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: report-performance-metrics RESULT_BUNDLE")
    bundle = Path(sys.argv[1])
    if not bundle.is_dir():
        print("No result bundle is available; skipping performance reporting.")
        return
    raw = subprocess.check_output(["xcrun", "xcresulttool", "get", "test-results", "metrics", "--path", str(bundle), "--compact"])
    Path("performance-metrics.json").write_bytes(raw)
    lines = []
    tests = json.loads(raw)
    if not tests:
        lines.append("No performance metrics were recorded.")
    for test in sorted(tests, key=lambda test: test["testIdentifier"]):
        lines.append(test["testIdentifier"])
        for run in test.get("testRuns", []):
            for metric in run.get("metrics", []):
                measurements = metric.get("measurements") or []
                if not measurements:
                    continue
                ordered = sorted(measurements)
                median = ordered[len(ordered) // 2]
                spread = ordered[-1] - ordered[0]
                lines.append(
                    f"    {metric['displayName']:<40}"
                    f" median {median:>16.3f} {metric['unitOfMeasurement']}"
                    f"  (n={len(measurements)}, spread {spread:.3f})"
                )
    text = "\n".join(lines) + "\n"
    Path("performance-metrics.txt").write_text(text)
    print(text, end="")
    summary = os.environ.get("GITHUB_STEP_SUMMARY")
    if summary:
        with open(summary, "a") as stream:
            stream.write(f"\n#### Performance metrics\n```text\n{text}```\n")


if __name__ == "__main__":
    main()
