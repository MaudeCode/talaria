#!/bin/zsh
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
candidate_ref=""
run_swift_tests=1
responses_output=""

usage() {
  echo "usage: scripts/validate-upstream-contract [--ref MONOREPO_COMMIT_OR_TAG] [--server-only] [--responses-output FILE] [--print-interpreters]"
}

while (( $# )); do
  case "$1" in
    --ref)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      candidate_ref="$2"
      shift 2
      ;;
    --server-only)
      run_swift_tests=0
      shift
      ;;
    --responses-output)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      responses_output="$2"
      shift 2
      ;;
    --print-interpreters)
      print_interpreters=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

# Interpreters for the disposable server, which runs under `env -i` with a throwaway HOME.
# Ask each interpreter for its own path: version-manager shims (e.g. mise) on PATH only
# work under the caller's HOME, so the server must get the real binaries.
node_bin="$(node -p process.execPath)"
python_bin="$(python3 -c 'import sys; print(sys.executable)')"
if (( ${print_interpreters:-0} )); then
  print -r -- "$node_bin" "$python_bin"
  exit 0
fi

monorepo_root="$(cd "$repo_root/.." && pwd)"
run_stamp="$(date -u +%Y%m%dT%H%M%SZ)-$$"
run_dir="$repo_root/.codex-tmp/upstream-contract/$run_stamp"
upstream_dir="$monorepo_root/web"
workspace_dir="$run_dir/workspace"
hermes_home="$run_dir/hermes-home"
state_dir="$run_dir/state"
responses_file="$run_dir/live-responses.json"
mkdir -p "$workspace_dir" "$hermes_home" "$state_dir"
printf 'talaria contract fixture\n' > "$workspace_dir/contract-fixture.txt"

server_pid=""
finish() {
  local exit_code=$?
  trap - EXIT INT TERM
  if [[ -n "$server_pid" ]]; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
  # CI keeps no run directory, so a failure must carry the disposable server's own account.
  if (( exit_code != 0 )) && [[ -s "$run_dir/server.log" ]]; then
    echo "Disposable server log (last 80 lines):" >&2
    tail -n 80 "$run_dir/server.log" >&2
  fi
  echo "Contract artifacts: $run_dir"
  exit "$exit_code"
}
trap finish EXIT INT TERM

candidate_sha="$(git -C "$monorepo_root" rev-parse --verify --end-of-options "${candidate_ref:-HEAD}^{commit}")"
if [[ -n "$candidate_ref" ]]; then
  upstream_dir="$run_dir/web"
  mkdir -p "$upstream_dir"
  git -C "$monorepo_root" archive "${candidate_sha}:web" | tar -x -C "$upstream_dir"
fi
[[ -f "$upstream_dir/package.json" ]] || { echo "Missing checked-out web/package.json" >&2; exit 1; }
printf '%s\n' "$candidate_sha" > "$run_dir/candidate-sha.txt"
{
  printf 'Monorepo commit: %s\nWeb tree: %s\n' "$candidate_sha" "$upstream_dir"
  if [[ -z "$candidate_ref" ]]; then
    git -C "$monorepo_root" status --short -- web
  fi
} > "$run_dir/source-identity.log"

echo "Preparing the Node server (contracts + server workspaces)"
if [[ -n "$candidate_ref" || ! -f "$upstream_dir/packages/server/dist/bin/talaria-web.js" ]]; then
  (
    cd "$upstream_dir"
    npm ci --no-audit --no-fund --workspace packages/contracts --workspace packages/server --include=dev
    npm run build --workspace packages/contracts
    npm run build --workspace packages/server
  ) >"$run_dir/setup.log" 2>&1 || {
    echo "Server fixture: Node workspace setup failed; see $run_dir/setup.log" >&2
    tail -n 60 "$run_dir/setup.log" >&2
    exit 1
  }
fi

port="$(node -e 'const s=require("node:net").createServer();s.listen(0,"127.0.0.1",()=>{console.log(s.address().port);s.close()})')"
password="talaria-contract-password"
typeset -a loader_environment
loader_environment=()
if [[ -n "${LD_LIBRARY_PATH:-}" ]]; then loader_environment=("LD_LIBRARY_PATH=$LD_LIBRARY_PATH"); fi
# The fixture replay sidecar answers every Agent-backed route from recorded
# fixtures and stages the approval the SSE probe expects; no Hermes Agent,
# provider, or network is involved.
(
  cd "$upstream_dir"
  env -i "${loader_environment[@]}" \
    PATH="$(dirname "$node_bin"):$(dirname "$python_bin"):/usr/bin:/bin" \
    HOME="$run_dir/home" \
    HERMES_HOME="$hermes_home" \
    HERMES_WEBUI_STATE_DIR="$state_dir" \
    HERMES_WEBUI_DEFAULT_WORKSPACE="$workspace_dir" \
    HERMES_WEBUI_HOST=127.0.0.1 \
    HERMES_WEBUI_PORT="$port" \
    HERMES_WEBUI_PASSWORD="$password" \
    HERMES_WEBUI_SKIP_ONBOARDING=1 \
    HERMES_WEBUI_TEST_NETWORK_BLOCK=1 \
    HERMES_WEBUI_SIDECAR_COMMAND="[\"$python_bin\", \"$upstream_dir/sidecar/scripts/replay_sidecar.py\"]" \
    TALARIA_WEB_WORKER=1 \
    node packages/server/dist/bin/talaria-web.js serve
) >"$run_dir/server.log" 2>&1 &
server_pid=$!

base_url="http://127.0.0.1:$port"
for _ in {1..80}; do
  if curl --silent --fail "$base_url/health" >/dev/null; then
    break
  fi
  kill -0 "$server_pid" 2>/dev/null || {
    echo "Disposable server exited during startup; see $run_dir/server.log" >&2
    exit 1
  }
  sleep 0.25
done
curl --silent --fail "$base_url/health" >/dev/null || {
  echo "Disposable server did not become healthy; see $run_dir/server.log" >&2
  exit 1
}

echo "Running live HTTP/SSE probe at $candidate_sha"
"$repo_root/scripts/upstream-contract-probe" \
  --base-url "$base_url" \
  --password "$password" \
  --workspace "$workspace_dir" \
  --output "$responses_file" \
  2>&1 | tee "$run_dir/probe.log"

if (( run_swift_tests )); then
  echo "Running Talaria request and SSE contract tests"
  (
    cd "$repo_root"
    # Every native contract class and the live decoding test run in TalariaKit on macOS, without a simulator
    # (TAL-399).
    TALARIA_LIVE_CONTRACT_RESPONSES="$responses_file" swift test --package-path TalariaKit \
      --filter '^TalariaKitTests\.(APIClientSessionListTests|APIClientSessionMutationTests|SSEClientTests|ContractReadinessTests|SharedContractTests|APIClientAuthAndErrorTests|StreamReconnectContractTests)/'
  ) 2>&1 | tee "$run_dir/swift-tests.log"
else
  echo "Swift contract tests skipped by --server-only"
fi

if [[ -n "$responses_output" ]]; then
  mkdir -p "$(dirname "$responses_output")"
  cp "$responses_file" "$responses_output"
fi

echo "PASS local web/ at monorepo $candidate_sha"
