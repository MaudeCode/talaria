#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
runtime_dir="$repo_root/.codex-tmp/run-ios"
lock_file="$runtime_dir/runner.lock"
source "$repo_root/scripts/ios-simulator-pool"
xcodebuild_pid=""

mkdir -p "$runtime_dir/derived-data" "$lease_dir"

cleanup() {
    if [[ -n "$xcodebuild_pid" ]]; then
        kill -TERM "$xcodebuild_pid" 2>/dev/null || true
        wait "$xcodebuild_pid" 2>/dev/null || true
    fi
    ios_pool_release
    unlink "$lock_file" 2>/dev/null || true
}

if (( $# != 0 )); then
    print -u2 "Usage: scripts/run-ios"
    exit 64
fi

if ! /usr/bin/shlock -f "$lock_file" -p $$; then
    print -u2 "Talaria is already running from this worktree (PID $(<"$lock_file"))."
    exit 75
fi
trap cleanup EXIT
trap 'exit 130' INT TERM

ios_pool_acquire

destination="platform=iOS Simulator,id=$simulator_id"
app_path="$runtime_dir/derived-data/Build/Products/Debug-iphonesimulator/Talaria.app"

print "Simulator: $destination"
cd "$repo_root"
xcodebuild build -quiet \
    -project Talaria.xcodeproj \
    -scheme Talaria \
    -configuration Debug \
    -destination "$destination" \
    -derivedDataPath "$runtime_dir/derived-data" \
    APP_IDENTIFIER_SUFFIX=.xctest &
xcodebuild_pid=$!
result=0
wait "$xcodebuild_pid" || result=$?
xcodebuild_pid=""
(( result == 0 )) || exit "$result"

bundle_identifier=$(/usr/bin/plutil -extract CFBundleIdentifier raw -o - "$app_path/Info.plist")
if [[ "$bundle_identifier" != dev.kil.talaria.xctest ]]; then
    print -u2 "The isolated simulator pool requires dev.kil.talaria.xctest, but the built app uses $bundle_identifier."
    exit 78
fi

/usr/bin/codesign --verify --deep --strict "$app_path"
xcrun simctl bootstatus "$simulator_id" -b >/dev/null
xcrun simctl install "$simulator_id" "$app_path"
developer_dir=$(xcode-select -p)
simulator_app="$developer_dir/Applications/Simulator.app"
[[ -d "$simulator_app" ]] || simulator_app="$developer_dir/../Applications/DeviceHub.app"
open "$simulator_app" --args -CurrentDeviceUDID "$simulator_id"
xcrun simctl launch "$simulator_id" "$bundle_identifier" --ui-test-fixture

print "Talaria's deterministic fixture is running on $simulator_id. Press Control-C to end the session and release it."
while true; do
    sleep 30
done
