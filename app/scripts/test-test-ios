#!/bin/zsh

set -euo pipefail

source_root=${0:A:h:h}
rounds=${1:-20}
[[ "$rounds" =~ '^[1-9][0-9]*$' ]] || {
    print -u2 "Usage: scripts/test-test-ios [positive-round-count]"
    exit 64
}
test_root=$(mktemp -d "${TMPDIR:-/tmp}/talaria-test-ios.XXXXXX")

cleanup() {
    local exit_status=$?
    set +e
    for pid in $(jobs -pr); do
        kill "$pid" 2>/dev/null || true
    done
    if [[ -n "${TALARIA_KEEP_SCRIPT_TEST_TMP:-}" ]]; then
        print -u2 "Preserved test state: $test_root"
    elif [[ -d "$test_root" ]]; then
        rm -rf -- "$test_root"
    fi
    return "$exit_status"
}
trap cleanup EXIT

repo="$test_root/repo"
peer="$test_root/peer"
fake_bin="$test_root/bin"
state="$test_root/state"
mkdir -p "$repo/scripts" "$repo/.xcodebuildmcp" "$fake_bin" "$state"
cp "$source_root/scripts/test-ios" "$repo/scripts/test-ios"
cp "$source_root/scripts/load-env" "$repo/scripts/load-env"
cp "$source_root/scripts/ios-simulator-pool" "$repo/scripts/ios-simulator-pool"
chmod +x "$repo/scripts/test-ios" "$repo/scripts/load-env"

cat > "$repo/scripts/assert-no-skipped-ui-tests" <<'EOF'
#!/bin/zsh
exit 0
EOF
cat > "$repo/.xcodebuildmcp/config.yaml" <<'EOF'
defaults:
  simulatorName: "iPhone 17"
EOF
cat > "$fake_bin/xcrun" <<'EOF'
#!/bin/zsh
if [[ "$*" == "simctl list devices available --json" ]]; then
    <"${TALARIA_DEVICE_FIXTURE:?}"
elif [[ "$1 $2 $3 $4" == "xcresulttool get test-results summary" ]]; then
    bundle=""
    for (( index = 1; index <= $#; index++ )); do
        [[ "${@[index]}" == --path ]] && bundle="${@[index + 1]}"
    done
    hang='{"failureText":"The test runner hung before establishing connection.","testName":"Talaria (1) encountered an error"}'
    if [[ -e "$bundle/hang-with-failure" ]]; then
        print -r -- "{\"failedTests\":2,\"testFailures\":[$hang,{\"failureText\":\"XCTAssertTrue failed\",\"testName\":\"testSomething()\"}]}"
    elif [[ -e "$bundle/hang" ]]; then
        print -r -- "{\"failedTests\":1,\"testFailures\":[$hang]}"
    else
        print -r -- '{"failedTests":0,"testFailures":[]}'
    fi
fi
EOF
cat > "$fake_bin/xcodebuild" <<'EOF'
#!/bin/zsh
set -euo pipefail

state=${TALARIA_TEST_STATE:?}
destination=""
result_bundle=""
exit_status=0
typeset -a selectors=()
typeset -a args=("$@")
for (( index = 1; index <= ${#args}; index++ )); do
    case "${args[index]}" in
        -destination)
            (( index++ ))
            destination="${args[index]}"
            ;;
        -resultBundlePath)
            (( index++ ))
            result_bundle="${args[index]}"
            ;;
        -only-testing:*)
            selectors+=("${args[index]}")
            [[ "${args[index]}" != *Failure* ]] || exit_status=42
            ;;
    esac
done

print -rl -- "$@" > "$state/last-args"
lock="$state/counter.lock"
while ! mkdir "$lock" 2>/dev/null; do sleep 0.01; done
read -r active < "$state/active"
read -r maximum < "$state/maximum"
active=$(( active + 1 ))
(( active > maximum )) && maximum=$active
print -r -- "$active" > "$state/active"
print -r -- "$maximum" > "$state/maximum"
print -r -- "$destination|$result_bundle|${(j: :)selectors}" >> "$state/runs"
rmdir "$lock"

sleep "${TALARIA_FAKE_XCODEBUILD_SECONDS:-0.08}"
mkdir -p "$result_bundle"
# Synthetic pre-test runner hangs: HangOnce recovers on its second run,
# HangTwice never does, HangWithFailure also carries a real test failure.
previous_runs=$(grep -c -- "${selectors[1]:-}" "$state/runs" || true)
case "${selectors[1]:-}" in
    *HangWithFailure*) touch "$result_bundle/hang-with-failure"; exit_status=65 ;;
    *HangTwice*) touch "$result_bundle/hang"; exit_status=65 ;;
    *HangOnce*) (( previous_runs > 1 )) || { touch "$result_bundle/hang"; exit_status=65; } ;;
esac

while ! mkdir "$lock" 2>/dev/null; do sleep 0.01; done
read -r active < "$state/active"
print -r -- "$(( active - 1 ))" > "$state/active"
rmdir "$lock"
exit "$exit_status"
EOF
chmod +x "$repo/scripts/assert-no-skipped-ui-tests" "$fake_bin/xcrun" "$fake_bin/xcodebuild"

cat > "$state/pool-devices" <<'EOF'
{"devices":{"com.apple.CoreSimulator.SimRuntime.iOS-27-0":[{"name":"iOS Test 1","udid":"AAAAAAAA-AAAA-AAAA-AAAA-AAAAAAAAAAAA","state":"Shutdown"},{"name":"iOS Test 2","udid":"BBBBBBBB-BBBB-BBBB-BBBB-BBBBBBBBBBBB","state":"Shutdown"}]}}
EOF
cat > "$state/fallback-devices" <<'EOF'
{"devices":{"com.apple.CoreSimulator.SimRuntime.iOS-27-0":[{"name":"iPhone 16","udid":"DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD","state":"Shutdown"}]}}
EOF
print 0 > "$state/active"
print 0 > "$state/maximum"
: > "$state/runs"

git -C "$repo" init -q
git -C "$repo" add .
git -C "$repo" -c user.name=Talaria -c user.email=talaria@example.invalid commit -qm fixture
git -C "$repo" worktree add -qb peer "$peer"

export PATH="$fake_bin:$PATH"
export TALARIA_TEST_STATE="$state"
export TALARIA_DEVICE_FIXTURE="$state/pool-devices"
export IOS_SIMULATOR_POOL_DIR="$state/pool"

wait_until_active() {
    local pid=$1
    for _ in {1..200}; do
        read -r active < "$state/active"
        (( active > 0 )) && return
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.01
    done
    print -u2 "Timed out waiting for the first synthetic xcodebuild."
    return 1
}

for round in {1..$rounds}; do
    "$repo/scripts/test-ios" "TalariaTests/Primary$round" > "$state/primary-$round.log" 2>&1 &
    primary_pid=$!
    wait_until_active "$primary_pid"
    "$peer/scripts/test-ios" "TalariaTests/Peer$round" > "$state/peer-$round.log" 2>&1 &
    peer_pid=$!
    wait "$primary_pid"
    wait "$peer_pid"
done

read -r maximum < "$state/maximum"
[[ "$maximum" == 1 ]] || {
    print -u2 "Expected one xcodebuild at a time, observed $maximum."
    exit 1
}
[[ $(wc -l < "$state/runs" | tr -d ' ') == $(( rounds * 2 )) ]]
[[ $(sed -n 's/^[^|]*|\([^|]*\)|.*$/\1/p' "$state/runs" | sort -u | wc -l | tr -d ' ') == $(( rounds * 2 )) ]]
grep -Eq "Waiting for Talaria XCTest admission: owner PID [0-9]+, elapsed [0-9]+s" "$state"/peer-*.log

print 'defaults:\n  simulatorName: "Missing simulator"' > "$repo/.xcodebuildmcp/config.yaml"
export TALARIA_DEVICE_FIXTURE="$state/fallback-devices"
IOS_SIMULATOR_ID=DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD "$repo/scripts/test-ios" TalariaTests/Fallback > "$state/fallback.log" 2>&1
grep -Eq "platform=iOS Simulator,id=DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD" "$state/fallback.log"
export TALARIA_DEVICE_FIXTURE="$state/pool-devices"
if "$repo/scripts/test-ios" TalariaTests/Failure > "$state/failure.log" 2>&1; then
    print -u2 "Expected the synthetic xcodebuild failure to propagate."
    exit 1
else
    [[ $? == 42 ]]
fi

runs_for() { grep -c -- "$1" "$state/runs" || true; }
[[ $(runs_for TalariaTests/Failure) == 1 ]]  # A real failure never retries.

# A pre-test runner hang with no failed test case retries exactly once.
"$repo/scripts/test-ios" TalariaTests/HangOnce > "$state/hang-once.log" 2>&1
[[ $(runs_for TalariaTests/HangOnce) == 2 ]]
grep -Eq "retrying once" "$state/hang-once.log"
[[ $(sed -n 's/^\([^|]*\)|.*HangOnce.*$/\1/p' "$state/runs" | sort -u | wc -l | tr -d ' ') == 1 ]]  # re-leased a pool device
if "$repo/scripts/test-ios" TalariaTests/HangTwice > "$state/hang-twice.log" 2>&1; then
    print -u2 "Expected a repeated runner hang to fail."
    exit 1
else
    [[ $? == 65 ]]
fi
[[ $(runs_for TalariaTests/HangTwice) == 2 ]]
if "$repo/scripts/test-ios" TalariaTests/HangWithFailure > "$state/hang-with-failure.log" 2>&1; then
    print -u2 "Expected a runner hang alongside a test failure to fail without retrying."
    exit 1
else
    [[ $? == 65 ]]
fi
[[ $(runs_for TalariaTests/HangWithFailure) == 1 ]]
! grep -Eq "retrying once" "$state/hang-with-failure.log"

common_dir=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)
sleep 0.01 &
dead_pid=$!
wait "$dead_pid"
print -r -- "$dead_pid" > "$common_dir/talaria-xctest-runner.lock"
"$peer/scripts/test-ios" TalariaTests/StaleLock > "$state/stale.log" 2>&1

export TALARIA_DEVICE_FIXTURE="$state/pool-devices"
export TALARIA_FAKE_XCODEBUILD_SECONDS=0.4
"$repo/scripts/test-ios" TalariaTests/Owner > "$state/owner.log" 2>&1 &
owner=$!
wait_until_active "$owner"
"$peer/scripts/test-ios" TalariaTests/CancelledWaiter > "$state/cancelled-waiter.log" 2>&1 &
waiter=$!
for _ in {1..200}; do
    grep -Eq "Waiting for Talaria XCTest admission: owner PID [0-9]+, elapsed [0-9]+s" "$state/cancelled-waiter.log" && break
    kill -0 "$waiter" 2>/dev/null || break
    sleep 0.01
done
grep -Eq "Waiting for Talaria XCTest admission: owner PID [0-9]+, elapsed [0-9]+s" "$state/cancelled-waiter.log"
kill -TERM "$waiter"
if wait "$waiter"; then
    print -u2 "Expected the waiting runner to exit after cancellation."
    exit 1
else
    [[ $? == 130 ]]
fi
[[ -e "$common_dir/talaria-xctest-runner.lock" ]]
wait "$owner"

"$repo/scripts/test-ios" TalariaTests/KilledOwner > "$state/killed-owner.log" 2>&1 &
killed_owner=$!
wait_until_active "$killed_owner"
kill -KILL "$killed_owner"
wait "$killed_owner" 2>/dev/null || true
"$peer/scripts/test-ios" TalariaTests/AfterKilledOwner > "$state/after-kill.log" 2>&1
unset TALARIA_FAKE_XCODEBUILD_SECONDS

read -r maximum < "$state/maximum"
read -r active < "$state/active"
[[ "$maximum" == 1 && "$active" == 0 ]]
[[ ! -e "$common_dir/talaria-xctest-runner.lock.owner" ]]

"$repo/scripts/test-ios" TalariaTests > "$state/whole-target.log" 2>&1
grep -Fqx -- '-skip-testing:TalariaTests/UntrustedInputFuzzSoakTests' "$state/last-args"
"$repo/scripts/test-ios" TalariaTests/UntrustedInputFuzzSoakTests > "$state/explicit-soak.log" 2>&1
! grep -Fqx -- '-skip-testing:TalariaTests/UntrustedInputFuzzSoakTests' "$state/last-args"

print "test-ios admission, selection and runner-hang retry checks passed ($rounds concurrent rounds)."
