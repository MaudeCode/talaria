#!/usr/bin/env bash

set -euo pipefail

source_root=$(cd "$(dirname "$(realpath "$0")")/.." && pwd -P)
rounds=${1:-20}
[[ "$rounds" =~ ^[1-9][0-9]*$ ]] || {
    echo "Usage: scripts/test-test-ios [positive-round-count]" >&2
    exit 64
}
test_root=$(mktemp -d "${TMPDIR:-/tmp}/talaria-test-ios.XXXXXX")

cleanup() {
    local exit_status=$?
    set +e
    for pid in $(jobs -pr); do
        kill "$pid" 2>/dev/null || true
    done
    if [[ -n "${TALARIA_KEEP_SCRIPT_TEST_TMP:-}" ]]; then
        echo "Preserved test state: $test_root" >&2
    elif [[ -d "$test_root" ]]; then
        rm -rf -- "$test_root"
    fi
    return "$exit_status"
}
trap cleanup EXIT
# A bare assertion fails silently under errexit; name it and show the newest synthetic run's log.
report_failure() {
    echo "test-test-ios: line $1 failed: $2" >&2
    local latest
    latest=$(ls -t "$test_root"/state/*.log 2>/dev/null | head -n 1) || true
    [[ -z "$latest" ]] || { echo "--- $latest" >&2; tail -n 20 "$latest" >&2; }
}
trap 'report_failure "$LINENO" "$BASH_COMMAND"' ERR

repo="$test_root/repo"
peer="$test_root/peer"
fake_bin="$test_root/bin"
state="$test_root/state"
mkdir -p "$repo/scripts" "$repo/.xcodebuildmcp" "$fake_bin" "$state"
cp "$source_root/scripts/test-ios" "$repo/scripts/test-ios"
cp "$source_root/scripts/load-env" "$repo/scripts/load-env"
cp "$source_root/scripts/ios-simulator-pool" "$repo/scripts/ios-simulator-pool"
chmod +x "$repo/scripts/test-ios" "$repo/scripts/load-env"

cat > "$repo/.xcodebuildmcp/config.yaml" <<'EOF'
defaults:
  simulatorName: "iPhone 17"
EOF
cat > "$fake_bin/xcrun" <<'EOF'
#!/usr/bin/env bash
if [[ "$*" == "simctl list devices available --json" ]]; then
    cat "${TALARIA_DEVICE_FIXTURE:?}"
fi
EOF
cat > "$fake_bin/xcodebuild" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

state=${TALARIA_TEST_STATE:?}
if [[ "$1" == build-for-testing ]]; then
    build_args=("$@")
    derived=""
    for (( index = 0; index < ${#build_args[@]}; index++ )); do
        if [[ "${build_args[index]}" == -derivedDataPath ]]; then
            index=$(( index + 1 )); derived=${build_args[index]}
        fi
    done
    mkdir -p "$derived/Build/Products"
    [[ "${TALARIA_FAKE_BUILD_RECEIPTS:-single}" != none ]] || exit 0
    echo 'build-produced fixture receipt' > "$derived/Build/Products/Talaria_Fixture.xctestrun"
    if [[ "${TALARIA_FAKE_BUILD_RECEIPTS:-single}" == multiple ]]; then
        echo 'other fixture receipt' > "$derived/Build/Products/Other.xctestrun"
    fi
    exit 0
fi
[[ "$1" == test-without-building ]] || exit 1
destination=""
result_bundle=""
result_stream=""
parallel=""
receipt=""
exit_status=0
selectors=()
args=("$@")
for (( index = 0; index < ${#args[@]}; index++ )); do
    case "${args[index]}" in
        -project|-scheme)
            echo 'Test launch reopened the project instead of consuming the build receipt.' >&2
            exit 96
            ;;
        -xctestrun)
            index=$(( index + 1 )); receipt=${args[index]}
            ;;
        -destination)
            index=$(( index + 1 ))
            destination="${args[index]}"
            ;;
        -resultBundlePath)
            index=$(( index + 1 ))
            result_bundle="${args[index]}"
            ;;
        -resultStreamPath)
            index=$(( index + 1 ))
            result_stream="${args[index]}"
            ;;
        -parallel-testing-enabled)
            index=$(( index + 1 ))
            parallel="${args[index]}"
            ;;
        -only-testing:*)
            selectors+=("${args[index]}")
            [[ "${args[index]}" != *Failure* ]] || exit_status=42
            ;;
    esac
done
[[ -f "$receipt" && "$(<"$receipt")" == 'build-produced fixture receipt' ]] || {
    echo 'Test launch did not consume the receipt produced by build-for-testing.' >&2
    exit 96
}

# Synthetic runners that never connect: ConnectsOnRelaunch connects on its second launch.
previous_runs=$(grep -c -- "${selectors[0]:-}" "$state/runs" || true)
if [[ "${selectors[0]:-}" == *NeverConnects* ]] || [[ "${selectors[0]:-}" == *ConnectsOnRelaunch* && $previous_runs == 0 ]]; then
    mkdir -p "$result_bundle/Staging/1_Test/Diagnostics"
    printf '%s\n' 'Connected socket 30 to testmanagerd' > "$result_bundle/Staging/1_Test/Diagnostics/Session-Transport.log"
    printf '%s\n' "$destination|$result_bundle|${selectors[*]}|$parallel" >> "$state/runs"
    exec sleep 30
fi
# Xcode acknowledges the connected test host before bundle warm-up finishes and the first suite is reported.
if [[ "${selectors[0]:-}" == *InstallThen* || "${selectors[0]:-}" == *InstallNeverLaunches* || "${selectors[0]:-}" == *LaunchRequestNeverRuns* || "${selectors[0]:-}" == *LaunchedNeverConnects* ]]; then
    session_log="$result_bundle/Staging/1_Test/Diagnostics/TalariaTests/Runner/Session-Preparation.log"
    mkdir -p "$(dirname "$session_log")"
    if [[ "${selectors[0]:-}" != *LaunchedNeverConnects* ]]; then
        printf '%s\n' 'Installing app at path: /fixture/Talaria.app' > "$session_log"
    fi
    if [[ "${selectors[0]:-}" == *LaunchRequestNeverRuns* ]]; then
        printf '%s\n' 'Launching app with identifier: dev.kil.talaria.xctest and options: {' >> "$session_log"
    fi
    if [[ "${selectors[0]:-}" == *LaunchedNeverConnects* ]]; then
        printf '%s\n' 'Launched app with identifier: dev.kil.talaria.xctest (pid = 1234)' >> "$session_log"
    fi
    if [[ "${selectors[0]:-}" == *InstallNeverLaunches* || "${selectors[0]:-}" == *LaunchRequestNeverRuns* || "${selectors[0]:-}" == *LaunchedNeverConnects* ]]; then
        printf '%s\n' "$destination|$result_bundle|${selectors[*]}|$parallel" >> "$state/runs"
        exec sleep 30
    fi
    sleep 2
    printf '%s\n' 'Launched app with identifier: dev.kil.talaria.xctest (pid = 1234)' >> "$session_log"
    printf '%s\n' 'Test runner is ready with capabilities: <XCTCapabilities: fixture>' >> "$session_log"
fi
if [[ "${selectors[0]:-}" == *ConnectedBeforeSuite* || "${selectors[0]:-}" == *ReadyBeforeExecution* ]]; then
    mkdir -p "$result_bundle/Staging/1_Test/Diagnostics/TalariaTests/Runner"
    acknowledgement='Test runner started executing tests.'
    [[ "${selectors[0]:-}" != *ReadyBeforeExecution* ]] || acknowledgement='Test runner is ready with capabilities: <XCTCapabilities: fixture>'
    printf '%s\n' "xcodebuild[123:456] $acknowledgement" > "$result_bundle/Staging/1_Test/Diagnostics/TalariaTests/Runner/Session-Connected.log"
    sleep 2
fi
# The runner connects and reports its first suite.
printf '%s\n' '{"name":{"_value":"testSuiteStarted"}}' >> "$result_stream"
[[ ! -e TalariaTests/VisualReferences/.record ]] || printf '%s\n' "${selectors[0]:-}" >> "$state/recorded"
[[ ! -e .codex-tmp/xctest/test-screenshots ]] || printf '%s\n' "${selectors[0]:-}" >> "$state/screenshots"
if [[ -e .codex-tmp/xctest/native-history-drag ]]; then
    printf '%s\n' "$(<.codex-tmp/xctest/native-history-drag)|${selectors[0]:-}" >> "$state/native-drag"
fi
lock="$state/counter.lock"
while ! mkdir "$lock" 2>/dev/null; do sleep 0.01; done
read -r active < "$state/active"
read -r maximum < "$state/maximum"
active=$(( active + 1 ))
(( active > maximum )) && maximum=$active
printf '%s\n' "$active" > "$state/active"
printf '%s\n' "$maximum" > "$state/maximum"
printf '%s\n' "$destination|$result_bundle|${selectors[*]}|$parallel" >> "$state/runs"
rmdir "$lock"

sleep "${TALARIA_FAKE_XCODEBUILD_SECONDS:-0.08}"
mkdir -p "$result_bundle"

while ! mkdir "$lock" 2>/dev/null; do sleep 0.01; done
read -r active < "$state/active"
printf '%s\n' "$(( active - 1 ))" > "$state/active"
rmdir "$lock"
exit "$exit_status"
EOF
chmod +x "$fake_bin/xcrun" "$fake_bin/xcodebuild"

cat > "$state/pool-devices" <<'EOF'
{"devices":{"com.apple.CoreSimulator.SimRuntime.iOS-27-0":[{"name":"iOS Test 1","udid":"AAAAAAAA-AAAA-AAAA-AAAA-AAAAAAAAAAAA","state":"Shutdown"},{"name":"iOS Test 2","udid":"BBBBBBBB-BBBB-BBBB-BBBB-BBBBBBBBBBBB","state":"Shutdown"}]}}
EOF
cat > "$state/fallback-devices" <<'EOF'
{"devices":{"com.apple.CoreSimulator.SimRuntime.iOS-27-0":[{"name":"iPhone 16","udid":"DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD","state":"Shutdown"}]}}
EOF
echo 0 > "$state/active"
echo 0 > "$state/maximum"
: > "$state/runs"

git -C "$repo" init -q
git -C "$repo" add .
git -C "$repo" -c user.name=Talaria -c user.email=talaria@example.invalid commit -qm fixture
git -C "$repo" worktree add -qb peer "$peer"

export PATH="$fake_bin:$PATH"
export TALARIA_TEST_STATE="$state"
export TALARIA_DEVICE_FIXTURE="$state/pool-devices"
export IOS_SIMULATOR_POOL_DIR="$state/pool"

wait_until_active() {
    local pid=$1 target=${2:-1}
    for _ in {1..300}; do
        # Unlocked, so this can land inside a run's truncate-then-write and read nothing.
        read -r active < "$state/active" || { sleep 0.01; continue; }
        (( active >= target )) && return
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.01
    done
    echo "Timed out waiting for $target synthetic xcodebuild run(s)." >&2
    return 1
}

for (( round = 1; round <= rounds; round++ )); do
    "$repo/scripts/test-ios" "TalariaTests/Primary$round" > "$state/primary-$round.log" 2>&1 &
    primary_pid=$!
    wait_until_active "$primary_pid"
    "$repo/scripts/test-ios" "TalariaTests/Second$round" > "$state/second-$round.log" 2>&1 &
    second_pid=$!
    wait "$primary_pid"
    wait "$second_pid"
done

read -r maximum < "$state/maximum"
[[ "$maximum" == 1 ]] || {
    echo "Expected one xcodebuild at a time within a worktree, observed $maximum." >&2
    exit 1
}
[[ $(wc -l < "$state/runs" | tr -d ' ') == $(( rounds * 2 )) ]]
[[ $(sed -n 's/^[^|]*|\([^|]*\)|.*$/\1/p' "$state/runs" | sort -u | wc -l | tr -d ' ') == $(( rounds * 2 )) ]]
grep -Eq "Waiting for this worktree's XCTest run: owner PID [0-9]+, elapsed [0-9]+s" "$state"/second-*.log

# A successful build without one unambiguous test receipt cannot start tests or retain admission.
manifest_repo="$test_root/manifest-repo"
git -C "$repo" worktree add -qb manifest "$manifest_repo"
before_manifest_checks=$(wc -l < "$state/runs" | tr -d ' ')
for case in none:0 multiple:2; do
    mode=${case%%:*} expected=${case#*:}
    if TALARIA_FAKE_BUILD_RECEIPTS=$mode "$manifest_repo/scripts/test-ios" TalariaTests/InvalidReceipt > "$state/receipt-$mode.log" 2>&1; then
        echo "Expected the $mode build receipt to fail before test launch." >&2
        exit 1
    else
        [[ $? == 65 ]]
    fi
    grep -q "Expected one build-produced .xctestrun.*found $expected" "$state/receipt-$mode.log"
    [[ ! -e "$manifest_repo/.codex-tmp/xctest/runner.lock.owner" ]]
done
[[ $(wc -l < "$state/runs" | tr -d ' ') == $before_manifest_checks ]]

# Different worktrees never wait on each other; each leases its own pool device.
export TALARIA_FAKE_XCODEBUILD_SECONDS=3
"$repo/scripts/test-ios" TalariaTests/ConcurrentPrimary > "$state/concurrent-primary.log" 2>&1 &
primary_pid=$!
wait_until_active "$primary_pid"
"$peer/scripts/test-ios" TalariaTests/ConcurrentPeer > "$state/concurrent-peer.log" 2>&1 &
peer_pid=$!
wait_until_active "$peer_pid" 2
wait "$primary_pid"
wait "$peer_pid"
unset TALARIA_FAKE_XCODEBUILD_SECONDS
if grep -q "Waiting for" "$state/concurrent-peer.log"; then
    echo "A run in another worktree waited for admission." >&2
    exit 1
fi
[[ $(sed -n 's/^\([^|]*\)|.*Concurrent.*$/\1/p' "$state/runs" | sort -u | wc -l | tr -d ' ') == 2 ]]
echo 0 > "$state/maximum"

printf 'defaults:\n  simulatorName: "Missing simulator"\n' > "$repo/.xcodebuildmcp/config.yaml"
export TALARIA_DEVICE_FIXTURE="$state/fallback-devices"
IOS_SIMULATOR_ID=DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD "$repo/scripts/test-ios" TalariaTests/Fallback > "$state/fallback.log" 2>&1
grep -Eq "platform=iOS Simulator,id=DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD" "$state/fallback.log"
export TALARIA_DEVICE_FIXTURE="$state/pool-devices"
if "$repo/scripts/test-ios" TalariaTests/Failure > "$state/failure.log" 2>&1; then
    echo "Expected the synthetic xcodebuild failure to propagate." >&2
    exit 1
else
    [[ $? == 42 ]]
fi

runs_for() { grep -c -- "$1" "$state/runs" || true; }
[[ $(runs_for TalariaTests/Failure) == 1 ]]  # A real failure never retries.

# A connected host can spend longer than the connection budget warming up before its first suite.
for case in ConnectedBeforeSuite:0 ConnectedBeforeSuiteFailure:42 ReadyBeforeExecution:0 ReadyBeforeExecutionFailure:42; do
    selector=${case%%:*} expected_status=${case#*:}
    if TALARIA_RUNNER_CONNECT_TIMEOUT=1 "$repo/scripts/test-ios" "TalariaTests/$selector" > "$state/$selector.log" 2>&1; then
        observed_status=0
    else
        observed_status=$?
    fi
    [[ "$observed_status" == "$expected_status" ]] || {
        echo "A connected host awaiting its first suite returned $observed_status instead of $expected_status." >&2
        exit 1
    }
    [[ $(runs_for "TalariaTests/$selector|") == 1 ]]
    grep -q 'The test runner connected after' "$state/$selector.log"
done

# App installation is preparation, not time a running host spent failing to connect.
for case in InstallThenConnect:0 InstallThenFailure:42; do
    selector=${case%%:*} expected_status=${case#*:}
    if TALARIA_RUNNER_CONNECT_TIMEOUT=1 TALARIA_RUNNER_PREPARATION_TIMEOUT=3 "$repo/scripts/test-ios" "TalariaTests/$selector" > "$state/$selector.log" 2>&1; then
        observed_status=0
    else
        observed_status=$?
    fi
    [[ "$observed_status" == "$expected_status" ]] || {
        echo "Installation consumed the connection budget: $selector returned $observed_status instead of $expected_status." >&2
        exit 1
    }
    [[ $(runs_for "TalariaTests/$selector|") == 1 ]]
done

for selector in InstallNeverLaunches LaunchRequestNeverRuns LaunchedNeverConnects; do
    started=$SECONDS
    if TALARIA_RUNNER_CONNECT_TIMEOUT=1 TALARIA_RUNNER_PREPARATION_TIMEOUT=1 "$repo/scripts/test-ios" "TalariaTests/$selector" > "$state/$selector.log" 2>&1; then
        echo "A stalled $selector unexpectedly passed." >&2
        exit 1
    else
        [[ $? == 70 ]]
    fi
    [[ $(runs_for "TalariaTests/$selector|") == 2 ]]
    (( SECONDS - started < 15 )) || { echo "A stalled $selector exceeded its bounded relaunches." >&2; exit 1; }
done

# A runner that never connects gets one relaunch on a rebooted simulator, then stops the run with its name, without
# waiting out xcodebuild. A previous result bundle cannot supply the current attempt's acknowledgement.
stale_session="$repo/.codex-tmp/xctest/results/previous.xcresult/Staging/1_Test/Diagnostics/Session-Stale.log"
mkdir -p "$(dirname "$stale_session")"
printf '%s\n' 'xcodebuild[123:456] Test runner started executing tests.' > "$stale_session"
printf '%s\n' 'xcodebuild[123:456] Test runner is ready with capabilities: <XCTCapabilities: fixture>' >> "$stale_session"
started=$SECONDS
if TALARIA_RUNNER_CONNECT_TIMEOUT=1 "$repo/scripts/test-ios" TalariaTests/NeverConnects > "$state/never-connects.log" 2>&1; then
    echo "Expected a runner that never connects to fail the run." >&2
    exit 1
else
    [[ $? == 70 ]]
fi
(( SECONDS - started < 15 )) || {
    echo "A runner that never connected held the run for $(( SECONDS - started ))s." >&2
    exit 1
}
grep -Eq "The test runner on iOS Test [12] \([A-F-]+\) did not connect within 1s; rebooting" "$state/never-connects.log"
grep -Eq "The test runner on iOS Test [12] \([A-F-]+\) did not connect within 1s after a reboot; stopping" "$state/never-connects.log"
[[ $(runs_for TalariaTests/NeverConnects) == 2 ]]
TALARIA_RUNNER_CONNECT_TIMEOUT=1 "$repo/scripts/test-ios" TalariaTests/ConnectsOnRelaunch > "$state/connects-on-relaunch.log" 2>&1
[[ $(runs_for TalariaTests/ConnectsOnRelaunch) == 2 ]]

lock_file="$repo/.codex-tmp/xctest/runner.lock"
sleep 0.01 &
dead_pid=$!
wait "$dead_pid"
printf '%s\n' "$dead_pid" > "$lock_file"
"$repo/scripts/test-ios" TalariaTests/StaleLock > "$state/stale.log" 2>&1

export TALARIA_DEVICE_FIXTURE="$state/pool-devices"
export TALARIA_FAKE_XCODEBUILD_SECONDS=0.4
"$repo/scripts/test-ios" TalariaTests/Owner > "$state/owner.log" 2>&1 &
owner=$!
wait_until_active "$owner"
"$repo/scripts/test-ios" TalariaTests/CancelledWaiter > "$state/cancelled-waiter.log" 2>&1 &
waiter=$!
for _ in {1..200}; do
    grep -Eq "Waiting for this worktree's XCTest run: owner PID [0-9]+, elapsed [0-9]+s" "$state/cancelled-waiter.log" && break
    kill -0 "$waiter" 2>/dev/null || break
    sleep 0.01
done
grep -Eq "Waiting for this worktree's XCTest run: owner PID [0-9]+, elapsed [0-9]+s" "$state/cancelled-waiter.log"
kill -TERM "$waiter"
if wait "$waiter"; then
    echo "Expected the waiting runner to exit after cancellation." >&2
    exit 1
else
    [[ $? == 130 ]]
fi
[[ -e "$lock_file" ]]
wait "$owner"

"$repo/scripts/test-ios" TalariaTests/KilledOwner > "$state/killed-owner.log" 2>&1 &
killed_owner=$!
wait_until_active "$killed_owner"
kill -KILL "$killed_owner"
wait "$killed_owner" 2>/dev/null || true
"$repo/scripts/test-ios" TalariaTests/AfterKilledOwner > "$state/after-kill.log" 2>&1
unset TALARIA_FAKE_XCODEBUILD_SECONDS

read -r maximum < "$state/maximum"
read -r active < "$state/active"
[[ "$maximum" == 1 && "$active" == 0 ]]
[[ ! -e "$lock_file.owner" ]]

# With no selector, a run tests TalariaTests on the leased device without clones.
before=$(wc -l < "$state/runs")
"$repo/scripts/test-ios" > "$state/default.log" 2>&1
[[ "$(tail -n "+$(( before + 1 ))" "$state/runs" | cut -d'|' -f3-)" == '-only-testing:TalariaTests|NO' ]] || {
    echo "Expected a run without selectors to test TalariaTests in one pass without clones:" >&2
    tail -n "+$(( before + 1 ))" "$state/runs" | cut -d'|' -f3- >&2
    exit 1
}

# The visual-reference record marker exists only during a recording run, even one that fails,
# and a stale marker never turns an ordinary run into a re-record.
marker="$repo/TalariaTests/VisualReferences/.record"
mkdir -p "$(dirname "$marker")"
: > "$marker"
: > "$state/recorded"
"$repo/scripts/test-ios" TalariaTests/Ordinary > "$state/ordinary.log" 2>&1
TALARIA_RECORD_VISUAL_REFERENCES=1 "$repo/scripts/test-ios" TalariaTests/Record > "$state/record.log" 2>&1
TALARIA_RECORD_VISUAL_REFERENCES=1 "$repo/scripts/test-ios" TalariaTests/RecordFailure > "$state/record-failure.log" 2>&1 || true
[[ "$(<"$state/recorded")" == $'-only-testing:TalariaTests/Record\n-only-testing:TalariaTests/RecordFailure' ]]
[[ ! -e "$marker" ]]

# Only a run that asks for evidence screenshots keeps them, and its marker goes with it.
: > "$state/screenshots"
TALARIA_TEST_SCREENSHOTS=1 "$repo/scripts/test-ios" TalariaTests/Evidence > "$state/evidence.log" 2>&1
"$repo/scripts/test-ios" TalariaTests/NoEvidence > "$state/no-evidence.log" 2>&1
[[ "$(<"$state/screenshots")" == '-only-testing:TalariaTests/Evidence' ]]
[[ ! -e "$repo/.codex-tmp/xctest/test-screenshots" ]]

# A run cancelled while waiting for admission leaves the recording run's marker in place.
export TALARIA_FAKE_XCODEBUILD_SECONDS=3
TALARIA_RECORD_VISUAL_REFERENCES=1 "$repo/scripts/test-ios" TalariaTests/RecordOwner > "$state/record-owner.log" 2>&1 &
owner=$!
wait_until_active "$owner"
"$repo/scripts/test-ios" TalariaTests/RecordWaiter > "$state/record-waiter.log" 2>&1 &
waiter=$!
for _ in {1..200}; do
    pgrep -qP "$waiter" lockf && break
    sleep 0.01
done
# Ctrl-C signals the whole process group; signalling only the shell would wait out lockf.
kill -TERM "$waiter"
pkill -TERM -P "$waiter" lockf || true
wait "$waiter" || true
kill -0 "$owner"  # The owner is still recording.
[[ -e "$marker" ]] || {
    echo "A cancelled waiter removed the active recording run's marker." >&2
    exit 1
}
wait "$owner"
unset TALARIA_FAKE_XCODEBUILD_SECONDS
[[ ! -e "$marker" ]]

# Native gesture mode is scoped to its owning run, including failed runs;
# a stale marker must never make unattended hosted tests wait for a driver.
native_marker="$repo/.codex-tmp/xctest/native-history-drag"
echo stale > "$native_marker"
: > "$state/native-drag"
"$repo/scripts/test-ios" TalariaTests/NativeOrdinary > "$state/native-ordinary.log" 2>&1
TALARIA_NATIVE_HISTORY_DRAG=first "$repo/scripts/test-ios" TalariaTests/NativeDriver > "$state/native-driver.log" 2>&1
TALARIA_NATIVE_HISTORY_DRAG=second "$repo/scripts/test-ios" TalariaTests/NativeFailure > "$state/native-failure.log" 2>&1 || true
[[ "$(<"$state/native-drag")" == $'first|-only-testing:TalariaTests/NativeDriver\nsecond|-only-testing:TalariaTests/NativeFailure' ]] || {
    echo "Native gesture mode leaked into an ordinary run or was missing from its owning run." >&2
    exit 1
}
[[ ! -e "$native_marker" ]]

echo "test-ios worktree admission, selection, runner connection and cleanup checks passed ($rounds concurrent rounds)."
