#!/bin/zsh

set -euo pipefail

source_root=${0:A:h:h}
rounds=${1:-20}
[[ "$rounds" =~ '^[1-9][0-9]*$' ]] || {
    print -u2 "Usage: scripts/test-test-ios [positive-round-count]"
    exit 64
}
test_root=$(mktemp -d "${TMPDIR:-/tmp}/talaria-test-ios.XXXXXX")

cleanup() {
    local exit_status=$?
    set +e
    for pid in $(jobs -pr); do
        kill "$pid" 2>/dev/null || true
    done
    if [[ -n "${TALARIA_KEEP_SCRIPT_TEST_TMP:-}" ]]; then
        print -u2 "Preserved test state: $test_root"
    elif [[ -d "$test_root" ]]; then
        rm -rf -- "$test_root"
    fi
    return "$exit_status"
}
trap cleanup EXIT

repo="$test_root/repo"
peer="$test_root/peer"
fake_bin="$test_root/bin"
state="$test_root/state"
mkdir -p "$repo/scripts" "$repo/ci" "$repo/.xcodebuildmcp" "$fake_bin" "$state"
cp "$source_root/scripts/test-ios" "$repo/scripts/test-ios"
cp "$source_root/ci/test_shards.py" "$repo/ci/test_shards.py"
cp "$source_root/scripts/load-env" "$repo/scripts/load-env"
cp "$source_root/scripts/ios-simulator-pool" "$repo/scripts/ios-simulator-pool"
cp "$source_root/scripts/prepare-ui-simulator" "$repo/scripts/prepare-ui-simulator"
chmod +x "$repo/scripts/test-ios" "$repo/scripts/load-env"

cat > "$repo/scripts/assert-no-skipped-ui-tests" <<'EOF'
#!/bin/zsh
exit 0
EOF
cat > "$repo/scripts/seed-simulator-photo" <<'EOF'
#!/bin/zsh
[[ ! -e "$TALARIA_TEST_STATE/seed-fail" ]] || exit 3
print -r -- "$1" >> "$TALARIA_TEST_STATE/seeded"
EOF
cat > "$repo/scripts/ready-simulator-notifications" <<'EOF'
#!/bin/zsh
print -r -- "$1" >> "$TALARIA_TEST_STATE/notifications-readied"
EOF
cat > "$repo/.xcodebuildmcp/config.yaml" <<'EOF'
defaults:
  simulatorName: "iPhone 17"
EOF
cat > "$fake_bin/xcrun" <<'EOF'
#!/bin/zsh
if [[ "$*" == "simctl list devices available --json" ]]; then
    <"${TALARIA_DEVICE_FIXTURE:?}"
elif [[ "$1 $2" == "simctl spawn" ]]; then
    print -r -- "${@:3}" >> "$TALARIA_TEST_STATE/spawned"
elif [[ "$1 $2 $3 $4" == "xcresulttool get test-results summary" ]]; then
    bundle=""
    for (( index = 1; index <= $#; index++ )); do
        [[ "${@[index]}" == --path ]] && bundle="${@[index + 1]}"
    done
    hang='{"failureText":"The test runner hung before establishing connection.","testName":"Talaria (1) encountered an error"}'
    if [[ -e "$bundle/hang-with-failure" ]]; then
        print -r -- "{\"failedTests\":2,\"testFailures\":[$hang,{\"failureText\":\"XCTAssertTrue failed\",\"testName\":\"testSomething()\"}]}"
    elif [[ -e "$bundle/hang" ]]; then
        print -r -- "{\"failedTests\":1,\"testFailures\":[$hang]}"
    else
        print -r -- '{"failedTests":0,"testFailures":[]}'
    fi
fi
EOF
cat > "$fake_bin/xcodebuild" <<'EOF'
#!/bin/zsh
set -euo pipefail

state=${TALARIA_TEST_STATE:?}
destination=""
result_bundle=""
parallel=""
exit_status=0
typeset -a selectors=()
typeset -a args=("$@")
for (( index = 1; index <= ${#args}; index++ )); do
    case "${args[index]}" in
        -destination)
            (( index++ ))
            destination="${args[index]}"
            ;;
        -resultBundlePath)
            (( index++ ))
            result_bundle="${args[index]}"
            ;;
        -parallel-testing-enabled)
            (( index++ ))
            parallel="${args[index]}"
            ;;
        -only-testing:*)
            selectors+=("${args[index]}")
            [[ "${args[index]}" != *Failure* ]] || exit_status=42
            ;;
    esac
done

print -rl -- "$@" > "$state/last-args"
[[ ! -e TalariaTests/VisualReferences/.record ]] || print -r -- "${selectors[1]:-}" >> "$state/recorded"
print -rl -- "$@" >> "$state/all-args"
lock="$state/counter.lock"
while ! mkdir "$lock" 2>/dev/null; do sleep 0.01; done
read -r active < "$state/active"
read -r maximum < "$state/maximum"
active=$(( active + 1 ))
(( active > maximum )) && maximum=$active
print -r -- "$active" > "$state/active"
print -r -- "$maximum" > "$state/maximum"
print -r -- "$destination|$result_bundle|${(j: :)selectors}|$parallel" >> "$state/runs"
rmdir "$lock"

sleep "${TALARIA_FAKE_XCODEBUILD_SECONDS:-0.08}"
mkdir -p "$result_bundle"
# Synthetic pre-test runner hangs: HangOnce recovers on its second run,
# HangTwice never does, HangWithFailure also carries a real test failure.
previous_runs=$(grep -c -- "${selectors[1]:-}" "$state/runs" || true)
case "${selectors[1]:-}" in
    *HangWithFailure*) touch "$result_bundle/hang-with-failure"; exit_status=65 ;;
    *HangTwice*) touch "$result_bundle/hang"; exit_status=65 ;;
    *HangOnce*) (( previous_runs > 1 )) || { touch "$result_bundle/hang"; exit_status=65; } ;;
esac

while ! mkdir "$lock" 2>/dev/null; do sleep 0.01; done
read -r active < "$state/active"
print -r -- "$(( active - 1 ))" > "$state/active"
rmdir "$lock"
exit "$exit_status"
EOF
chmod +x "$repo/scripts/assert-no-skipped-ui-tests" "$repo/scripts/seed-simulator-photo" "$repo/scripts/ready-simulator-notifications" "$fake_bin/xcrun" "$fake_bin/xcodebuild"

cat > "$state/pool-devices" <<'EOF'
{"devices":{"com.apple.CoreSimulator.SimRuntime.iOS-27-0":[{"name":"iOS Test 1","udid":"AAAAAAAA-AAAA-AAAA-AAAA-AAAAAAAAAAAA","state":"Shutdown"},{"name":"iOS Test 2","udid":"BBBBBBBB-BBBB-BBBB-BBBB-BBBBBBBBBBBB","state":"Shutdown"},{"name":"iPad (A16)","udid":"EEEEEEEE-EEEE-EEEE-EEEE-EEEEEEEEEEEE","state":"Shutdown"},{"name":"iPhone 17 Pro Max","udid":"FFFFFFFF-FFFF-FFFF-FFFF-FFFFFFFFFFFF","state":"Shutdown"}]}}
EOF
cat > "$state/no-ipad-devices" <<'EOF'
{"devices":{"com.apple.CoreSimulator.SimRuntime.iOS-27-0":[{"name":"iOS Test 1","udid":"AAAAAAAA-AAAA-AAAA-AAAA-AAAAAAAAAAAA","state":"Shutdown"},{"name":"iPhone 17 Pro Max","udid":"FFFFFFFF-FFFF-FFFF-FFFF-FFFFFFFFFFFF","state":"Shutdown"}]}}
EOF
cat > "$state/fallback-devices" <<'EOF'
{"devices":{"com.apple.CoreSimulator.SimRuntime.iOS-27-0":[{"name":"iPhone 16","udid":"DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD","state":"Shutdown"}]}}
EOF
print 0 > "$state/active"
print 0 > "$state/maximum"
: > "$state/runs"

git -C "$repo" init -q
git -C "$repo" add .
git -C "$repo" -c user.name=Talaria -c user.email=talaria@example.invalid commit -qm fixture
git -C "$repo" worktree add -qb peer "$peer"

export PATH="$fake_bin:$PATH"
export TALARIA_TEST_STATE="$state"
export TALARIA_DEVICE_FIXTURE="$state/pool-devices"
export IOS_SIMULATOR_POOL_DIR="$state/pool"

wait_until_active() {
    local pid=$1 target=${2:-1}
    for _ in {1..300}; do
        read -r active < "$state/active"
        (( active >= target )) && return
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.01
    done
    print -u2 "Timed out waiting for $target synthetic xcodebuild run(s)."
    return 1
}

for round in {1..$rounds}; do
    "$repo/scripts/test-ios" "TalariaTests/Primary$round" > "$state/primary-$round.log" 2>&1 &
    primary_pid=$!
    wait_until_active "$primary_pid"
    "$repo/scripts/test-ios" "TalariaTests/Second$round" > "$state/second-$round.log" 2>&1 &
    second_pid=$!
    wait "$primary_pid"
    wait "$second_pid"
done

read -r maximum < "$state/maximum"
[[ "$maximum" == 1 ]] || {
    print -u2 "Expected one xcodebuild at a time within a worktree, observed $maximum."
    exit 1
}
[[ $(wc -l < "$state/runs" | tr -d ' ') == $(( rounds * 2 )) ]]
[[ $(sed -n 's/^[^|]*|\([^|]*\)|.*$/\1/p' "$state/runs" | sort -u | wc -l | tr -d ' ') == $(( rounds * 2 )) ]]
grep -Eq "Waiting for this worktree's XCTest run: owner PID [0-9]+, elapsed [0-9]+s" "$state"/second-*.log

# Different worktrees never wait on each other; each leases its own pool device.
export TALARIA_FAKE_XCODEBUILD_SECONDS=3
"$repo/scripts/test-ios" TalariaTests/ConcurrentPrimary > "$state/concurrent-primary.log" 2>&1 &
primary_pid=$!
wait_until_active "$primary_pid"
"$peer/scripts/test-ios" TalariaTests/ConcurrentPeer > "$state/concurrent-peer.log" 2>&1 &
peer_pid=$!
wait_until_active "$peer_pid" 2
wait "$primary_pid"
wait "$peer_pid"
unset TALARIA_FAKE_XCODEBUILD_SECONDS
if grep -q "Waiting for" "$state/concurrent-peer.log"; then
    print -u2 "A run in another worktree waited for admission."
    exit 1
fi
[[ $(sed -n 's/^\([^|]*\)|.*Concurrent.*$/\1/p' "$state/runs" | sort -u | wc -l | tr -d ' ') == 2 ]]
print 0 > "$state/maximum"

print 'defaults:\n  simulatorName: "Missing simulator"' > "$repo/.xcodebuildmcp/config.yaml"
export TALARIA_DEVICE_FIXTURE="$state/fallback-devices"
IOS_SIMULATOR_ID=DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD "$repo/scripts/test-ios" TalariaTests/Fallback > "$state/fallback.log" 2>&1
grep -Eq "platform=iOS Simulator,id=DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD" "$state/fallback.log"
export TALARIA_DEVICE_FIXTURE="$state/pool-devices"
if "$repo/scripts/test-ios" TalariaTests/Failure > "$state/failure.log" 2>&1; then
    print -u2 "Expected the synthetic xcodebuild failure to propagate."
    exit 1
else
    [[ $? == 42 ]]
fi

runs_for() { grep -c -- "$1" "$state/runs" || true; }
[[ $(runs_for TalariaTests/Failure) == 1 ]]  # A real failure never retries.

# A pre-test runner hang with no failed test case retries exactly once.
"$repo/scripts/test-ios" TalariaTests/HangOnce > "$state/hang-once.log" 2>&1
[[ $(runs_for TalariaTests/HangOnce) == 2 ]]
grep -Eq "retrying once" "$state/hang-once.log"
[[ $(sed -n 's/^\([^|]*\)|.*HangOnce.*$/\1/p' "$state/runs" | sort -u | wc -l | tr -d ' ') == 1 ]]  # re-leased a pool device
if "$repo/scripts/test-ios" TalariaTests/HangTwice > "$state/hang-twice.log" 2>&1; then
    print -u2 "Expected a repeated runner hang to fail."
    exit 1
else
    [[ $? == 65 ]]
fi
[[ $(runs_for TalariaTests/HangTwice) == 2 ]]
if "$repo/scripts/test-ios" TalariaTests/HangWithFailure > "$state/hang-with-failure.log" 2>&1; then
    print -u2 "Expected a runner hang alongside a test failure to fail without retrying."
    exit 1
else
    [[ $? == 65 ]]
fi
[[ $(runs_for TalariaTests/HangWithFailure) == 1 ]]
! grep -Eq "retrying once" "$state/hang-with-failure.log"

lock_file="$repo/.codex-tmp/xctest/runner.lock"
sleep 0.01 &
dead_pid=$!
wait "$dead_pid"
print -r -- "$dead_pid" > "$lock_file"
"$repo/scripts/test-ios" TalariaTests/StaleLock > "$state/stale.log" 2>&1

export TALARIA_DEVICE_FIXTURE="$state/pool-devices"
export TALARIA_FAKE_XCODEBUILD_SECONDS=0.4
"$repo/scripts/test-ios" TalariaTests/Owner > "$state/owner.log" 2>&1 &
owner=$!
wait_until_active "$owner"
"$repo/scripts/test-ios" TalariaTests/CancelledWaiter > "$state/cancelled-waiter.log" 2>&1 &
waiter=$!
for _ in {1..200}; do
    grep -Eq "Waiting for this worktree's XCTest run: owner PID [0-9]+, elapsed [0-9]+s" "$state/cancelled-waiter.log" && break
    kill -0 "$waiter" 2>/dev/null || break
    sleep 0.01
done
grep -Eq "Waiting for this worktree's XCTest run: owner PID [0-9]+, elapsed [0-9]+s" "$state/cancelled-waiter.log"
kill -TERM "$waiter"
if wait "$waiter"; then
    print -u2 "Expected the waiting runner to exit after cancellation."
    exit 1
else
    [[ $? == 130 ]]
fi
[[ -e "$lock_file" ]]
wait "$owner"

"$repo/scripts/test-ios" TalariaTests/KilledOwner > "$state/killed-owner.log" 2>&1 &
killed_owner=$!
wait_until_active "$killed_owner"
kill -KILL "$killed_owner"
wait "$killed_owner" 2>/dev/null || true
"$repo/scripts/test-ios" TalariaTests/AfterKilledOwner > "$state/after-kill.log" 2>&1
unset TALARIA_FAKE_XCODEBUILD_SECONDS

read -r maximum < "$state/maximum"
read -r active < "$state/active"
[[ "$maximum" == 1 && "$active" == 0 ]]
[[ ! -e "$lock_file.owner" ]]

: > "$state/all-args"
"$repo/scripts/test-ios" TalariaUITests > "$state/whole-target.log" 2>&1
grep -Fqx -- '-skip-testing:TalariaUITests/SidebarPerformanceUITests' "$state/all-args"
# The clone phase leaves the notification journey to its own phase on the leased device.
grep -Fqx -- '-skip-testing:TalariaUITests/ResponseCompletionAlertUITests' "$state/all-args"
grep -Fqx -- '-only-testing:TalariaUITests/ResponseCompletionAlertUITests' "$state/all-args"
"$repo/scripts/test-ios" TalariaUITests/SidebarPerformanceUITests > "$state/explicit-performance.log" 2>&1
! grep -Fqx -- '-skip-testing:TalariaUITests/SidebarPerformanceUITests' "$state/last-args"

# A clone that installs and launches the unit-test host while Xcode installs the UI
# runner there loses the runner (TAL-487), so the targets run in separate phases:
# unit tests on the leased device, then UI tests on its clones.
phases_for() {
    local before
    before=$(wc -l < "$state/runs")
    "$repo/scripts/test-ios" "$@" > "$state/phases.log" 2>&1
    tail -n "+$(( before + 1 ))" "$state/runs" | cut -d'|' -f3-
}
# A clone's notification service does not answer, so the notification journey runs last on the
# leased device (TAL-80).
# Classes that need an iPad or a Pro Max skip on the pool's iPhone, so they run last, each on a matching
# simulator (TAL-471).
regular=TalariaUITests/RegularWidthNavigationUITests
rotating=TalariaUITests/SizeClassRoundTripUITests
expected=$'-only-testing:TalariaTests|NO\n-only-testing:TalariaUITests|YES\n-only-testing:TalariaUITests/ResponseCompletionAlertUITests|NO'
expected+=$'\n'"-only-testing:$regular|NO"$'\n'"-only-testing:$rotating|NO"
[[ "$(phases_for)" == "$expected" ]] || {
    print -u2 "Expected a full run to test TalariaTests without clones, TalariaUITests on clones, the notification journey without clones, then each destination class on its simulator:"
    tail -n 5 "$state/runs" | cut -d'|' -f3- >&2
    exit 1
}
[[ "$(tail -n 2 "$state/runs" | cut -d'|' -f1)" == $'platform=iOS Simulator,id=EEEEEEEE-EEEE-EEEE-EEEE-EEEEEEEEEEEE\nplatform=iOS Simulator,id=FFFFFFFF-FFFF-FFFF-FFFF-FFFFFFFFFFFF' ]]
grep -q "Not preparing personal simulator EEEEEEEE" "$state/phases.log"
: > "$state/all-args"
"$repo/scripts/test-ios" TalariaUITests > "$state/destination-skips.log" 2>&1
grep -Fqx -- "-skip-testing:$regular" "$state/all-args"
grep -Fqx -- "-skip-testing:$rotating" "$state/all-args"
expected="-only-testing:$regular/testOne|NO"
[[ "$(phases_for "$regular/testOne")" == "$expected" ]] || {
    print -u2 "Expected a selected destination test to run alone on its simulator."
    exit 1
}
[[ "$(tail -n 1 "$state/runs" | cut -d'|' -f1)" == 'platform=iOS Simulator,id=EEEEEEEE-EEEE-EEEE-EEEE-EEEEEEEEEEEE' ]]
before=$(wc -l < "$state/runs")
if TALARIA_DEVICE_FIXTURE="$state/no-ipad-devices" "$repo/scripts/test-ios" TalariaUITests > "$state/no-ipad.log" 2>&1; then
    print -u2 "Expected a run without a matching simulator to fail."
    exit 1
fi
grep -q "No shut-down iOS simulator's name matches '\^iPad'" "$state/no-ipad.log"
[[ $(wc -l < "$state/runs") == "$before" ]]  # It fails before testing anything.
expected=$'-only-testing:TalariaUITests/ResponseCompletionAlertUITests/testAlert|NO'
[[ "$(phases_for TalariaUITests/ResponseCompletionAlertUITests/testAlert)" == "$expected" ]] || {
    print -u2 "Expected a selected notification journey to run alone without clones."
    exit 1
}
expected=$'-only-testing:TalariaUITests/ResponseCompletionAlertUITests|NO'
[[ "$(TALARIA_TEST_WORKER_COUNT=1 phases_for TalariaUITests/ResponseCompletionAlertUITests)" == "$expected" ]] || {
    print -u2 "Expected a single-worker run to keep its one phase."
    exit 1
}
expected=$'-only-testing:TalariaTests/Unit|NO\n-only-testing:TalariaUITests/First -only-testing:TalariaUITests/Second|YES'
[[ "$(phases_for TalariaUITests/First TalariaTests/Unit TalariaUITests/Second)" == "$expected" ]] || {
    print -u2 "Expected mixed selectors to split into a unit phase, then a UI phase."
    exit 1
}

# Only a disposable pool device is seeded with a photo and has its notification service readied
# (TAL-651); a personal simulator keeps its library and its processes.
: > "$state/seeded"
: > "$state/notifications-readied"
: > "$state/spawned"
"$repo/scripts/test-ios" TalariaUITests/PoolSeed > "$state/pool-seed.log" 2>&1
[[ "$(<"$state/seeded")" == (AAAAAAAA|BBBBBBBB)-* ]]
# ...and has the keyboard's slide-to-type introduction marked as shown (TAL-668).
[[ "$(<"$state/spawned")" == (AAAAAAAA|BBBBBBBB)-*" defaults write com.apple.keyboard.preferences DidShowContinuousPathIntroduction -bool true" ]]
TALARIA_DEVICE_FIXTURE="$state/fallback-devices" IOS_SIMULATOR_ID=DDDDDDDD-DDDD-DDDD-DDDD-DDDDDDDDDDDD \
    "$repo/scripts/test-ios" TalariaUITests/PersonalSeed > "$state/personal-seed.log" 2>&1
grep -q "Not preparing personal simulator DDDDDDDD" "$state/personal-seed.log"
[[ $(wc -l < "$state/seeded" | tr -d ' ') == 1 ]]
[[ "$(<"$state/notifications-readied")" == (AAAAAAAA|BBBBBBBB)-* ]]
[[ $(wc -l < "$state/notifications-readied" | tr -d ' ') == 1 ]]

# A failed seed stops before testing and still returns its lease.
touch "$state/seed-fail"
if "$repo/scripts/test-ios" TalariaUITests/SeedFails > "$state/seed-fails.log" 2>&1; then
    print -u2 "Expected a failed photo seed to fail the run."
    exit 1
fi
rm "$state/seed-fail"
[[ $(runs_for TalariaUITests/SeedFails) == 0 ]]
leases=("$state"/pool/leases/*.lock(N))
(( ${#leases} == 0 )) || {
    print -u2 "A failed photo seed left pool leases behind: ${leases[*]}"
    exit 1
}

# The visual-reference record marker exists only during a recording run, even one that fails,
# and a stale marker never turns an ordinary run into a re-record.
marker="$repo/TalariaTests/VisualReferences/.record"
mkdir -p "${marker:h}"
: > "$marker"
: > "$state/recorded"
"$repo/scripts/test-ios" TalariaTests/Ordinary > "$state/ordinary.log" 2>&1
TALARIA_RECORD_VISUAL_REFERENCES=1 "$repo/scripts/test-ios" TalariaTests/Record > "$state/record.log" 2>&1
TALARIA_RECORD_VISUAL_REFERENCES=1 "$repo/scripts/test-ios" TalariaTests/RecordFailure > "$state/record-failure.log" 2>&1 || true
[[ "$(<"$state/recorded")" == $'-only-testing:TalariaTests/Record\n-only-testing:TalariaTests/RecordFailure' ]]
[[ ! -e "$marker" ]]

print "test-ios worktree admission, selection, runner-hang retry, photo seeding and cleanup checks passed ($rounds concurrent rounds)."
