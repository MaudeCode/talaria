#!/usr/bin/env python3
"""A fuzz input that traps the test process leaves its seed in the seed journal.

Runs the opt-in trapping fixture, expects the test process to die, and checks
that the journal Fuzz Soak uploads names the trapping property and seed.
"""

import os
from pathlib import Path
import re
import subprocess
import tempfile

app = Path(__file__).resolve().parent.parent
tests = app / "TalariaKit/Tests/TalariaKitTests/UntrustedInputFuzzTests.swift"
base_seed = int(re.search(r"baseSeed: UInt64 \{ (0x[0-9A-Fa-f_]+) \}", tests.read_text()).group(1), 16)
trap_iteration = 1_234
trap_seed = (base_seed + trap_iteration) % 2**64
test = "testTrappingInputLeavesItsSeedInTheJournal"

with tempfile.TemporaryDirectory(prefix="talaria-fuzz-journal-") as journal:
    env = {**os.environ, "TALARIA_FUZZ_SEED_JOURNAL_DIR": journal, "TALARIA_FUZZ_TRAP_ITERATION": str(trap_iteration)}
    completed = subprocess.run(
        ["swift", "test", "--package-path", "TalariaKit", "--filter", f"UntrustedInputFuzzTests/{test}"],
        cwd=app, env=env, capture_output=True, text=True,
    )
    output = completed.stdout + completed.stderr
    assert completed.returncode != 0, "The trapping fixture did not fail the test run:\n" + output[-4000:]
    assert "Deliberate fuzz trap." in output, "The test run failed before the trap:\n" + output[-4000:]
    records = [path.read_text() for path in Path(journal).iterdir()]
    expected = f"UntrustedInputFuzzTests {test}] seed {trap_seed}"
    assert any(expected in record for record in records), f"No journal record names {expected!r}: {records!r}"
print(f"Seed journal named trapping seed {trap_seed}.")
