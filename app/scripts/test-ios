#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
[[ "${_TALARIA_ENV_LOADED:-}" == 1 ]] || exec "$repo_root/scripts/load-env" "$repo_root/scripts/test-ios" "$@"
runtime_dir="$repo_root/.codex-tmp/xctest"
# Per worktree: runs here share derived data. Worktrees run concurrently, each on
# its own pool lease.
lock_file="$runtime_dir/runner.lock"
owner_file="$lock_file.owner"
source "$repo_root/scripts/ios-simulator-pool"
IOS_SIMULATOR_ID=${IOS_SIMULATOR_ID:-${TALARIA_SIMULATOR_ID:-}}
xcodebuild_pid=""
# xcodebuild does not forward host environment variables into the simulator test
# process, so the visual-reference record switch travels as a marker file the
# tests can stat. It never outlives the run.
visual_reference_marker="$repo_root/TalariaTests/VisualReferences/.record"
mkdir -p "$runtime_dir/results"
mkdir -p "$lease_dir"
exec 9>"$lock_file"

cleanup() {
    rm -f "$visual_reference_marker"
    if [[ -n "$xcodebuild_pid" ]]; then
        kill -TERM "$xcodebuild_pid" 2>/dev/null || true
        wait "$xcodebuild_pid" 2>/dev/null || true
        xcodebuild_pid=""
    fi
    ios_pool_release
    current_owner_pid=$(sed -n '1p' "$owner_file" 2>/dev/null || true)
    [[ "$current_owner_pid" != $$ ]] || unlink "$owner_file" 2>/dev/null || true
}

trap cleanup EXIT
trap 'exit 130' INT TERM

wait_started=$SECONDS
lock_timeout=0
while true; do
    if /usr/bin/lockf -s -t "$lock_timeout" 9; then
        break
    else
        admission_status=$?
    fi
    [[ "$admission_status" == 75 ]] || exit "$admission_status"
    now=$SECONDS
    owner_pid=$(sed -n '1p' "$owner_file" 2>/dev/null || true)
    [[ -n "$owner_pid" ]] || owner_pid=unknown
    print -u2 "Waiting for this worktree's XCTest run: owner PID $owner_pid, elapsed $(( now - wait_started ))s."
    lock_timeout=5
done
print -r -- $$ > "$owner_file"

ios_pool_acquire
destination="platform=iOS Simulator,id=$simulator_id"

# UI tests pick from Photos; give them a photo they own (TAL-633). Only a disposable pool
# device is seeded: it is erased on release, while a personal simulator would keep every photo.
seed_ui_photo() {
    if [[ "$simulator_disposable" == true ]]; then
        # Explicit exit: zsh skips the EXIT trap, and the lease release, when errexit fires in a function.
        scripts/seed-simulator-photo "$simulator_id" || exit $?
    else
        print -u2 "Not seeding a test photo into personal simulator $simulator_id; Photos picker tests use its library."
    fi
}

# True when the bundle's only failures are the pre-test runner hang (the test
# host never connected to testmanagerd), so no test case failed and one clean
# retry is safe (TAL-105 evidence, TAL-145).
runner_hang_only() {
    [[ -d "$1" ]] || return 1
    xcrun xcresulttool get test-results summary --path "$1" 2>/dev/null |
        /usr/bin/jq -e '
            (.failedTests // 0) > 0 and
            ([.testFailures[]?] | length) == .failedTests and
            all(.testFailures[]?; (.failureText // "") | test("test runner hung before establishing connection"))
        ' >/dev/null 2>&1
}

# Hosted unit tests and UI tests run as separate xcodebuild phases. In one parallel
# run Xcode can start a UI runner session on a clone that is still installing and
# launching the unit-test host; the runner install is then lost and its launch fails
# with "Unknown application display identifier" (TAL-487). Unit tests take seconds,
# so they run first on the leased device without clones.
(( $# )) || set -- TalariaTests TalariaUITests
typeset -a unit_filters ui_filters
for selector in "$@"; do
    if [[ "${selector%%/*}" == TalariaTests ]]; then
        unit_filters+=("-only-testing:$selector")
    else
        ui_filters+=("-only-testing:$selector")
    fi
done
# The measuring performance UI classes add minutes of scrolling and relaunching;
# the scheduled UI Performance workflow records them. Selecting an entire target
# must not enable these extended checks; name their class or method explicitly
# to run it.
typeset -a extended_skips
for extended_class in \
    TalariaUITests/SidebarPerformanceUITests \
    TalariaUITests/LaunchPerformanceUITests \
    TalariaUITests/TranscriptPerformanceUITests \
    TalariaUITests/NavigationPerformanceUITests; do
    explicitly_selected=0
    for selector in "$@"; do
        if [[ "$selector" == "$extended_class" || "$selector" == "$extended_class/"* ]]; then
            explicitly_selected=1
            break
        fi
    done
    (( explicitly_selected )) || extended_skips+=("-skip-testing:$extended_class")
done
# Xcode clones the leased simulator once per UI worker; the clones are removed when
# the run ends and the pool erases the lease. A single worker runs on the leased
# device itself: a clone per run would race the previous run's clone teardown on
# the same device (TAL-304).
TALARIA_TEST_WORKER_COUNT=${TALARIA_TEST_WORKER_COUNT:-4}
parallel_testing=NO
(( TALARIA_TEST_WORKER_COUNT > 1 )) && parallel_testing=YES
# A parallel-testing clone's notification service does not answer, so a class that needs a
# delivered local notification runs on the leased device itself, after the parallel UI phase
# (a clone made after it would inherit its app state), as CI runs every class without clones
# (TAL-80).
typeset -a serial_ui_classes=(TalariaUITests/ResponseCompletionAlertUITests)
typeset -a parallel_ui_filters serial_ui_filters serial_skips
if [[ "$parallel_testing" == YES ]]; then
    for filter in "${ui_filters[@]}"; do
        selector=${filter#-only-testing:}
        for serial_class in "${serial_ui_classes[@]}"; do
            if [[ "$selector" == TalariaUITests ]]; then
                serial_ui_filters+=("-only-testing:$serial_class")
                serial_skips+=("-skip-testing:$serial_class")
            elif [[ "$selector" == "$serial_class" || "$selector" == "$serial_class/"* ]]; then
                serial_ui_filters+=("$filter")
                continue 2
            fi
        done
        parallel_ui_filters+=("$filter")
    done
    ui_filters=("${parallel_ui_filters[@]}")
fi

cd "$repo_root"
# Clear first: a recording run killed before its EXIT trap would otherwise leave
# the marker behind and silently turn the next ordinary run into a re-record.
rm -f "$visual_reference_marker"
if [[ -n "${TALARIA_RECORD_VISUAL_REFERENCES:-}" ]]; then
    mkdir -p "${visual_reference_marker:h}"
    : > "$visual_reference_marker"
fi

# Usage: run_tests phase parallel-testing filter...
run_tests() {
    local phase=$1 parallel_testing=$2 attempt=1 xcodebuild_status
    shift 2
    while true; do
        result_bundle="$runtime_dir/results/$(date +%Y%m%d-%H%M%S)-$$-$phase-$attempt.xcresult"
        print "Simulator: $destination"
        print "Result bundle: $result_bundle"

        xcodebuild test -quiet \
            -project Talaria.xcodeproj \
            -scheme Talaria \
            -destination "$destination" \
            -testLanguage en \
            -testRegion US \
            -derivedDataPath "$runtime_dir/derived-data" \
            -disableAutomaticPackageResolution \
            -parallel-testing-enabled "$parallel_testing" \
            -parallel-testing-worker-count "$TALARIA_TEST_WORKER_COUNT" \
            -enableCodeCoverage NO \
            -collect-test-diagnostics never \
            -resultBundlePath "$result_bundle" \
            APP_IDENTIFIER_SUFFIX=.xctest \
            "$@" &
        xcodebuild_pid=$!
        if wait "$xcodebuild_pid"; then
            xcodebuild_pid=""
            return
        else
            xcodebuild_status=$?
        fi
        xcodebuild_pid=""
        if (( attempt == 1 )) && runner_hang_only "$result_bundle"; then
            print -u2 "The test runner hung before establishing connection and no test case failed; releasing $simulator_id and retrying once."
            ios_pool_release
            ios_pool_acquire || exit "$xcodebuild_status"
            destination="platform=iOS Simulator,id=$simulator_id"
            [[ "$phase" == unit ]] || seed_ui_photo
            attempt=2
            continue
        fi
        exit "$xcodebuild_status"
    done
}

(( ${#unit_filters} == 0 )) || run_tests unit NO "${unit_filters[@]}"
(( ${#ui_filters} + ${#serial_ui_filters} == 0 )) || seed_ui_photo
if (( ${#ui_filters} )); then
    run_tests ui "$parallel_testing" "${ui_filters[@]}" "${extended_skips[@]}" "${serial_skips[@]}"
    scripts/assert-no-skipped-ui-tests "$result_bundle"
fi
if (( ${#serial_ui_filters} )); then
    run_tests ui-serial NO "${serial_ui_filters[@]}"
    scripts/assert-no-skipped-ui-tests "$result_bundle"
fi
