#!/usr/bin/env bash

if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then
    echo 'Usage: scripts/test-ios [test-identifier ...]'
    echo 'Runs the identifiers once through the shared simulator pool; defaults to TalariaTests.'
    echo 'Set IOS_SIMULATOR_ID to lease a specific disposable simulator.'
    echo 'A test runner that does not connect within TALARIA_RUNNER_CONNECT_TIMEOUT seconds (default 30) gets one'
    echo 'relaunch on a rebooted simulator, then stops the run.'
    echo 'Explicit app installation has its own TALARIA_RUNNER_PREPARATION_TIMEOUT budget (default 30).'
    exit 0
fi

set -euo pipefail
shopt -s nullglob globstar

repo_root=$(cd "$(dirname "$(realpath "$0")")/.." && pwd -P)
[[ "${_TALARIA_ENV_LOADED:-}" == 1 ]] || exec "$repo_root/scripts/load-env" "$repo_root/scripts/test-ios" "$@"
runtime_dir="$repo_root/.codex-tmp/xctest"
# Per worktree: runs here share derived data. Worktrees run concurrently, each on
# its own pool lease.
lock_file="$runtime_dir/runner.lock"
owner_file="$lock_file.owner"
source "$repo_root/scripts/ios-simulator-pool"
IOS_SIMULATOR_ID=${IOS_SIMULATOR_ID:-${TALARIA_SIMULATOR_ID:-}}
xcodebuild_pid=""
# xcodebuild does not forward host environment variables into the simulator test
# process, so the visual-reference record switch travels as a marker file the
# tests can stat. It never outlives the run that created it.
visual_reference_marker="$repo_root/TalariaTests/VisualReferences/.record"
owned_run_markers=()
mkdir -p "$runtime_dir/results"
mkdir -p "$lease_dir"
exec 9>"$lock_file"

cleanup() {
    # A run cancelled while waiting for admission must not remove the marker of the run it waits on.
    for marker in "${owned_run_markers[@]}"; do rm -f "$marker"; done
    if [[ -n "$xcodebuild_pid" ]]; then
        kill -TERM "$xcodebuild_pid" 2>/dev/null || true
        wait "$xcodebuild_pid" 2>/dev/null || true
        xcodebuild_pid=""
    fi
    ios_pool_release
    current_owner_pid=$(sed -n '1p' "$owner_file" 2>/dev/null || true)
    [[ "$current_owner_pid" != $$ ]] || unlink "$owner_file" 2>/dev/null || true
}

trap cleanup EXIT
trap 'exit 130' INT TERM

wait_started=$SECONDS
lock_timeout=0
while true; do
    if /usr/bin/lockf -s -t "$lock_timeout" 9; then
        break
    else
        admission_status=$?
    fi
    [[ "$admission_status" == 75 ]] || exit "$admission_status"
    now=$SECONDS
    owner_pid=$(sed -n '1p' "$owner_file" 2>/dev/null || true)
    [[ -n "$owner_pid" ]] || owner_pid=unknown
    echo "Waiting for this worktree's XCTest run: owner PID $owner_pid, elapsed $(( now - wait_started ))s." >&2
    lock_timeout=5
done
echo $$ > "$owner_file"

ios_pool_acquire
destination="platform=iOS Simulator,id=$simulator_id"

(( $# )) || set -- TalariaTests
filters=("${@/#/-only-testing:}")

cd "$repo_root"
# A killed owner can leave a marker behind. Clear each mode only after this
# runner owns admission; a cancelled waiter must leave its owner's mode alone.
prepare_run_marker() {
    local marker_path=$1 marker_value=$2
    rm -f "$marker_path"
    if [[ -n "$marker_value" ]]; then
        mkdir -p "$(dirname "$marker_path")"
        printf '%s' "$marker_value" > "$marker_path"
        owned_run_markers+=("$marker_path")
    fi
}
prepare_run_marker "$visual_reference_marker" "${TALARIA_RECORD_VISUAL_REFERENCES:-}"
prepare_run_marker "$runtime_dir/native-history-drag" "${TALARIA_NATIVE_HISTORY_DRAG:-}"
prepare_run_marker "$runtime_dir/test-screenshots" "${TALARIA_TEST_SCREENSHOTS:-}"

project=(
    -project Talaria.xcodeproj
    -scheme Talaria
    -derivedDataPath "$runtime_dir/derived-data"
    -disableAutomaticPackageResolution
    -enableCodeCoverage NO
    APP_IDENTIFIER_SUFFIX=.xctest
)
xcodebuild build-for-testing -quiet "${project[@]}" -destination "$destination" &
xcodebuild_pid=$!
wait "$xcodebuild_pid" || exit $?
xcodebuild_pid=""

# CI consumes the build receipt too: reopening the project here repeats workspace resolution inside the launch guard.
test_runs=("$runtime_dir"/derived-data/Build/Products/*.xctestrun)
if (( ${#test_runs[@]} != 1 )); then
    echo "Expected one build-produced .xctestrun in $runtime_dir/derived-data/Build/Products; found ${#test_runs[@]}." >&2
    exit 65
fi

# On the iOS 27.1 Duo simulator, a test host launched while SpringBoard still settles the displays can wait forever
# for testmanagerd's availability notice. xcodebuild relaunches it after about 30 s, sometimes into a scene that
# never reaches the foreground, and reports a hang only after minutes. Stop a host that never connects and reboot
# once (TAL-1547). A connected host can warm its bundle before the first suite, so use Xcode's acknowledgement too.
connect_timeout=${TALARIA_RUNNER_CONNECT_TIMEOUT:-30}
preparation_timeout=${TALARIA_RUNNER_PREPARATION_TIMEOUT:-30}
runner_session_matches() {
    local -a session_logs=("$result_bundle"/Staging/1_Test/Diagnostics/**/Session-*.log)
    (( ${#session_logs[@]} )) || return 1
    grep -Eq -- "$1" "${session_logs[@]}"
}
runner_connected() {
    grep -q testSuiteStarted "$result_stream" && return 0
    runner_session_matches 'Test runner is ready with capabilities:|Test runner started executing tests[.]'
}
attempt=1
while true; do
    simulator_name=$(xcrun simctl list devices available --json |
        /usr/bin/jq -r --arg id "$simulator_id" 'first(.devices[][] | select(.udid == $id) | .name) // "simulator"')
    run_name="$(date +%Y%m%d-%H%M%S)-$$-$attempt"
    result_bundle="$runtime_dir/results/$run_name.xcresult"
    result_stream="$runtime_dir/results/$run_name.stream.json"
    : > "$result_stream"
    echo "Simulator: $simulator_name, $destination"
    echo "Result bundle: $result_bundle"
    xcodebuild test-without-building -quiet -xctestrun "${test_runs[0]}" \
        -enableCodeCoverage NO \
        -destination "$destination" \
        -testLanguage en \
        -testRegion US \
        -parallel-testing-enabled NO \
        -collect-test-diagnostics never \
        -resultBundlePath "$result_bundle" \
        -resultStreamPath "$result_stream" \
        "${filters[@]}" &
    xcodebuild_pid=$!
    connect_started=$SECONDS
    preparation_started=0
    runner_phase=connecting
    host_launched=0
    while kill -0 "$xcodebuild_pid" 2>/dev/null && ! runner_connected; do
        if (( ! host_launched )) && runner_session_matches 'Launched app with identifier: .*[(]pid = [0-9]+[)]'; then
            host_launched=1
            runner_phase=connecting
            connect_started=$SECONDS
        elif (( ! host_launched )) && [[ "$runner_phase" != preparing ]] && runner_session_matches 'Installing app at path:'; then
            # Xcode can spend the connection budget installing an app whose host has not launched yet.
            runner_phase=preparing
            preparation_started=$SECONDS
        fi
        if [[ "$runner_phase" == preparing ]]; then
            (( SECONDS - preparation_started < preparation_timeout )) || break
        else
            (( SECONDS - connect_started < connect_timeout )) || break
        fi
        sleep 1
    done
    if ! kill -0 "$xcodebuild_pid" 2>/dev/null || runner_connected; then
        ! runner_connected || echo "The test runner connected after $(( SECONDS - connect_started ))s."
        wait "$xcodebuild_pid" || exit $?
        xcodebuild_pid=""
        exit 0
    fi
    kill -TERM "$xcodebuild_pid" 2>/dev/null || true
    wait "$xcodebuild_pid" 2>/dev/null || true
    xcodebuild_pid=""
    if [[ "$runner_phase" == preparing ]]; then
        timeout_reason="The test runner preparation on $simulator_name ($simulator_id) did not finish within ${preparation_timeout}s"
    else
        timeout_reason="The test runner on $simulator_name ($simulator_id) did not connect within ${connect_timeout}s"
    fi
    if (( attempt == 2 )); then
        echo "$timeout_reason after a reboot; stopping the run." >&2
        exit 70
    fi
    echo "$timeout_reason; rebooting it for one more launch." >&2
    ios_pool_release
    ios_pool_acquire || exit $?
    destination="platform=iOS Simulator,id=$simulator_id"
    attempt=2
done
