<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDisplayName</key>
	<string>$(APP_DISPLAY_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).share</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(TALARIA_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>TalariaRelease</key>
	<dict>
		<key>contracts</key>
		<dict>
			<key>appWeb</key>
			<array><integer>1</integer></array>
			<key>appRelay</key>
			<array><integer>1</integer></array>
			<key>activityScene</key>
			<array><string>activity_scene_v1</string></array>
		</dict>
	</dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).provider-quota-refresh</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>TalariaCloudKitContainerIdentifier</key>
	<string>$(ICLOUD_CONTAINER_IDENTIFIER)</string>
	<key>TalariaAppGroupIdentifier</key>
	<string>$(APP_GROUP_IDENTIFIER)</string>
	<key>TalariaKeychainService</key>
	<string>$(KEYCHAIN_SERVICE)</string>
	<key>TalariaSharedKeychainAccessGroup</key>
	<string>$(AppIdentifierPrefix)$(APP_BUNDLE_IDENTIFIER).provider-quota-refresh</string>
	<key>TalariaSharedKeychainService</key>
	<string>$(APP_BUNDLE_IDENTIFIER).provider-quota-refresh</string>
	<key>TalariaURLScheme</key>
	<string>$(TALARIA_URL_SCHEME)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>100.64.0.0/10</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Talaria needs microphone access to dictate text into the message composer.</string>
	<key>NSCameraUsageDescription</key>
	<string>Talaria needs camera access to capture and attach photos directly in chat.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Talaria needs photo library access to attach images to chat messages.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Talaria needs permission to save exported workspace images to Photos.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Talaria uses speech recognition to turn dictated audio into editable draft text.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
