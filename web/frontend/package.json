{
  "name": "hermes-webui-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hermes WebUI browser application (TanStack Start SPA, React, TypeScript). Built output is committed under ../static/dist and served by the Python server.",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/i18n-gate.mjs && npm run i18n:compile && tsc --noEmit -p tsconfig.json && eslint . && vite build && node scripts/finalize-dist.mjs && node scripts/build-sw.mjs",
    "build:fast": "vite build && node scripts/finalize-dist.mjs && node scripts/build-sw.mjs",
    "check-dist": "node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "i18n:gate": "node scripts/i18n-gate.mjs",
    "audit:deps": "npm audit --omit=dev && npm outdated || true",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "pretest": "npm run i18n:compile && npm run routes:generate",
    "pretypecheck": "npm run i18n:compile && npm run routes:generate",
    "prelint": "npm run i18n:compile && npm run routes:generate",
    "routes:generate": "node scripts/generate-routes.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-start": "1.168.54",
    "@tanstack/react-virtual": "3.14.13",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "streamdown": "2.6.0",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.25.2",
    "@inlang/plugin-message-format": "4.4.4",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.38",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.19.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "workbox-build": "7.4.1",
    "workbox-core": "7.4.1"
  },
  "engines": {
    "node": ">=22"
  }
}
