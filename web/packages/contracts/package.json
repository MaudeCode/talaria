{
  "name": "@maudecode/talaria-web-contracts",
  "version": "0.0.0",
  "type": "module",
  "description": "Talaria Web contract package: oRPC route contract, Zod schemas, SSE event unions, sidecar RPC schema, and the OpenAPI generator.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "openapi": "node scripts/generate-openapi.mjs",
    "fixtures": "node scripts/export-fixtures.mjs",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "postpack": "node -e \"require('node:fs').rmSync('LICENSE', { force: true })\""
  },
  "dependencies": {
    "@orpc/contract": "1.15.2",
    "@orpc/openapi": "1.15.2",
    "@orpc/zod": "1.15.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "eslint": "10.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaudeCode/talaria.git",
    "directory": "web/packages/contracts"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
