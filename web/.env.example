# Talaria Web -- local machine config template
# Copy this to .env and fill in your values.
# talaria-web loads .env automatically if present (then $HERMES_HOME/.env).

# All values are optional -- auto-discovery will fill in anything left blank.

# Path to your hermes-agent checkout (the repo that contains run_agent.py); the
# Python sidecar runs on its venv.
# TALARIA_WEB_AGENT_DIR=/path/to/hermes-agent

# Python interpreter for the sidecar (defaults to the agent venv if found)
# TALARIA_WEB_PYTHON=/path/to/python

# Bind address (default: 127.0.0.1 -- loopback only, safe default)
# TALARIA_WEB_HOST=127.0.0.1

# Port to listen on (default: 8787)
# TALARIA_WEB_PORT=8787

# Where to store sessions, workspaces, and other state (default: ~/.hermes/webui)
# TALARIA_WEB_STATE_DIR=~/.hermes/webui

# Default workspace directory shown on first launch
# TALARIA_WEB_DEFAULT_WORKSPACE=~/workspace

# Optional model override. Leave unset to use the active Hermes provider default.
# TALARIA_WEB_DEFAULT_MODEL=

# Base directory for all Hermes state (affects all paths above if set)
# HERMES_HOME=~/.hermes

# Path to your Hermes config.yaml (for toolsets and model config)
# HERMES_CONFIG_PATH=~/.hermes/config.yaml

# Display name for the assistant in the UI (default: Hermes)
# TALARIA_WEB_BOT_NAME=Hermes

# ── Security & remote access ─────────────────────────────────────────────────

# Password for the login page. REQUIRED if you bind to anything other than
# 127.0.0.1 — without it, anyone who can reach the port can run commands, so
# the server refuses to start there unless TALARIA_WEB_ALLOW_UNAUTHENTICATED=1.
# TALARIA_WEB_PASSWORD=change-me-to-something-strong

# Enable the passkey/WebAuthn login surface (default: off).
# Alternative: set `webui_passkey_enabled: true` in the profile's config.yaml.
# TALARIA_WEB_PASSKEY=1

# Native OIDC login. The issuer, client ID, allow claim, and allow values are
# required together. Client secret is optional for public clients.
# TALARIA_WEB_OIDC_ISSUER=https://id.example.com
# TALARIA_WEB_OIDC_CLIENT_ID=hermes-webui
# TALARIA_WEB_OIDC_CLIENT_SECRET=
# How the client secret reaches the token endpoint: auto (default) sends it in
# the form body unless discovery advertises client_secret_basic without
# client_secret_post; client_secret_basic or client_secret_post pins a method.
# Also webui_oidc.token_auth_method in config.yaml.
# TALARIA_WEB_OIDC_TOKEN_AUTH_METHOD=auto
# TALARIA_WEB_OIDC_REDIRECT_URI=https://hermes.example.com/api/auth/oidc/callback
# TALARIA_WEB_OIDC_SCOPES=openid profile email
# TALARIA_WEB_OIDC_ALLOW_CLAIM=email
# TALARIA_WEB_OIDC_ALLOW_VALUES=user@example.com
# Allow an exact OIDC hostname to resolve to a private address. This is only
# needed for trusted self-hosted issuers on split DNS; IPs and wildcards are
# ignored. Comma- or whitespace-separated.
# TALARIA_WEB_OIDC_TRUSTED_PRIVATE_HOSTS=id.example.internal

# Auth cookie lifetime in seconds (default: 2592000 = 30 days).
# Clamped to [60, 31536000]. Also settable as session_ttl_seconds in settings.json.
# TALARIA_WEB_SESSION_TTL=2592000

# Force the Secure flag on auth cookies: 1/true or 0/false.
# Unset = auto-detect (direct TLS socket, or a trusted X-Forwarded-Proto).
# TALARIA_WEB_SECURE=1

# Override the auth cookie name (default: derived internally).
# TALARIA_WEB_COOKIE_NAME=hermes_webui_session

# Extra allowed origins for CSRF/origin checks when serving behind a reverse
# proxy or on a public hostname. Comma-separated; each entry MUST include the
# scheme. Entries without a scheme are ignored with a warning.
# TALARIA_WEB_ALLOWED_ORIGINS=https://myapp.example.com:8000

# Hostnames the server answers to besides localhost, IP addresses, TALARIA_WEB_HOST
# and the ALLOWED_ORIGINS hosts. Any other Host header gets 421, which stops a web
# page from reaching this server through DNS rebinding. Comma-separated; ports are
# ignored. Set it to your public name behind a reverse proxy or Tailscale Serve.
# TALARIA_WEB_ALLOWED_HOSTS=myapp.example.com,mybox.tailnet.ts.net

# Serve HTTPS directly (both must be set; otherwise plain HTTP).
# TALARIA_WEB_TLS_CERT=/path/to/fullchain.pem
# TALARIA_WEB_TLS_KEY=/path/to/privkey.pem

# Extra sources appended to the Content-Security-Policy (space-separated).
# TALARIA_WEB_CSP_CONNECT_EXTRA=https://api.example.com wss://api.example.com
# TALARIA_WEB_CSP_FRAME_EXTRA=https://embed.example.com

# ── Reverse-proxy header trust (opt-in; only enable behind a proxy YOU run) ───
# By default these forwarded headers are NOT trusted, because any direct client
# could forge them. Enable (1/true/yes/on) only when a reverse proxy you control
# sets them. TRUST_FORWARDED_HOST: honor X-Forwarded-Host/X-Real-Host in origin
# checks; from a proxy listed in TRUSTED_PROXY_CIDRS that name must also be allowed. TRUST_FORWARDED_FOR: honor X-Forwarded-For for the client IP.
# TRUST_FORWARDED_PROTO: honor X-Forwarded-Proto for HTTPS detection.
#
# Login, passkey, native OIDC start and TTS limits keep a budget per forwarded
# client only when TRUST_FORWARDED_FOR is on AND the proxy's socket address is
# listed in TALARIA_WEB_TRUSTED_PROXY_CIDRS; loopback is not trusted implicitly
# here. A same-host proxy lists 127.0.0.1/32 (and ::1/128 for IPv6). Listing a
# loopback address trusts every local client the same way, SSH tunnels and other
# local processes included. The proxy must append the client to
# X-Forwarded-For (or overwrite it), and must overwrite X-Real-IP if it sends it:
# a request with no X-Forwarded-For, an empty field, or an X-Real-IP naming a
# different address counts against the proxy's own budget.
# TALARIA_WEB_TRUST_FORWARDED_HOST=1
# TALARIA_WEB_TRUST_FORWARDED_FOR=1
# TALARIA_WEB_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# TALARIA_WEB_TRUST_FORWARDED_PROTO=1

# ── Native OIDC login (opt-in; OFF by default) ───────────────────────────────
# Configure issuer/client/allowlist in the active profile's config.yaml or with
# these environment variables. Optional profile binding maps an exact claim value
# to an existing Hermes profile. When the map is configured, unmapped identities
# are denied. TALARIA_WEB_OIDC_PROFILE_MAP must be a JSON object.
# TALARIA_WEB_OIDC_ISSUER=https://idp.example.com
# TALARIA_WEB_OIDC_CLIENT_ID=hermes-webui
# TALARIA_WEB_OIDC_CLIENT_SECRET=
# TALARIA_WEB_OIDC_ALLOW_CLAIM=groups
# TALARIA_WEB_OIDC_ALLOW_VALUES=hermes-users
# TALARIA_WEB_OIDC_PROFILE_CLAIM=sub
# TALARIA_WEB_OIDC_PROFILE_MAP={"synthetic-user-1":"alice","synthetic-user-2":"bob"}

# ── Trusted-header auth / reverse-proxy SSO (opt-in; OFF by default) ──────────
# Delegate authentication to a reverse proxy you run (Authelia, oauth2-proxy,
# corporate SSO, …) that authenticates the user and forwards their identity in a
# header. When TALARIA_WEB_TRUSTED_AUTH_HEADER is set, the WebUI treats a request
# as that identity — but ONLY when the request's un-spoofable raw socket peer is
# an allowlisted proxy (TALARIA_WEB_TRUSTED_PROXY_CIDRS below). With no header
# set, this path is disabled and normal password/passkey auth applies.
#
# ⚠️ SECURITY: TALARIA_WEB_TRUSTED_PROXY_CIDRS MUST list the EXACT IP(s) of your
# proxy — e.g. 10.0.0.5/32 or 127.0.0.1/32. NEVER use 0.0.0.0/0 or a broad range:
# any client whose peer IP falls in the range could forge the identity header and
# log in as anyone. If the allowlist is empty/malformed, the header is ignored
# (fails closed). Loopback is NOT trusted implicitly: a proxy on this host lists
# 127.0.0.1/32,::1/128. The proxy must overwrite, never append, both headers.
# TALARIA_WEB_TRUSTED_AUTH_HEADER=Remote-User
# TALARIA_WEB_TRUSTED_PROXY_CIDRS=10.0.0.5/32
# Optional: map a forwarded groups header to WebUI profiles (JSON object), and a
# logout URL to redirect to after clearing the local session (SSO single-logout).
# TALARIA_WEB_TRUSTED_GROUPS_HEADER=Remote-Groups
# TALARIA_WEB_GROUP_PROFILE_MAP={"admins":"default","team-a":"projecta"}
# TALARIA_WEB_TRUSTED_AUTH_LOGOUT_URL=https://sso.example.com/logout

# ── Uploads & limits ─────────────────────────────────────────────────────────

# Where chat attachments are stored (default: <state dir>/attachments).
# Attachments are transient agent context, kept out of the workspace by default.
# TALARIA_WEB_ATTACHMENT_DIR=~/.hermes/webui/attachments

# Caps for the "download folder as ZIP" feature in the workspace browser.
# TALARIA_WEB_FOLDER_ZIP_MAX_MB=1024
# TALARIA_WEB_FOLDER_ZIP_MAX_FILES=50000

# ── Onboarding ───────────────────────────────────────────────────────────────

# Skip the first-run onboarding wizard entirely.
# TALARIA_WEB_SKIP_ONBOARDING=1

# ── Advanced integrations ────────────────────────────────────────────────────

# Extra sources for the notes drawer (see docs for the expected format).
# TALARIA_WEB_EXTERNAL_NOTES_SOURCES=

# Optional deployed WebUI used by `talaria-web ctl start --remote` for frontend development.
# TALARIA_WEB_DEV_PROXY=http://127.0.0.1:8787

# ── talaria-web ctl (daemon control) ─────────────────────────────────────────

# First port `ctl start` tries when none is given (default: 8787).
# TALARIA_WEB_CTL_PORT_START=8787
# Seconds `ctl start` waits for /health before giving up (default: 25).
# TALARIA_WEB_START_GRACE=25
# Working directory for the detached server (default: the Agent checkout, else the Web root).
# TALARIA_WEB_SERVER_CWD=
# Override the ctl state file next to the PID file.
# TALARIA_WEB_CTL_STATE_FILE=
# Start even when systemd/launchd or another process already owns the port (default: refuse).
# TALARIA_WEB_CTL_ALLOW_SYSTEMD_CONFLICT=0
# TALARIA_WEB_CTL_ALLOW_LAUNCHD_CONFLICT=0
# TALARIA_WEB_CTL_ALLOW_PORT_CONFLICT=0
# Worktree checkouts get their own ctl files unless disabled (default: 1).
# TALARIA_WEB_CTL_ISOLATE_WORKTREE=1
# Web root override for the npm/checkout layout detection.
# TALARIA_WEB_ROOT=

# Hermes Gateway connection settings.
# TALARIA_WEB_GATEWAY_BASE_URL=http://127.0.0.1:8642
# TALARIA_WEB_GATEWAY_API_KEY=

# Override the Codex CLI home scanned by the CLI session bridge and model
# catalog merge (default: ~/.codex).
# CODEX_HOME=~/.codex

# Path to the LLM wiki root shown in the wiki panel (default: resolved from
# HERMES_HOME's wiki env file).
# WIKI_PATH=/path/to/wiki
