# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Backup and temporary files
*.bak
*.swp
*.swo

# Local environment and secrets (but keep the example templates)
.env
.env.*
!.env.example
!.env.docker.example
.claude/
CLAUDE.md
AGENTS.local.md
.cursorrules
.windsurfrules
.aider*
copilot-instructions.md

# Generated screenshots and transient artifacts
screenshot-*.png
full-UI.png
# Playwright MCP scratch — directory + ad-hoc PNGs the agent drops while
# debugging browser sessions. /final-check.png is the convention used by the
# local agent loop for a one-off end-of-task verification grab; ignore
# either way so they never sneak into a commit.
.playwright-mcp/
final-check.png

# OS files
.DS_Store
Thumbs.db

# Local reference clones/artifacts — never committed by default.
# Markdown docs at docs/*.md are intentionally trackable for contributor docs.
docs/*
!docs/*.md
!docs/ui-ux/
!docs/ui-ux/**
!docs/rfcs/
!docs/rfcs/**
!docs/architecture/
!docs/architecture/**
!docs/examples/
!docs/examples/**

# Local-only AI assistant context — never committed even under docs/.
docs/AGENTS.md
docs/CLAUDE.md
docs/.cursorrules
docs/.windsurfrules
.specify/
AGENT_TRACE.yaml
EXECUTION_LOG.md

.venv/

# Node tooling. The workspace lockfile web/package-lock.json is authoritative and committed (TAL-245).
node_modules/
packages/frontend/dist/
packages/frontend/src/paraglide/
packages/frontend/src/routeTree.gen.ts
packages/frontend/playwright-report/
packages/frontend/test-results/
packages/frontend/.tanstack/
docs/ui-ux/review-shots/

# Local runtime data
attachments/

# Build outputs
packages/contracts/dist/
packages/server/dist/
static/dist/

# Immutable release provenance is stamped into artifacts, never source commits.
_release.json
packages/server/static/
packages/server/sidecar/
packages/server/contract_versions.json
packages/server/_release.json

# Pack-time copies of web/LICENSE (TAL-389).
packages/*/LICENSE
