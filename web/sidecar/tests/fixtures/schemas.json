{
  "rpc.cancel": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "cancelled": {
        "type": "boolean"
      },
      "reason": {
        "type": "string"
      }
    },
    "required": [
      "cancelled"
    ],
    "additionalProperties": false
  },
  "rpc.methods": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "methods": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "methods"
    ],
    "additionalProperties": false
  },
  "runtime.handshake": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "rpc_version": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "python": {
        "type": "string"
      },
      "python_version": {
        "type": "string"
      },
      "agent_dir": {
        "type": [
          "string",
          "null"
        ]
      },
      "agent_revision": {
        "type": [
          "string",
          "null"
        ]
      },
      "agent_version": {
        "type": [
          "string",
          "null"
        ]
      },
      "pinned_revision": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      },
      "pinned_version": {
        "type": "string"
      },
      "pinned_image": {
        "type": "string"
      },
      "compatible": {
        "type": "boolean"
      },
      "stale": {
        "type": "boolean"
      },
      "update_state": {
        "type": "string",
        "enum": [
          "absent",
          "active",
          "stale",
          "unknown",
          "incomplete",
          "unverified"
        ]
      },
      "import_error": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "rpc_version",
      "python",
      "python_version",
      "agent_dir",
      "agent_revision",
      "agent_version",
      "pinned_revision",
      "pinned_version",
      "pinned_image",
      "compatible",
      "stale",
      "update_state",
      "import_error"
    ],
    "additionalProperties": false
  },
  "runtime.status": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "rpc_version": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "python": {
        "type": "string"
      },
      "python_version": {
        "type": "string"
      },
      "agent_dir": {
        "type": [
          "string",
          "null"
        ]
      },
      "agent_revision": {
        "type": [
          "string",
          "null"
        ]
      },
      "agent_version": {
        "type": [
          "string",
          "null"
        ]
      },
      "pinned_revision": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      },
      "pinned_version": {
        "type": "string"
      },
      "pinned_image": {
        "type": "string"
      },
      "compatible": {
        "type": "boolean"
      },
      "stale": {
        "type": "boolean"
      },
      "update_state": {
        "type": "string",
        "enum": [
          "absent",
          "active",
          "stale",
          "unknown",
          "incomplete",
          "unverified"
        ]
      },
      "import_error": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "rpc_version",
      "python",
      "python_version",
      "agent_dir",
      "agent_revision",
      "agent_version",
      "pinned_revision",
      "pinned_version",
      "pinned_image",
      "compatible",
      "stale",
      "update_state",
      "import_error"
    ],
    "additionalProperties": false
  },
  "runtime.ensure_current": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "current": {
        "type": "boolean",
        "const": true
      },
      "agent_revision": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "current",
      "agent_revision"
    ],
    "additionalProperties": false
  },
  "runtime.shutdown": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
        "const": true
      }
    },
    "required": [
      "ok"
    ],
    "additionalProperties": false
  }
}
