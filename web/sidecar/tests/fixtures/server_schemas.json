{
  "server.session_list": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "caller_session_id": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "caller_session_id"
      ]
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sessions": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "updated_at": {
                "type": "number"
              },
              "is_caller": {
                "type": "boolean"
              },
              "is_streaming": {
                "type": "boolean"
              },
              "pending_steer_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "attention": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "approval",
                          "clarify"
                        ]
                      },
                      "count": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "severity": {
                        "type": "string",
                        "enum": [
                          "critical",
                          "question"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "count",
                      "severity"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "session_id",
              "title",
              "updated_at",
              "is_caller",
              "is_streaming",
              "pending_steer_count",
              "attention"
            ],
            "additionalProperties": false
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "sessions",
        "truncated"
      ],
      "additionalProperties": false
    }
  }
}
